<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10's own APIs (WinRT): its online dictation for calls (#4980bbee); Windows 10 1809 and newer still run it -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>ProJict</AssemblyName>
    <RootNamespace>ProJict.App</RootNamespace>
    <ApplicationIcon>Assets\ProJict.ico</ApplicationIcon>
    <!-- Says ProJict runs on Windows 10 and 11, which built-in Tailscale needs (#a0d11f05) -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.57</Version>
    <Product>ProJict</Product>
    <Description>Project TODO / DONE lists for Windows</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- Fluent theme APIs are still flagged experimental -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is only used for the tray NotifyIcon; avoid ambiguous type names -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProJict.Core\ProJict.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Kestrel, for the API (Settings › API) -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\native\tailscale\bin\projict-tailscale.dll')">
    <!-- Built-in Tailscale (#a0d11f05), when native\tailscale\build.ps1 built it: next to ProJict.exe -->
    <None Include="..\..\native\tailscale\bin\projict-tailscale.dll" Link="projict-tailscale.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Draws wiki diagrams (mermaid.js) in Windows' Edge WebView2, off screen -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="NAudio.WinMM" Version="3.3.0" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="System.Speech" Version="10.0.14" />
    <!-- Whisper (whisper.cpp) understands you in calls, on this computer: on the graphics card (Vulkan), else the processor -->
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.9.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\ProJict.ico" />
    <Resource Include="Assets\Office\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- The page and mermaid.js (MIT) that draw wiki diagrams; loaded from the app folder -->
    <Content Include="Assets\Diagrams\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Whisper's packages bring its native libraries for every platform; ProJict ships for Windows x64 only (processor and Vulkan). -->
  <Target Name="KeepWindowsWhisperLibraries" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <None Remove="@(None)" Condition="$([System.String]::Copy('%(None.TargetPath)').StartsWith('runtimes/')) And !$([System.String]::Copy('%(None.TargetPath)').StartsWith('runtimes/win-x64/')) And !$([System.String]::Copy('%(None.TargetPath)').StartsWith('runtimes/vulkan/win-x64/'))" />
    </ItemGroup>
  </Target>

</Project>
