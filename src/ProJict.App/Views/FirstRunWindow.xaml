<Window x:Class="ProJict.App.Views.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to ProJict" Width="580" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/Assets/ProJict.ico">
    <StackPanel Margin="24,20">
        <TextBlock Text="Where should ProJict keep your projects?" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Style="{StaticResource MutedText}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,14"
                   Text="ProJict saves one file per project in this folder, plus automatic backups. A folder that is backed up or synced is a good choice. You can change it later in Settings." />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Browse…" Margin="8,0,0,0" Click="Browse_Click" />
            <TextBox x:Name="Folder" TextChanged="Folder_TextChanged" />
        </DockPanel>
        <TextBlock x:Name="Existing" Style="{StaticResource MutedText}" Margin="2,6,0,0" Visibility="Collapsed"
                   Text="This folder already contains ProJict data — it will be opened." />
        <!-- The PIN you approve what can't be taken back with (#8793323e); it can wait for your first ship or Settings. -->
        <TextBlock Text="A PIN for approving what can't be taken back" FontSize="15" FontWeight="SemiBold" Margin="0,20,0,0" />
        <TextBlock Style="{StaticResource MutedText}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,10"
                   Text="When an AI agent asks to do something that can't be undone (publish a release, say), approving it in ProJict asks if you're sure, then this PIN. 4 to 8 digits, kept on this computer only. You can also set it later, in Settings." />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="12" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="PIN" Margin="0,0,0,4" />
                <PasswordBox x:Name="Pin" MaxLength="8" AutomationProperties.Name="PIN" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="The same PIN again" Margin="0,0,0,4" />
                <PasswordBox x:Name="Repeat" MaxLength="8" AutomationProperties.Name="The same PIN again" />
            </StackPanel>
        </Grid>
        <TextBlock x:Name="PinProblem" TextWrapping="Wrap" Margin="2,8,0,0" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Start" Style="{StaticResource AccentButtonStyle}" IsDefault="True" MinWidth="110" Click="Start_Click" />
        </StackPanel>
    </StackPanel>
</Window>
