<UserControl x:Class="ProJict.App.Views.ProjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ProJict.App.ViewModels"
             xmlns:ctl="clr-namespace:ProJict.App.Controls"
             xmlns:views="clr-namespace:ProJict.App.Views">
    <UserControl.InputBindings>
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+C" AutomationProperties.Name="Copy prompt" Command="{Binding CopyPromptCommand}" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <!-- A header button chosen with the cog: a real button, bigger, on the left of the others. -->
        <Style x:Key="BigHeaderButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="0,0,8,6" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <!-- An attached file: a thumbnail for images, otherwise a chip with its name. Click opens it, right-click for more. -->
        <DataTemplate x:Key="AttachmentChip" DataType="{x:Type vm:AttachmentViewModel}">
            <Button Style="{StaticResource SubtleButton}" Padding="0" Margin="0,0,6,4" Command="{Binding OpenCommand}"
                    ToolTip="{Binding ToolTip}" AutomationProperties.Name="{Binding FileName}"
                    ContextMenuOpening="Attachment_ContextMenuOpening">
                <Border Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="6,3">
                    <Grid>
                        <Image Source="{Binding Thumbnail}" MaxHeight="80" MaxWidth="240" Stretch="Uniform" Margin="-4,-1"
                               Visibility="{Binding ShowsThumbnail, Converter={StaticResource BoolToVis}}" />
                        <StackPanel Orientation="Horizontal" Visibility="{Binding ShowsThumbnail, Converter={StaticResource InvBoolToVis}}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="13" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding FileName}" FontSize="12" MaxWidth="220" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource MutedText}" FontSize="11" Margin="6,0,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Button>
        </DataTemplate>
        <!-- An item's or note's audio or video, played in place, with the same right-click menu as its chip. -->
        <DataTemplate x:Key="AttachmentPlayer" DataType="{x:Type vm:AttachmentViewModel}">
            <views:InlinePlayer Path="{Binding PlayPath}" Kind="{Binding MediaKind}" FileName="{Binding FileName}" Poster="{Binding Poster}"
                               OpenCommand="{Binding OpenCommand}" Margin="0,0,6,4" ContextMenuOpening="Attachment_ContextMenuOpening" />
        </DataTemplate>
        <views:PlayableTemplateSelector x:Key="AttachmentTemplate" Chip="{StaticResource AttachmentChip}" Player="{StaticResource AttachmentPlayer}" />
        <ItemsPanelTemplate x:Key="WrapItems">
            <WrapPanel />
        </ItemsPanelTemplate>
        <!-- A file linked where it is (a capture, an edit, an export): its preview frame, or a chip; a click opens it. -->
        <DataTemplate x:Key="MediaChip" DataType="{x:Type vm:MediaLinkViewModel}">
            <Button Style="{StaticResource SubtleButton}" Padding="0" Margin="0,2,6,2" Command="{Binding OpenCommand}" ToolTip="{Binding ToolTip}"
                    AutomationProperties.Name="{Binding FileName}">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Open" Command="{Binding OpenCommand}" />
                        <MenuItem Header="Show in folder" Command="{Binding ShowInFolderCommand}" />
                        <MenuItem Header="Copy path" Command="{Binding CopyPathCommand}" />
                        <Separator />
                        <MenuItem Header="Unlink (the file stays)" Command="{Binding UnlinkCommand}" />
                    </ContextMenu>
                </Button.ContextMenu>
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="4">
                    <StackPanel>
                        <Grid Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}" Margin="0,0,0,4">
                            <Image Source="{Binding Preview}" MaxHeight="90" MaxWidth="160" Stretch="Uniform" HorizontalAlignment="Left" />
                            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4" CornerRadius="3" Padding="4,1" Background="#B0000000">
                                <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="11" Foreground="White" />
                            </Border>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="2,0">
                            <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding FileName}" FontSize="12" MaxWidth="200" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource MutedText}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE71B;" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" ToolTip="Linked where it is, not copied" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Exists}" Value="False">
                    <Setter Property="Opacity" Value="0.55" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <!-- Linked audio or video, played in place, with the same right-click menu as its chip. -->
        <DataTemplate x:Key="MediaPlayerTemplate" DataType="{x:Type vm:MediaLinkViewModel}">
            <views:InlinePlayer Path="{Binding PlayPath}" Kind="{Binding MediaKind}" FileName="{Binding FileName}" Poster="{Binding Poster}"
                               OpenCommand="{Binding OpenCommand}" Margin="0,2,6,2" ToolTip="{Binding ToolTip}">
                <views:InlinePlayer.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Open" Command="{Binding OpenCommand}" />
                        <MenuItem Header="Show in folder" Command="{Binding ShowInFolderCommand}" />
                        <MenuItem Header="Copy path" Command="{Binding CopyPathCommand}" />
                        <Separator />
                        <MenuItem Header="Unlink (the file stays)" Command="{Binding UnlinkCommand}" />
                    </ContextMenu>
                </views:InlinePlayer.ContextMenu>
            </views:InlinePlayer>
        </DataTemplate>
        <views:PlayableTemplateSelector x:Key="MediaTemplate" Chip="{StaticResource MediaChip}" Player="{StaticResource MediaPlayerTemplate}" />

        <!-- One line of the outline: grip, three-state checkbox, tag chip, editable text, agent/review/release chips and done date;
             below it the latest history entry and the attachments. -->
        <DataTemplate x:Key="RowTemplate" DataType="{x:Type vm:ItemRowViewModel}">
            <Border x:Name="RowRoot" CornerRadius="4" Padding="0,1" Background="Transparent" BorderThickness="2,0,0,0" BorderBrush="Transparent"
                    AllowDrop="True" DragOver="Row_DragOver" PreviewDragLeave="Row_DragLeave" Drop="Row_Drop"
                    PreviewDragEnter="Row_PreviewFileDragOver" PreviewDragOver="Row_PreviewFileDragOver" PreviewDrop="Row_PreviewFileDrop"
                    ContextMenuOpening="Row_ContextMenuOpening"
                    Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                <Grid Margin="{Binding IndentMargin}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Waits for you (work to review, new comments); the grip takes its place while you point at the row, and says what waits. -->
                    <Ellipse x:Name="AttentionDot" Style="{StaticResource UnreadDot}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,11,0,0"
                             Visibility="{Binding NeedsAttention, Converter={StaticResource BoolToVis}}" />
                    <TextBlock x:Name="Grip" Text="&#xE76F;" FontFamily="{StaticResource IconFont}" FontSize="12" Opacity="0" Background="Transparent"
                               Cursor="SizeAll" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,8,0,0"
                               ToolTip="{Binding GripToolTip}"
                               PreviewMouseLeftButtonDown="Grip_MouseDown" MouseMove="Grip_MouseMove" />
                    <CheckBox Grid.Column="1" IsChecked="{Binding CheckState}" IsThreeState="False" Focusable="False" IsEnabled="{Binding Owner.CanEdit}"
                              MinWidth="0" MinHeight="0" Padding="0" Margin="2,4,4,0" VerticalAlignment="Top"
                              ToolTip="Done (Ctrl+Enter) · in progress (Ctrl+I) · right-click to choose"
                              ContextMenuOpening="StateBox_ContextMenuOpening" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                        <!-- Priority: an outlined chip (tags are filled), a click picks another. -->
                        <Button Style="{StaticResource SubtleButton}" Padding="0" Margin="0,5,4,0" VerticalAlignment="Top" Click="PriorityChip_Click"
                                ToolTip="{Binding PriorityToolTip}" AutomationProperties.Name="Priority"
                                Visibility="{Binding HasPriority, Converter={StaticResource BoolToVis}}">
                            <Border CornerRadius="4" BorderThickness="1" Padding="5,0,6,1" BorderBrush="{Binding Priority, Converter={StaticResource PriorityToBrush}}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{Binding Priority, Converter={StaticResource PriorityToBrush}}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding PriorityText}" FontSize="10.5" FontWeight="SemiBold" Margin="4,0,0,0" />
                                </StackPanel>
                            </Border>
                        </Button>
                        <!-- No priority yet: the same chip, empty and dashed (brighter while you point at the row); a click gives it one. -->
                        <Button x:Name="NoPriority" Style="{StaticResource SubtleButton}" Padding="0" Margin="0,5,4,0" VerticalAlignment="Top" Click="PriorityChip_Click"
                                Opacity="0.45" ToolTip="No priority yet: click to give it one (or Alt+1 urgent … Alt+4 low, Alt+5 on hold)"
                                AutomationProperties.Name="Give it a priority"
                                Visibility="{Binding ShowPriorityButton, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Rectangle RadiusX="4" RadiusY="4" StrokeThickness="1" StrokeDashArray="2 2" Stroke="{DynamicResource TextFillColorSecondaryBrush}" />
                                <StackPanel Orientation="Horizontal" Margin="6,1,7,2">
                                    <Ellipse Width="7" Height="7" StrokeThickness="1" Stroke="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="priority" FontSize="10.5" Margin="4,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </Button>
                        <!-- Its type (BUG, ADD…): a click picks another from the list, or a new one. -->
                        <Button Style="{StaticResource SubtleButton}" Padding="0" Margin="0,6,4,0" VerticalAlignment="Top" Click="TagChip_Click"
                                ToolTip="{Binding TagToolTip}" AutomationProperties.Name="Type"
                                Visibility="{Binding HasTag, Converter={StaticResource BoolToVis}}">
                            <Border Style="{StaticResource TagChip}" Background="{Binding Tag, Converter={StaticResource TagToBrush}}">
                                <TextBlock Text="{Binding Tag}" Style="{StaticResource ChipText}" />
                            </Border>
                        </Button>
                        <!-- No type yet: an empty dashed chip while you point at the row; a click gives it one. -->
                        <Button x:Name="NoTag" Style="{StaticResource SubtleButton}" Padding="0" Margin="0,5,4,0" VerticalAlignment="Top" Click="TagChip_Click"
                                Opacity="0" ToolTip="No type yet: click to give it one (BUG, ADD, CHANGE… or your own)"
                                AutomationProperties.Name="Give it a type"
                                Visibility="{Binding ShowTagButton, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Rectangle RadiusX="4" RadiusY="4" StrokeThickness="1" StrokeDashArray="2 2" Stroke="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="type" FontSize="10.5" Margin="7,1,7,2" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </Button>
                    </StackPanel>
                    <TextBox x:Name="RowText" Grid.Column="3" Uid="RowText" Style="{StaticResource RowTextBox}" IsReadOnly="{Binding Owner.IsReadOnlyBoard}"
                             Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Loaded="RowText_Loaded"
                             PreviewKeyDown="RowText_PreviewKeyDown" GotKeyboardFocus="RowText_GotFocus" LostKeyboardFocus="RowText_LostFocus"
                             ContextMenuOpening="RowText_ContextMenuOpening" />
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Top" Margin="6,5,4,0">
                        <!-- The GitHub issue it came from and pull requests that mention it; a click opens them on GitHub. -->
                        <ItemsControl ItemsSource="{Binding GitHubLinks}" Focusable="False" VerticalAlignment="Top"
                                      Visibility="{Binding HasGitHubLinks, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:GitHubLinkViewModel}">
                                    <Button Style="{StaticResource SubtleButton}" Padding="0" Margin="0,0,4,0" Command="{Binding Open}"
                                            ToolTip="{Binding ToolTip}" AutomationProperties.Name="{Binding Text}">
                                        <Border Style="{StaticResource TagChip}" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Margin="0">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="7" Height="7" Fill="{Binding Dot}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                <TextBlock Text="{Binding Text}" FontSize="11" />
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Style="{StaticResource TagChip}" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                Visibility="{Binding ClaimedBy, Converter={StaticResource EmptyToVis}}" ToolTip="{Binding ClaimToolTip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="10" Margin="0,0,4,0" />
                                <TextBlock Text="{Binding ClaimedBy}" FontSize="11" />
                            </StackPanel>
                        </Border>
                        <Button Style="{StaticResource SubtleButton}" Padding="0" Command="{Binding AcceptReviewCommand}" ToolTip="{Binding ReviewToolTip}"
                                AutomationProperties.Name="Accept review" Visibility="{Binding NeedsReview, Converter={StaticResource BoolToVis}}">
                            <Border Style="{StaticResource TagChip}" Background="{DynamicResource SystemFillColorCautionBrush}" Margin="0">
                                <TextBlock Text="review" Style="{StaticResource ChipText}" />
                            </Border>
                        </Button>
                        <Border Style="{StaticResource TagChip}" Background="{DynamicResource AccentFillColorDefaultBrush}"
                                Visibility="{Binding ReleaseText, Converter={StaticResource EmptyToVis}}" ToolTip="Included in this release">
                            <TextBlock Text="{Binding ReleaseText}" Style="{StaticResource ChipText}" />
                        </Border>
                        <TextBlock Text="{Binding DoneAtText}" Style="{StaticResource MutedText}" FontSize="11" />
                        <!-- Show on hover: the item's discussion, and its menu (priority, tag, …) for those who don't right-click. -->
                        <Button x:Name="RowChat" Style="{StaticResource SubtleIconButton}" Content="&#xE8BD;" FontSize="12" Padding="5,1" Margin="4,-3,0,0"
                                Opacity="0" Command="{Binding OpenDiscussionCommand}" ToolTip="Discussion" AutomationProperties.Name="Discussion" />
                        <Button x:Name="RowMore" Style="{StaticResource SubtleIconButton}" Content="&#xE712;" FontSize="12" Padding="5,1" Margin="4,-3,0,0"
                                Opacity="0" Click="RowMore_Click" ToolTip="Priority, tag, discussion and more (or right-click the item)"
                                AutomationProperties.Name="More" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" Margin="4,0,0,0">
                        <!-- Who worked on it (a click filters the board by them), its discussion, and the newest history entry. -->
                        <DockPanel Margin="0,0,8,3" Visibility="{Binding HasDetails, Converter={StaticResource BoolToVis}}">
                            <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding Contributors}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ContributorViewModel}">
                                        <Button Style="{StaticResource SubtleButton}" Padding="0" Margin="0,0,4,0" Command="{Binding Filter}" CommandParameter="{Binding Name}"
                                                ToolTip="{Binding ToolTip}" AutomationProperties.Name="{Binding Name}">
                                            <Border Style="{StaticResource TagChip}" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Margin="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="10" Margin="0,0,4,0" />
                                                    <TextBlock Text="{Binding Name}" FontSize="11" />
                                                </StackPanel>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button DockPanel.Dock="Left" Style="{StaticResource SubtleButton}" Padding="0" Margin="0,0,6,0" Command="{Binding OpenDiscussionCommand}"
                                    ToolTip="Open the discussion" AutomationProperties.Name="Discussion"
                                    Visibility="{Binding CommentCount, Converter={StaticResource EmptyToVis}}">
                                <Border Style="{StaticResource TagChip}" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Margin="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8BD;" FontSize="10" Margin="0,1,4,0" />
                                        <TextBlock Text="{Binding CommentCount}" FontSize="11" />
                                        <Ellipse Style="{StaticResource UnreadDot}" Margin="5,0,0,0" ToolTip="New comments"
                                                 Visibility="{Binding HasUnreadComments, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Border>
                            </Button>
                            <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding Channels}" ItemTemplate="{StaticResource ChannelChipTemplate}" ItemsPanel="{StaticResource HorizontalPanel}"
                                          Focusable="False" Margin="0,0,2,0" Visibility="{Binding HasChannels, Converter={StaticResource BoolToVis}}" />
                            <!-- Time spent on it (in progress, or logged), with what agents used in the tooltip -->
                            <Border DockPanel.Dock="Left" Style="{StaticResource TagChip}" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Margin="0,0,6,0"
                                    ToolTip="{Binding TimeText}" Visibility="{Binding TimeChip, Converter={StaticResource EmptyToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE916;" FontSize="10" Margin="0,1,4,0" />
                                    <TextBlock Text="{Binding TimeChip}" FontSize="11" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding ActivityText}" ToolTip="{Binding ActivityToolTip}" Style="{StaticResource MutedText}" FontSize="11.5"
                                       TextTrimming="CharacterEllipsis" Margin="2,0,0,0" Visibility="{Binding ActivityText, Converter={StaticResource EmptyToVis}}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Attachments}" ItemTemplateSelector="{StaticResource AttachmentTemplate}"
                                      ItemsPanel="{StaticResource WrapItems}" Focusable="False" Margin="0,1,0,3"
                                      Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVis}}" />
                        <ItemsControl x:Name="MediaLinks" ItemsSource="{Binding Media}" ItemTemplateSelector="{StaticResource MediaTemplate}"
                                      ItemsPanel="{StaticResource WrapItems}" Focusable="False" Margin="0,1,0,3"
                                      Visibility="{Binding HasMedia, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="RowRoot" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Grip" Property="Opacity" Value="0.55" />
                    <Setter TargetName="AttentionDot" Property="Opacity" Value="0" />
                    <Setter TargetName="RowMore" Property="Opacity" Value="1" />
                    <Setter TargetName="RowChat" Property="Opacity" Value="1" />
                    <Setter TargetName="NoPriority" Property="Opacity" Value="1" />
                    <Setter TargetName="NoTag" Property="Opacity" Value="1" />
                </Trigger>
                <DataTrigger Binding="{Binding InDoneSection}" Value="True">
                    <Setter TargetName="RowText" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDoneInOpenSection}" Value="True">
                    <Setter TargetName="RowText" Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                    <Setter TargetName="RowText" Property="TextDecorations" Value="Strikethrough" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="RowRoot" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                    <Setter TargetName="RowRoot" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                    <Setter TargetName="RowRoot" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    <Setter TargetName="RowRoot" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="CategoryHeaderTemplate" DataType="{x:Type vm:CategoryViewModel}">
            <Border x:Name="HeaderRoot" Background="Transparent" CornerRadius="4" BorderThickness="0,0,0,2" BorderBrush="Transparent"
                    AllowDrop="True" DragOver="Category_DragOver" DragLeave="Category_DragLeave" Drop="Category_Drop">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE76F;" FontFamily="{StaticResource IconFont}" FontSize="12" Opacity="0.35" Background="Transparent"
                               Cursor="SizeAll" VerticalAlignment="Center" HorizontalAlignment="Center" ToolTip="Drag to reorder categories"
                               PreviewMouseLeftButtonDown="CategoryGrip_MouseDown" MouseMove="CategoryGrip_MouseMove" />
                    <Button x:Name="Chevron" Grid.Column="1" Style="{StaticResource SubtleIconButton}" FontSize="11" Padding="5,4"
                            Command="{Binding ToggleExpandedCommand}" AutomationProperties.Name="Collapse" Content="&#xE70D;" ToolTip="Collapse / expand" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <TextBox Uid="CategoryName" Style="{StaticResource RowTextBox}" FontSize="15" FontWeight="SemiBold" TextWrapping="NoWrap" IsReadOnly="{Binding Owner.IsReadOnlyBoard}"
                                 MinWidth="30" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" GotKeyboardFocus="Header_GotFocus" />
                        <TextBlock Text="{Binding OpenCountText}" FontSize="15" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"
                                   Margin="2,0,4,0" ToolTip="Open items" />
                        <!-- Something inside waits for you: a click shows just that. -->
                        <Button x:Name="AttentionButton" Style="{StaticResource SubtleButton}" Padding="3" Margin="0,0,4,0" VerticalAlignment="Center"
                                Command="{Binding ShowWaitingCommand}" ToolTip="{Binding AttentionToolTip}" AutomationProperties.Name="Show what waits for you"
                                Visibility="{Binding ShowAttention, Converter={StaticResource BoolToVis}}">
                            <Ellipse Style="{StaticResource UnreadDot}" />
                        </Button>
                    </StackPanel>
                    <TextBox Grid.Column="3" Style="{StaticResource HoverHintTextBox}" FontSize="12" Tag="description…" IsReadOnly="{Binding Owner.IsReadOnlyBoard}"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                             Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" GotKeyboardFocus="Header_GotFocus" />
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="8,0">
                        <TextBlock Text="{Binding CountsText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="5" Orientation="Horizontal">
                        <ItemsControl ItemsSource="{Binding Channels}" ItemTemplate="{StaticResource ChannelChipTemplate}" ItemsPanel="{StaticResource HorizontalPanel}"
                                      Focusable="False" VerticalAlignment="Center" Visibility="{Binding HasChannels, Converter={StaticResource BoolToVis}}" />
                        <Button Style="{StaticResource SubtleButton}" Command="{Binding OpenDiscussionCommand}" ToolTip="{Binding DiscussionToolTip}" AutomationProperties.Name="Discussion">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8BD;" />
                                <TextBlock Text="{Binding CommentCount}" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center"
                                           Visibility="{Binding CommentCount, Converter={StaticResource EmptyToVis}}" />
                                <Ellipse Style="{StaticResource UnreadDot}" Margin="5,0,0,0"
                                         Visibility="{Binding HasUnreadComments, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SubtleIconButton}" Content="&#xE710;" AutomationProperties.Name="Add item" ToolTip="Add item" Click="AddItemButton_Click"
                                Visibility="{Binding Owner.CanAddItems, Converter={StaticResource BoolToVis}}" />
                        <Button Style="{StaticResource SubtleIconButton}" Content="&#xE8C8;" AutomationProperties.Name="Copy category prompt" ToolTip="Copy this category's open items as an AI prompt" Command="{Binding CopyPromptCommand}" />
                        <Button x:Name="FocusButton" Style="{StaticResource SubtleIconButton}" Content="&#xE890;" AutomationProperties.Name="Focus" ToolTip="{Binding FocusToolTip}"
                                Command="{Binding ToggleFocusCommand}" />
                        <Button Style="{StaticResource SubtleIconButton}" Content="&#xE712;" AutomationProperties.Name="More" ToolTip="More" Click="CategoryMore_Click" />
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                    <Setter TargetName="Chevron" Property="Content" Value="&#xE76C;" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                    <Setter TargetName="HeaderRoot" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    <Setter TargetName="HeaderRoot" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="AddItemTemplate" DataType="{x:Type vm:CategoryViewModel}">
            <!-- Pasting (Ctrl+V) or dropping a screenshot or files here adds the item with them attached. -->
            <TextBox Uid="AddItem" Style="{StaticResource RowTextBox}" Margin="40,2,0,0" Visibility="{Binding Owner.CanAddItems, Converter={StaticResource BoolToVis}}"
                     Tag="Add item…  (Enter · prefix BUG: / ADD: to tag · paste or drop a screenshot to attach it)"
                     Text="{Binding NewItemText, UpdateSourceTrigger=PropertyChanged}" GotKeyboardFocus="Header_GotFocus"
                     PreviewKeyDown="AddItem_PreviewKeyDown" AllowDrop="True"
                     PreviewDragEnter="AddItem_PreviewDragOver" PreviewDragOver="AddItem_PreviewDragOver" PreviewDrop="AddItem_PreviewDrop">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding AddNewItemCommand}" />
                </TextBox.InputBindings>
            </TextBox>
        </DataTemplate>

        <DataTemplate x:Key="StackedCategoryTemplate" DataType="{x:Type vm:CategoryViewModel}">
            <Border Style="{StaticResource Card}" Margin="0,0,0,10" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CategoryHeaderTemplate}" Focusable="False" />
                    <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                        <ctl:OutlineItemsControl ItemsSource="{Binding OpenRows}" ItemTemplate="{StaticResource RowTemplate}" Focusable="False" />
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AddItemTemplate}" Focusable="False" />
                        <!-- Done: a panel of its own (a line above, a shade behind), so it doesn't blend into the open items. -->
                        <Border x:Name="DoneSection" Margin="-6,8,-6,-4" Padding="0,2,0,4" CornerRadius="0,0,6,6" BorderThickness="0,1,0,0"
                                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                Visibility="{Binding HasDone, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="6,0">
                        <ToggleButton Style="{StaticResource SubtleToggle}" AutomationProperties.Name="{Binding DoneHeader}" IsChecked="{Binding IsDoneExpanded}" HorizontalAlignment="Left" Margin="18,4,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="12" />
                                <TextBlock Text="{Binding DoneHeader}" Margin="6,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Ellipse Style="{StaticResource UnreadDot}" Margin="6,0,0,0" ToolTip="{Binding DoneAttentionToolTip}"
                                         Visibility="{Binding ShowDoneAttention, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </ToggleButton>
                        <ctl:OutlineItemsControl ItemsSource="{Binding DoneRows}" ItemTemplate="{StaticResource RowTemplate}" Focusable="False" Margin="0,2,0,0"
                                      Visibility="{Binding ShowDoneRows, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SideBySideCategoryTemplate" DataType="{x:Type vm:CategoryViewModel}">
            <Border Style="{StaticResource Card}" Margin="0,0,0,10" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CategoryHeaderTemplate}" Focusable="False" />
                    <Grid Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="TODO" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="22,0,0,4" />
                            <ctl:OutlineItemsControl ItemsSource="{Binding OpenRows}" ItemTemplate="{StaticResource RowTemplate}" Focusable="False" />
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AddItemTemplate}" Focusable="False" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="10,0" />
                        <!-- Done, shaded so it reads apart from TODO -->
                        <Border Grid.Column="2" CornerRadius="6" Padding="0,4,4,4" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                            <StackPanel>
                                <TextBlock Text="{Binding DoneHeader}" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="22,0,0,4" />
                                <ctl:OutlineItemsControl ItemsSource="{Binding DoneRows}" ItemTemplate="{StaticResource RowTemplate}" Focusable="False" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="24,14,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Image x:Name="HeaderIcon" Source="{Binding Icon}" Width="32" Height="32" Margin="2,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"
                           Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}" />
                    <TextBox Style="{StaticResource RowTextBox}" FontSize="26" FontWeight="SemiBold" Padding="2,0" TextWrapping="NoWrap"
                             Text="{Binding Name, UpdateSourceTrigger=LostFocus}" IsReadOnly="{Binding IsTitleReadOnly}" HorizontalAlignment="Left" MinWidth="200" />
                </StackPanel>
                <!-- Another ProJict's project: whose it is and what you may do in it. -->
                <StackPanel Orientation="Horizontal" Margin="4,2,0,0" Visibility="{Binding RemoteText, Converter={StaticResource EmptyToVis}}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72D;" FontSize="12" Margin="0,0,6,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="{Binding RemoteText}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="2,6,0,0" Visibility="{Binding IsNotInbox, Converter={StaticResource BoolToVis}}">
                    <Ellipse Width="8" Height="8" Fill="{Binding Status, Converter={StaticResource StatusToBrush}}" Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{x:Static vm:ProjectViewModel.Statuses}" SelectedItem="{Binding Status}" Width="130" ToolTip="Status" IsEnabled="{Binding IsOwnProject}" />
                    <ComboBox ItemsSource="{Binding Groups}" Text="{Binding Group, UpdateSourceTrigger=LostFocus}" IsEditable="True" Width="150" Margin="8,0,0,0" ToolTip="Group" IsEnabled="{Binding IsOwnProject}" />
                    <ItemsControl x:Name="ProjectChannels" ItemsSource="{Binding Channels}" ItemTemplate="{StaticResource ChannelChipTemplate}" ItemsPanel="{StaticResource HorizontalPanel}"
                                  Focusable="False" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="{Binding HasChannels, Converter={StaticResource BoolToVis}}" />
                    <!-- The wiki pages about the project; a click opens one. -->
                    <ItemsControl x:Name="ProjectWikiPages" ItemsSource="{Binding WikiPages}" ItemsPanel="{StaticResource HorizontalPanel}" Focusable="False" Margin="10,0,0,0"
                                  VerticalAlignment="Center" Visibility="{Binding HasWikiPages, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:WikiPageChip}">
                                <Button Style="{StaticResource SubtleButton}" Padding="0" Margin="0,0,4,0" Command="{Binding OpenCommand}" ToolTip="{Binding ToolTip}"
                                        AutomationProperties.Name="{Binding Text}">
                                    <Border Style="{StaticResource TagChip}" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Margin="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="10" Margin="0,1,4,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                            <TextBlock Text="{Binding Text}" FontSize="11" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                            <Ellipse Style="{StaticResource UnreadDot}" Margin="5,0,0,0" Visibility="{Binding NeedsAttention, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <!--
                    The current test build, set by you or an agent: run it from here. Its buttons stay on the right; the line
                    about it gives way when there's little room.
                -->
                <Border Margin="2,8,0,0" Padding="10,4,6,4" CornerRadius="6" HorizontalAlignment="Left" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        Visibility="{Binding HasTestBuild, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <!-- A shared project's is on its host's computer: Get it brings it here first. -->
                            <Button x:Name="GetTestBuildButton" Style="{StaticResource AccentButtonStyle}" Command="{Binding GetTestBuildCommand}" IsEnabled="{Binding CanGetTestBuild}"
                                    Margin="10,0,0,0" Padding="10,2" AutomationProperties.Name="Get the test build" ToolTip="{Binding GetTestBuildToolTip}"
                                    Visibility="{Binding ShowGetTestBuild, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="11" VerticalAlignment="Center" /><TextBlock Text="{Binding GetTestBuildText}" Margin="6,0,0,0" /></StackPanel>
                            </Button>
                            <Button Style="{StaticResource AccentButtonStyle}" Command="{Binding RunTestBuildCommand}" IsEnabled="{Binding TestBuildExists}" Margin="10,0,0,0" Padding="10,2"
                                    AutomationProperties.Name="Run the test build" ToolTip="{Binding TestBuildToolTip}"
                                    Visibility="{Binding ShowGetTestBuild, Converter={StaticResource InvBoolToVis}}">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="11" VerticalAlignment="Center" /><TextBlock Text="{Binding RunTestBuildText}" Margin="6,0,0,0" /></StackPanel>
                            </Button>
                            <Button Style="{StaticResource SubtleButton}" Command="{Binding ShowTestBuildCommand}" IsEnabled="{Binding TestBuildExists}" Margin="4,0,0,0"
                                    AutomationProperties.Name="Show the test build in its folder" ToolTip="Show it in its folder">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="12" />
                            </Button>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE7FC;" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock DockPanel.Dock="Left" Text="Test build" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Left" Text="{Binding TestBuildName}" ToolTip="{Binding TestBuildToolTip}" VerticalAlignment="Center" Margin="8,0,0,0" MaxWidth="280"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding TestBuildDetails}" Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"
                                   MaxWidth="380" TextTrimming="CharacterEllipsis" ToolTip="{Binding TestBuildDetails}" />
                    </DockPanel>
                </Border>
                <TextBlock Margin="2,6,0,0" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                           Text="Ideas and loose notes. Promote an item to a project from its right-click menu."
                           Visibility="{Binding IsInbox, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
            <!--
                The buttons: the ones chosen with the cog (Ship and Clean up at first) big on the left, the others after them.
                They're all written here once; the view moves each to where it goes (ArrangeHeaderButtons).
            -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right">
            <WrapPanel x:Name="BigHeaderButtons" VerticalAlignment="Top" Margin="0,0,10,0" />
            <WrapPanel x:Name="HeaderButtons" VerticalAlignment="Top" MaxWidth="560">
                <Button Style="{StaticResource SubtleButton}" AutomationProperties.Name="Folder" Command="{Binding OpenFolderCommand}" ToolTip="Open the local repo folder" Visibility="{Binding IsNotInbox, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" /><TextBlock Text="Folder" Margin="6,0,0,0" /></StackPanel>
                </Button>
                <Button Style="{StaticResource SubtleButton}" AutomationProperties.Name="VS Code" Command="{Binding OpenVsCodeCommand}" ToolTip="Open the repo in VS Code" Visibility="{Binding IsNotInbox, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE943;" /><TextBlock Text="VS Code" Margin="6,0,0,0" /></StackPanel>
                </Button>
                <Button Style="{StaticResource SubtleButton}" AutomationProperties.Name="Terminal" Command="{Binding OpenTerminalCommand}" ToolTip="Open a terminal in the repo" Visibility="{Binding IsNotInbox, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE756;" /><TextBlock Text="Terminal" Margin="6,0,0,0" /></StackPanel>
                </Button>
                <Button Style="{StaticResource SubtleButton}" AutomationProperties.Name="GitHub" Command="{Binding OpenGitHubCommand}" ToolTip="Open the GitHub page" Visibility="{Binding IsNotInbox, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE774;" /><TextBlock Text="GitHub" Margin="6,0,0,0" /></StackPanel>
                </Button>
                <Button Style="{StaticResource SubtleButton}" AutomationProperties.Name="Chat" Command="{Binding OpenChatCommand}" ToolTip="Live chat about this project: its #channel, or start one" Visibility="{Binding CanStartChannels, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8F2;" /><TextBlock Text="Chat" Margin="6,0,0,0" /></StackPanel>
                </Button>
                <Button Style="{StaticResource SubtleButton}" AutomationProperties.Name="Wiki" Command="{Binding OpenWikiCommand}" ToolTip="The project's wiki pages, or start one"
                        Visibility="{Binding CanHaveWikiPages, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE82D;" /><TextBlock Text="Wiki" Margin="6,0,0,0" /></StackPanel>
                </Button>
                <Button Style="{StaticResource SubtleButton}" AutomationProperties.Name="Copy prompt" Command="{Binding CopyPromptCommand}"
                        ToolTip="Copy selected items (Ctrl+Space / Ctrl+click the grip) — or all open items — as a prompt for Claude/Codex (Ctrl+Shift+C)">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" /><TextBlock Text="Copy prompt" Margin="6,0,0,0" /></StackPanel>
                </Button>
                <Button Style="{StaticResource SubtleButton}" AutomationProperties.Name="Release" Command="{Binding NewReleaseCommand}" ToolTip="Patch notes from items done since the last release" Visibility="{Binding IsNotInbox, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE7C1;" /><TextBlock Text="Release" Margin="6,0,0,0" /></StackPanel>
                </Button>
                <Button Style="{StaticResource SubtleButton}" AutomationProperties.Name="Ship" Command="{Binding StartShipCommand}" Visibility="{Binding CanShip, Converter={StaticResource BoolToVis}}"
                        ToolTip="Ask an AI agent to commit, build, package, push or release this project; you approve its plan first">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE724;" /><TextBlock Text="Ship" Margin="6,0,0,0" /></StackPanel>
                </Button>
                <Button Style="{StaticResource SubtleButton}" AutomationProperties.Name="Clean up" Command="{Binding StartCleanupCommand}" Visibility="{Binding CanCleanUp, Converter={StaticResource BoolToVis}}"
                        ToolTip="Ask an AI agent what could go from the repo folder (old builds, copies, leftovers); you decide, and it goes to the Recycle Bin">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xEA99;" /><TextBlock Text="Clean up" Margin="6,0,0,0" /></StackPanel>
                </Button>
                <Button Style="{StaticResource SubtleButton}" AutomationProperties.Name="Export" Command="{Binding ExportCommand}" ToolTip="Export to TODO/DONE text files">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xEDE1;" /><TextBlock Text="Export" Margin="6,0,0,0" /></StackPanel>
                </Button>
                <!-- The glyph has the icon font, not the button: its menu would inherit it and show boxes for letters. -->
                <Button x:Name="HeaderCog" Style="{StaticResource SubtleButton}" Click="HeaderCog_Click" AutomationProperties.Name="Choose the big buttons"
                        ToolTip="Choose which of these buttons show big, on the left">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" FontSize="13" />
                </Button>
            </WrapPanel>
            </StackPanel>
        </Grid>

        <TabControl Grid.Row="1" Margin="16,8,16,8" SelectedIndex="{Binding SelectedTab}">
            <!-- Board -->
            <TabItem Header="Board">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- The filter box gives up width first, so the buttons on the right stay visible; when it's still too narrow
                         (e.g. with the discussion panel open) the buttons drop their labels. -->
                    <Grid x:Name="Toolbar" Margin="4,0,4,8" SizeChanged="Toolbar_SizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1000*" MinWidth="140" MaxWidth="260" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <TextBox x:Name="FilterBox" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="FilterBox_PreviewKeyDown" />
                            <TextBlock x:Name="FilterHint" Text="Filter (Ctrl+F)" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Visibility="{Binding FilterText, Converter={StaticResource InvEmptyToVis}}" />
                        </Grid>
                        <StackPanel x:Name="ToolbarMiddle" Grid.Column="1" Orientation="Horizontal">
                            <ComboBox x:Name="TagFilterBox" ItemsSource="{Binding TagFilters}" SelectedItem="{Binding TagFilter}" Width="130" Margin="8,0,0,0" ToolTip="Filter by tag" />
                            <ComboBox x:Name="StateFilterBox" ItemsSource="{x:Static vm:ProjectViewModel.StateFilters}" SelectedItem="{Binding StateFilter}" DisplayMemberPath="Label" Width="130" Margin="8,0,0,0"
                                      AutomationProperties.Name="Filter by state" ToolTip="Show only to do, in progress or done items" />
                            <Button x:Name="PriorityButton" Style="{StaticResource SubtleButton}" Margin="8,0,0,0" Click="PriorityButton_Click"
                                    AutomationProperties.Name="Priority" ToolTip="Sort the board by priority, or show only items of some priority">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8CB;">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPriorityViewActive}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock x:Name="PriorityLabel" Text="{Binding PriorityButtonText}" Margin="6,0,0,0" />
                                    <TextBlock x:Name="PriorityChevron" Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="9" Margin="6,1,0,0" />
                                </StackPanel>
                            </Button>
                            <ToggleButton x:Name="WorkingOnToggle" Style="{StaticResource SubtleToggle}" AutomationProperties.Name="Working on" IsChecked="{Binding ShowWorkingOn}" Margin="4,0,0,0"
                                          ToolTip="Show only items someone is working on: checked out by an AI agent or marked in progress (Ctrl+I)">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE768;" /><TextBlock x:Name="WorkingOnLabel" Text="Working on" Margin="6,0,0,0" /></StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="ShowDoneToggle" Style="{StaticResource SubtleToggle}" AutomationProperties.Name="Show done" IsChecked="{Binding ShowDone}" Margin="12,0,0,0" ToolTip="Expand every DONE section">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" /><TextBlock x:Name="ShowDoneLabel" Text="Show done" Margin="6,0,0,0" /></StackPanel>
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource SubtleToggle}" AutomationProperties.Name="Side by side" IsChecked="{Binding SideBySide}" Margin="4,0,0,0" ToolTip="TODO and DONE columns side by side">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE89A;" /><TextBlock x:Name="SideBySideLabel" Text="Side by side" Margin="6,0,0,0" /></StackPanel>
                            </ToggleButton>
                            <Button Style="{StaticResource SubtleButton}" AutomationProperties.Name="{Binding ToggleAllText}" Command="{Binding ToggleAllCategoriesCommand}" Margin="4,0,0,0" ToolTip="Fold or unfold every category">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="{Binding ToggleAllGlyph}" /><TextBlock x:Name="ToggleAllLabel" Text="{Binding ToggleAllText}" Margin="6,0,0,0" /></StackPanel>
                            </Button>
                            <ToggleButton x:Name="HideEmptyToggle" Style="{StaticResource SubtleToggle}" AutomationProperties.Name="{Binding HideEmptyText}" IsChecked="{Binding HideEmpty}"
                                          Margin="4,0,0,0" ToolTip="{Binding HideEmptyToolTip}">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="{Binding HideEmptyGlyph}" /><TextBlock x:Name="HideEmptyLabel" Text="{Binding HideEmptyText}" Margin="6,0,0,0" /></StackPanel>
                            </ToggleButton>
                        </StackPanel>
                        <StackPanel x:Name="ToolbarRight" Grid.Column="3" Orientation="Horizontal" Margin="12,0,0,0">
                            <Button Style="{StaticResource SubtleIconButton}" Content="&#xE8E6;" AutomationProperties.Name="Clear selection" Command="{Binding ClearSelectionCommand}" ToolTip="Clear prompt selection"
                                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource SubtleIconButton}" Content="&#xE7A7;" AutomationProperties.Name="Undo" Command="{Binding UndoCommand}" ToolTip="Undo (Ctrl+Z)" />
                            <Button Style="{StaticResource SubtleIconButton}" Content="&#xE7A6;" AutomationProperties.Name="Redo" Command="{Binding RedoCommand}" ToolTip="Redo (Ctrl+Y)" />
                            <Button Style="{StaticResource SubtleButton}" AutomationProperties.Name="Add category" Command="{Binding AddCategoryCommand}" ToolTip="New category">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE710;" /><TextBlock x:Name="CategoryLabel" Text="Category" Margin="6,0,0,0" /></StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <DockPanel Grid.Row="1">
                    <!-- Focus: only one item or category shows, and the way back. -->
                    <Border x:Name="FocusBar" DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="14,6" Margin="4,0,8,8"
                            Visibility="{Binding IsFocused, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Command="{Binding LeaveFocusCommand}" Margin="12,0,0,0"
                                    ToolTip="Show the whole board again, with your filters as they were">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE711;" /><TextBlock Text="Leave focus" Margin="6,0,0,0" /></StackPanel>
                            </Button>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE890;" Margin="0,0,10,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding FocusText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <!-- "Working on" found nothing: why, and where to see what agents are doing. -->
                    <Border x:Name="WorkingOnHint" DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="14,10" Margin="4,0,8,8"
                            Visibility="{Binding ShowWorkingOnHint, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE768;" Margin="0,2,10,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock TextWrapping="Wrap">
                                <Run Text="{Binding WorkingOnHintText, Mode=OneWay}" />
                                <Hyperlink Command="{Binding ShowAgentsCommand}" TextDecorations="{x:Null}">See what agents are doing</Hyperlink>
                            </TextBlock>
                        </DockPanel>
                    </Border>
                    <!-- A ship request: choosing its steps, then the agent's plan, your decision and what the agent reports. -->
                    <Border x:Name="ShipCard" DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="14,10" Margin="4,0,8,8"
                            Visibility="{Binding HasShipCard, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <StackPanel Visibility="{Binding IsComposingShip, Converter={StaticResource BoolToVis}}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <Button Style="{StaticResource SubtleButton}" Content="Cancel" Command="{Binding CancelShipRequestCommand}" />
                                        <Button Style="{StaticResource AccentButtonStyle}" Content="Ask to ship" Command="{Binding RequestShipCommand}" Margin="6,0,0,0" />
                                    </StackPanel>
                                    <WrapPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE724;" Margin="0,0,8,0" />
                                        <TextBlock Text="Ship this project:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <ItemsControl ItemsSource="{Binding ShipChoices}" Focusable="False" VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:ShipStepChoice}">
                                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" ToolTip="{Binding ToolTip}" MinWidth="0" Margin="0,0,16,0" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </WrapPanel>
                                </DockPanel>
                                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="An AI agent working in this project posts its plan here: the version, what's in it, items still waiting for your review and what it will run. Nothing runs until you approve it. How this project is shipped: Details › Shipping." />
                            </StackPanel>
                            <StackPanel Visibility="{Binding ShowShipRequest, Converter={StaticResource BoolToVis}}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <Button Style="{StaticResource SubtleButton}" Content="Withdraw" Command="{Binding WithdrawShipCommand}" ToolTip="Take the request back"
                                                Visibility="{Binding CanWithdrawShip, Converter={StaticResource BoolToVis}}" />
                                        <Button Style="{StaticResource SubtleButton}" Content="Decline" Command="{Binding DeclineShipCommand}" Margin="6,0,0,0"
                                                Visibility="{Binding ShipWaitsForYou, Converter={StaticResource BoolToVis}}" />
                                        <Button Style="{StaticResource AccentButtonStyle}" Content="Approve" Command="{Binding ApproveShipCommand}" Margin="6,0,0,0"
                                                ToolTip="Lets the agent run this plan" Visibility="{Binding ShipWaitsForYou, Converter={StaticResource BoolToVis}}" />
                                        <Button Style="{StaticResource SubtleIconButton}" Content="&#xE711;" FontSize="12" Command="{Binding DismissShipCommand}" ToolTip="Close"
                                                AutomationProperties.Name="Close ship request" Visibility="{Binding CanDismissShip, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <WrapPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE724;" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding ShipTitle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Border Style="{StaticResource TagChip}" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ShipStateText}" FontSize="11" />
                                        </Border>
                                        <Ellipse Style="{StaticResource UnreadDot}" Margin="6,0,0,0" ToolTip="The plan waits for your approval"
                                                 Visibility="{Binding ShipWaitsForYou, Converter={StaticResource BoolToVis}}" />
                                    </WrapPanel>
                                </DockPanel>
                                <TextBlock Text="{Binding ShipStatusText}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="10,8" Margin="0,8,0,0"
                                        Visibility="{Binding HasShipPlan, Converter={StaticResource BoolToVis}}">
                                    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                                        <TextBox x:Name="ShipPlanText" Style="{StaticResource SelectableText}" Text="{Binding ShipPlan, Mode=OneWay}" AutomationProperties.Name="Plan" />
                                    </ScrollViewer>
                                </Border>
                                <ItemsControl ItemsSource="{Binding ShipLog}" Focusable="False" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ShipLogLine}">
                                            <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,1,0,0">
                                                <Run Text="{Binding Time, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" /><Run Text="   " /><Run
                                                     Text="{Binding By, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="   " /><Run Text="{Binding Text, Mode=OneWay}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Videos' publish plans: pick a thumbnail, edit the text, approve or decline; nothing goes out before that. -->
                    <ItemsControl x:Name="PublishCards" DockPanel.Dock="Top" ItemsSource="{Binding PublishCards}" Focusable="False"
                                  Visibility="{Binding HasPublishCards, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PublishPlanViewModel}">
                                <Border Style="{StaticResource Card}" Padding="14,10" Margin="4,0,8,8">
                                    <StackPanel>
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <Button Style="{StaticResource SubtleButton}" Content="Withdraw" Command="{Binding WithdrawCommand}" ToolTip="Take the plan back"
                                                        Visibility="{Binding CanWithdraw, Converter={StaticResource BoolToVis}}" />
                                                <Button Style="{StaticResource SubtleButton}" Content="Decline" Command="{Binding DeclineCommand}" Margin="6,0,0,0"
                                                        Visibility="{Binding WaitsForYou, Converter={StaticResource BoolToVis}}" />
                                                <Button Style="{StaticResource AccentButtonStyle}" Content="Approve" Command="{Binding ApproveCommand}" Margin="6,0,0,0"
                                                        ToolTip="Lets the agent publish it as it is now: your text and the thumbnail you picked"
                                                        Visibility="{Binding WaitsForYou, Converter={StaticResource BoolToVis}}" />
                                                <Button Style="{StaticResource SubtleIconButton}" Content="&#xE711;" FontSize="12" Command="{Binding DismissCommand}" ToolTip="Close"
                                                        AutomationProperties.Name="Close publish plan" Visibility="{Binding CanDismiss, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                            <WrapPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE714;" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <Border Style="{StaticResource TagChip}" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StateText}" FontSize="11" />
                                                </Border>
                                                <Ellipse Style="{StaticResource UnreadDot}" Margin="6,0,0,0" ToolTip="The plan waits for your decision"
                                                         Visibility="{Binding WaitsForYou, Converter={StaticResource BoolToVis}}" />
                                            </WrapPanel>
                                        </DockPanel>
                                        <TextBlock Text="{Binding ItemText}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                                   Visibility="{Binding HasItemText, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding Note}" TextWrapping="Wrap" FontStyle="Italic" Margin="0,4,0,0"
                                                   Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Margin="0,4,0,0" Visibility="{Binding HasUrl, Converter={StaticResource BoolToVis}}">
                                            <Hyperlink Command="{Binding OpenUrlCommand}"><Run Text="{Binding Url, Mode=OneWay}" /></Hyperlink>
                                        </TextBlock>
                                        <ItemsControl ItemsSource="{Binding Thumbnails}" Focusable="False" Margin="0,10,0,0"
                                                      Visibility="{Binding HasThumbnails, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:PublishThumbnailViewModel}">
                                                    <Button Command="{Binding ChooseCommand}" ToolTip="{Binding ToolTip}" AutomationProperties.Name="{Binding ToolTip}"
                                                            Margin="0,0,10,6" Cursor="Hand" Focusable="True">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="Frame" CornerRadius="8" BorderThickness="3" BorderBrush="Transparent" Padding="2" Background="Transparent">
                                                                    <Grid>
                                                                        <Border CornerRadius="5" ClipToBounds="True" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                                                            <Image Source="{Binding Attachment.Thumbnail}" Width="208" Height="117" Stretch="UniformToFill" />
                                                                        </Border>
                                                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6" CornerRadius="9" Padding="7,1" Background="#B0000000">
                                                                            <TextBlock Text="{Binding Number}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                                                                        </Border>
                                                                        <Border x:Name="Check" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Width="22" Height="22" CornerRadius="11"
                                                                                Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed">
                                                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" Foreground="White" FontSize="12"
                                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        </Border>
                                                                    </Grid>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                                        <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                                                    </Trigger>
                                                                    <DataTrigger Binding="{Binding IsChosen}" Value="True">
                                                                        <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                                        <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <!-- The text, yours to change while the plan waits for you (applied when you leave a box). -->
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="Title" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,12,6" />
                                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Title}" IsReadOnly="{Binding IsReadOnly}" Margin="0,0,0,6"
                                                     AutomationProperties.Name="Title" />
                                            <TextBlock Grid.Row="1" Text="Description" Style="{StaticResource MutedText}" VerticalAlignment="Top" Margin="0,6,12,6" />
                                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Description}" IsReadOnly="{Binding IsReadOnly}" AcceptsReturn="True"
                                                     TextWrapping="Wrap" MaxHeight="150" VerticalScrollBarVisibility="Auto" Margin="0,0,0,6" AutomationProperties.Name="Description" />
                                            <TextBlock Grid.Row="2" Text="Tags" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,12,6" />
                                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding TagsText}" IsReadOnly="{Binding IsReadOnly}" Margin="0,0,0,6"
                                                     ToolTip="Separated by commas" AutomationProperties.Name="Tags" />
                                            <TextBlock Grid.Row="3" Text="Playlists" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,12,6" />
                                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding PlaylistsText}" IsReadOnly="{Binding IsReadOnly}" Margin="0,0,0,6"
                                                     ToolTip="Separated by commas" AutomationProperties.Name="Playlists" />
                                            <TextBlock Grid.Row="4" Text="When" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding When}" IsReadOnly="{Binding IsReadOnly}" AutomationProperties.Name="When" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Log}" Focusable="False" Margin="0,8,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:ShipLogLine}">
                                                    <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,1,0,0">
                                                        <Run Text="{Binding Time, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" /><Run Text="   " /><Run
                                                             Text="{Binding By, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="   " /><Run Text="{Binding Text, Mode=OneWay}" />
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- A clean-up of the repo folder: the agent's plan to tick, then the Recycle Bin. -->
                    <Border x:Name="CleanupCard" DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="14,10" Margin="4,0,8,8"
                            Visibility="{Binding HasCleanupCard, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="Withdraw" Command="{Binding WithdrawCleanupCommand}" Margin="6,0,0,0"
                                            Visibility="{Binding CanWithdrawCleanup, Converter={StaticResource BoolToVis}}" />
                                    <Button Content="Decline" Command="{Binding DeclineCleanupCommand}" Margin="6,0,0,0"
                                            Visibility="{Binding CleanupWaitsForYou, Converter={StaticResource BoolToVis}}" />
                                    <Button Content="{Binding CleanUpSafeText}" Command="{Binding CleanUpSafeCommand}" IsEnabled="{Binding CanCleanUpSafe}" Margin="6,0,0,0"
                                            Visibility="{Binding CleanupWaitsForYou, Converter={StaticResource BoolToVis}}" ToolTip="Moves the ticked safe lines to the Recycle Bin" />
                                    <Button Content="{Binding CleanUpAllText}" Style="{StaticResource AccentButtonStyle}" Command="{Binding CleanUpAllCommand}" IsEnabled="{Binding CanCleanUpAll}"
                                            Margin="6,0,0,0" Visibility="{Binding CleanupWaitsForYou, Converter={StaticResource BoolToVis}}"
                                            ToolTip="Moves every ticked line, safe and thorough, to the Recycle Bin" />
                                    <Button Style="{StaticResource SubtleIconButton}" Content="&#xE711;" Command="{Binding DismissCleanupCommand}" Margin="6,0,0,0" ToolTip="Close"
                                            AutomationProperties.Name="Close the clean-up" Visibility="{Binding CanDismissCleanup, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <WrapPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xEA99;" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="Clean-up of the repo folder" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource TagChip}" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CleanupStateText}" FontSize="11" />
                                    </Border>
                                    <Ellipse Style="{StaticResource UnreadDot}" Margin="6,0,0,0" Visibility="{Binding CleanupWaitsForYou, Converter={StaticResource BoolToVis}}" />
                                </WrapPanel>
                            </DockPanel>
                            <TextBlock Text="{Binding CleanupStatusText}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            <Border Margin="0,8,0,0" Visibility="{Binding HasCleanupEntries, Converter={StaticResource BoolToVis}}">
                                <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding CleanupEntries}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:CleanupEntryRow}">
                                                <DockPanel Margin="0,1">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Size}" Style="{StaticResource MutedText}" FontSize="12" Width="72" TextAlignment="Right" />
                                                    <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsEditable}" MinWidth="0" VerticalAlignment="Top" Margin="0,0,6,0"
                                                              AutomationProperties.Name="{Binding Path}" />
                                                    <Border x:Name="Level" Style="{StaticResource TagChip}" Background="{DynamicResource SystemFillColorCautionBrush}" Margin="0,1,8,0" VerticalAlignment="Top" Width="62">
                                                        <TextBlock Text="{Binding Level}" FontSize="11" HorizontalAlignment="Center" Foreground="Black" />
                                                    </Border>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Path}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                                        <TextBlock Text="{Binding Reason}" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Result}" FontSize="11" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                                   Visibility="{Binding Result, Converter={StaticResource EmptyToVis}}" />
                                                    </StackPanel>
                                                </DockPanel>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsSafe}" Value="True">
                                                        <Setter TargetName="Level" Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                            <ItemsControl ItemsSource="{Binding CleanupLog}" Focusable="False" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ShipLogLine}">
                                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,1,0,0">
                                            <Run Text="{Binding Time, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" /><Run Text="   " /><Run
                                                 Text="{Binding By, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="   " /><Run Text="{Binding Text, Mode=OneWay}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Set by clicking a name under an item: only what that person or agent worked on. -->
                    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="10,4" Margin="4,0,8,8"
                            Visibility="{Binding IsWorkedByActive, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Content="Show everyone's" Command="{Binding ClearWorkedByCommand}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE716;" Margin="0,0,8,0" />
                                <TextBlock Text="Showing what this person or agent worked on:" VerticalAlignment="Center" />
                                <ComboBox ItemsSource="{Binding WorkedByChoices}" SelectedItem="{Binding WorkedBy}" MinWidth="170" Margin="8,0,0,0"
                                          AutomationProperties.Name="Worked on by" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <ScrollViewer x:Name="BoardScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="4,0,8,0">
                        <StackPanel>
                            <ctl:OutlineItemsControl x:Name="Board" ItemsSource="{Binding Categories}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ContentControl Content="{Binding}" Focusable="False">
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource StackedCategoryTemplate}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.SideBySide, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                            <Setter Property="ContentTemplate" Value="{StaticResource SideBySideCategoryTemplate}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                        </ContentControl>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ctl:OutlineItemsControl>
                            <TextBlock Text="No categories yet — add one with “+ Category”." Style="{StaticResource MutedText}" Margin="8,12"
                                       Visibility="{Binding Categories.Count, Converter={StaticResource InvEmptyToVis}}" />
                        </StackPanel>
                    </ScrollViewer>
                    </DockPanel>

                    <TextBlock Grid.Row="2" Style="{StaticResource MutedText}" FontSize="11" Margin="6,6,0,0" TextWrapping="Wrap"
                               Text="Right-click an item, or point at it for its discussion and ⋯ buttons · Enter new item · Shift+Enter new line · Tab / Shift+Tab indent · Ctrl+Enter done · Ctrl+I in progress · Alt+1…5 priority · Alt+↑↓ move · Ctrl+Space select for prompt · Ctrl+Shift+Del delete · Ctrl+Z undo" />
                </Grid>
            </TabItem>

            <!-- Notes -->
            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="{Binding Notes.Count, StringFormat=Notes ({0})}" />
                </TabItem.Header>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Style="{StaticResource SubtleButton}" AutomationProperties.Name="New note" Command="{Binding AddNoteCommand}">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE710;" /><TextBlock Text="New note" Margin="6,0,0,0" /></StackPanel>
                            </Button>
                            <Button Style="{StaticResource SubtleButton}" AutomationProperties.Name="Delete note" Command="{Binding DeleteNoteCommand}">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" /><TextBlock Text="Delete" Margin="6,0,0,0" /></StackPanel>
                            </Button>
                            <Button Style="{StaticResource SubtleButton}" AutomationProperties.Name="Move to wiki" Command="{Binding MoveNoteToWikiCommand}"
                                    ToolTip="Turn the note into a wiki page about this project, with its files: versions, links and the agents' wiki tools then apply"
                                    Visibility="{Binding IsOwnProject, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE82D;" /><TextBlock Text="To wiki" Margin="6,0,0,0" /></StackPanel>
                            </Button>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Notes}" SelectedItem="{Binding SelectedNote}" DisplayMemberPath="Title" />
                    </DockPanel>
                    <DockPanel Grid.Column="1" Margin="12,0,0,0" Visibility="{Binding SelectedNote, Converter={StaticResource EmptyToVis}}">
                        <TextBox DockPanel.Dock="Top" Text="{Binding SelectedNote.Title, UpdateSourceTrigger=PropertyChanged}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"
                                 IsReadOnly="{Binding IsReadOnlyBoard}" />
                        <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedNote.EditedText}" Style="{StaticResource MutedText}" FontSize="11" Margin="2,0,0,6"
                                   Visibility="{Binding SelectedNote.EditedText, Converter={StaticResource EmptyToVis}}" />
                        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <Button DockPanel.Dock="Left" Style="{StaticResource SubtleButton}" VerticalAlignment="Top" AutomationProperties.Name="Attach files to the note"
                                    Command="{Binding SelectedNote.AttachCommand}" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE723;" /><TextBlock Text="Attach files…" Margin="6,0,0,0" /></StackPanel>
                            </Button>
                            <ItemsControl ItemsSource="{Binding SelectedNote.Attachments}" ItemTemplateSelector="{StaticResource AttachmentTemplate}"
                                          ItemsPanel="{StaticResource WrapItems}" Focusable="False" />
                        </DockPanel>
                        <TextBox Text="{Binding SelectedNote.Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" IsReadOnly="{Binding IsReadOnlyBoard}"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource MonoFont}" FontSize="13"
                                 VerticalContentAlignment="Top" />
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- Releases -->
            <TabItem Header="Releases" Visibility="{Binding IsNotInbox, Converter={StaticResource BoolToVis}}">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Style="{StaticResource SubtleButton}" Command="{Binding NewReleaseCommand}">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE710;" /><TextBlock Text="New release" Margin="6,0,0,0" /></StackPanel>
                            </Button>
                            <Button Style="{StaticResource SubtleButton}" AutomationProperties.Name="Delete release" Command="{Binding DeleteReleaseCommand}">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" /><TextBlock Text="Delete" Margin="6,0,0,0" /></StackPanel>
                            </Button>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Releases}" SelectedItem="{Binding SelectedRelease}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Version}" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource MutedText}">
                                            <Run Text="{Binding Date, StringFormat=d MMM yyyy, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding ItemIds.Count, Mode=OneWay}" /><Run Text=" items" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource MutedText}" FontSize="11" Text="{Binding CreatedBy, StringFormat=by {0}}"
                                                   Visibility="{Binding CreatedBy, Converter={StaticResource EmptyToVis}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                    <DockPanel Grid.Column="1" Margin="12,0,0,0">
                        <Button DockPanel.Dock="Top" HorizontalAlignment="Right" Style="{StaticResource SubtleButton}" AutomationProperties.Name="Copy patch notes" Command="{Binding CopyReleaseCommand}" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" /><TextBlock Text="Copy patch notes" Margin="6,0,0,0" /></StackPanel>
                        </Button>
                        <TextBox Text="{Binding SelectedRelease.Markdown, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 FontFamily="{StaticResource MonoFont}" FontSize="13" VerticalContentAlignment="Top" />
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- Archive -->
            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="{Binding Archive.Count, StringFormat=Archive ({0})}" />
                </TabItem.Header>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="2,0,0,8"
                                   Text="Original text of the files this project was imported from (read-only)." />
                        <ListBox ItemsSource="{Binding Archive}" SelectedItem="{Binding SelectedArchive}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding LastWriteTime, StringFormat='modified {0:d MMM yyyy HH:mm}'}" Style="{StaticResource MutedText}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                    <TextBox Grid.Column="1" Margin="12,0,0,0" Text="{Binding SelectedArchive.Text, Mode=OneWay}" IsReadOnly="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource MonoFont}" FontSize="13" VerticalContentAlignment="Top" />
                </Grid>
            </TabItem>

            <!-- Details -->
            <TabItem Header="Details">
                <ScrollViewer VerticalScrollBarVisibility="Auto" IsEnabled="{Binding IsOwnProject}">
                    <Grid Margin="4,12,12,12" MaxWidth="820" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.Resources>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                <Setter Property="Margin" Value="0,10,12,0" />
                                <Setter Property="VerticalAlignment" Value="Top" />
                                <Setter Property="FontSize" Value="13" />
                            </Style>
                        </Grid.Resources>

                        <TextBlock Grid.Row="0" Text="Export file names" />
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                            <ComboBox Text="{Binding FilePrefix, UpdateSourceTrigger=LostFocus}" IsEditable="True" Width="100" ToolTip="Prefix of the open-items file">
                                <ComboBoxItem Content="TODO" />
                                <ComboBoxItem Content="WORK" />
                            </ComboBox>
                            <TextBlock Text="-" Margin="6,0" VerticalAlignment="Center" />
                            <TextBox Text="{Binding Key, UpdateSourceTrigger=LostFocus}" Width="220" ToolTip="File name stem (letters, digits, . _ -)" />
                            <TextBlock Text="{Binding ExportNamesText}" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Grid.Row="1" Text="Local repo folder" />
                        <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,4">
                            <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseRepoCommand}" Margin="8,0,0,0" />
                            <TextBox Text="{Binding RepoPath, UpdateSourceTrigger=LostFocus}" />
                        </DockPanel>

                        <TextBlock Grid.Row="2" Text="GitHub URL" />
                        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,4" Text="{Binding GitHubUrl, UpdateSourceTrigger=LostFocus}" />

                        <TextBlock Grid.Row="3" Text="GitHub issues" />
                        <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,4">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{Binding SyncIssuesText}" Command="{Binding SyncIssuesCommand}" />
                                <CheckBox Content="Sync when ProJict starts" IsChecked="{Binding KeepIssuesInSync}" Margin="16,0,0,0" VerticalAlignment="Center"
                                          Visibility="{Binding HasIssueSync, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                            <CheckBox Content="Close an issue on GitHub when I finish its item here, and reopen it when I reopen the item"
                                      IsChecked="{Binding CloseIssuesOnGitHub}" Margin="0,8,0,0"
                                      Visibility="{Binding HasIssueSync, Converter={StaticResource BoolToVis}}"
                                      ToolTip="Needs the GitHub CLI sign-in (Settings › GitHub) with access to the repository. Items already finished get their issues closed too." />
                            <TextBlock Text="{Binding IssueSyncText}" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock Grid.Row="4" Text="Icon" />
                        <StackPanel x:Name="IconDetails" Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                            <Image Source="{Binding Icon}" Width="32" Height="32" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}" />
                            <Button Content="Choose…" Command="{Binding ChooseIconCommand}" VerticalAlignment="Center"
                                    ToolTip="A small picture shown beside the project's name: in the sidebar, here and on the Dashboard (any image: it's cut to a square)" />
                            <Button Content="Remove" Command="{Binding RemoveIconCommand}" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>

                        <TextBlock Grid.Row="5" Text="Description" />
                        <TextBox Grid.Row="5" Grid.Column="1" Margin="0,4" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" VerticalContentAlignment="Top" />

                        <TextBlock Grid.Row="6" Text="Prompt preamble" />
                        <StackPanel Grid.Row="6" Grid.Column="1" Margin="0,4">
                            <TextBox Text="{Binding PromptPreamble, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="120" VerticalContentAlignment="Top" FontFamily="{StaticResource MonoFont}" FontSize="13" />
                            <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                                       Text="Put at the top of every “Copy prompt”: engine version, conventions, how to test, what to commit…" />
                        </StackPanel>

                        <TextBlock Grid.Row="7" Text="Shipping" Visibility="{Binding CanChangeShipping, Converter={StaticResource BoolToVis}}" />
                        <StackPanel Grid.Row="7" Grid.Column="1" Margin="0,4" Visibility="{Binding CanChangeShipping, Converter={StaticResource BoolToVis}}">
                            <ItemsControl ItemsSource="{Binding ShipSteps}" Focusable="False" AutomationProperties.Name="Steps this project has">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ShipStepChoice}">
                                        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" ToolTip="{Binding ToolTip}" MinWidth="0" Margin="0,0,16,0" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <CheckBox Content="Commit, build and package without asking me (push and release always ask)" IsChecked="{Binding ShipLocalWithoutApproval}" Margin="0,8,0,0" />
                            <TextBox Text="{Binding ShipHowTo, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,8,0,0"
                                     MinHeight="100" VerticalContentAlignment="Top" FontFamily="{StaticResource MonoFont}" FontSize="13" AutomationProperties.Name="How to ship" />
                            <!-- An agent changed the steps or how-to: shown until you've checked it -->
                            <Border x:Name="ShipChangeCard" Style="{StaticResource Card}" Padding="10,8" Margin="0,6,0,0"
                                    Visibility="{Binding HasShipChange, Converter={StaticResource BoolToVis}}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Looks good" Margin="10,0,0,0" VerticalAlignment="Center" Command="{Binding AcceptShipChangeCommand}"
                                            ToolTip="Ship requests can run without asking again where you allowed that" />
                                    <TextBlock Text="{Binding ShipChangeText}" TextWrapping="Wrap" VerticalAlignment="Center"
                                               Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                </DockPanel>
                            </Border>
                            <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                                       Text="How to ship it: what an AI agent does when you ask (Ship button), e.g. bump the version in …, run build.ps1, test, commit, push, publish the GitHub release. Untick the steps this project doesn't have." />
                        </StackPanel>

                        <TextBlock Grid.Row="9" Text="Test build" />
                        <StackPanel Grid.Row="9" Grid.Column="1" Margin="0,4">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseTestBuildCommand}" Margin="8,0,0,0"
                                        Visibility="{Binding IsRemote, Converter={StaticResource InvBoolToVis}}" />
                                <!-- A shared project's test build is on its host's computer: ask for it here. -->
                                <Button x:Name="GetTestBuildDetailsButton" DockPanel.Dock="Right" Command="{Binding GetTestBuildCommand}" IsEnabled="{Binding CanGetTestBuild}" Margin="8,0,0,0"
                                        Content="{Binding GetTestBuildText}" ToolTip="{Binding GetTestBuildToolTip}" AutomationProperties.Name="Get the test build"
                                        Visibility="{Binding ShowGetTestBuild, Converter={StaticResource BoolToVis}}" />
                                <TextBox Text="{Binding TestBuildPath, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Test build path" />
                            </DockPanel>
                            <TextBox Text="{Binding TestBuildNote, UpdateSourceTrigger=LostFocus}" Margin="0,6,0,0" AutomationProperties.Name="What to try"
                                     IsEnabled="{Binding HasTestBuild}" ToolTip="What it is or what to try, in a line" />
                            <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                                       Text="The build to try now: an app, installer, folder or file (a relative path is in the repo folder). It shows under the project's name with Run. Agents set it after building (update_project test_build)." />
                        </StackPanel>

                        <TextBlock Grid.Row="8" Text="Sharing" Visibility="{Binding CanBePrivate, Converter={StaticResource BoolToVis}}" />
                        <StackPanel Grid.Row="8" Grid.Column="1" Margin="0,8,0,4" Visibility="{Binding CanBePrivate, Converter={StaticResource BoolToVis}}">
                            <CheckBox Content="Private" IsChecked="{Binding IsPrivate}" AutomationProperties.Name="Private project" />
                            <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                                       Text="Only on this computer: people you share with, and their agents, don't see it or its channels, even when its group is shared with them. You and your own agents still do." />
                        </StackPanel>

                        <!-- The project's studios (a game studio, a film studio, or both): each one's roles and what each expects; hiring is in the Agents view. -->
                        <TextBlock Grid.Row="10" Text="Studios" Visibility="{Binding CanHaveStudio, Converter={StaticResource BoolToVis}}" />
                        <StackPanel x:Name="StudioDetails" Grid.Row="10" Grid.Column="1" Margin="0,4" Visibility="{Binding CanHaveStudio, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Set up a game studio" Command="{Binding SetUpStudioCommand}" CommandParameter="Game" Margin="0,0,8,0"
                                        Visibility="{Binding CanSetUpGameStudio, Converter={StaticResource BoolToVis}}" />
                                <Button Content="Set up a film studio" Command="{Binding SetUpStudioCommand}" CommandParameter="Film"
                                        Visibility="{Binding CanSetUpFilmStudio, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                            <TextBlock Margin="0,4,0,6" FontSize="12" TextWrapping="Wrap" Text="{Binding StudioHint}" />
                            <ItemsControl x:Name="StudioList" ItemsSource="{Binding Studios}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,4,0,10">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <Button Content="{Binding OpenCloseText}" Command="{Binding OpenCloseCommand}" Margin="12,0,0,0" ToolTip="{Binding OpenCloseToolTip}" />
                                                <Button Content="{Binding RemoveText}" Command="{Binding RemoveCommand}" Margin="8,0,0,0"
                                                        ToolTip="Removes the studio from the project for good, with its roles and hires" />
                                            </StackPanel>
                                            <StackPanel x:Name="LeadReviewSettings" Margin="0,0,0,10">
                                                <CheckBox Content="{Binding LeadReviewsWikiText}" IsChecked="{Binding LeadReviewsWiki}" />
                                                <StackPanel Orientation="Horizontal" Margin="28,4,0,0" Visibility="{Binding LeadReviewsWiki, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="Only pages in" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <ComboBox IsEditable="True" MinWidth="220" ItemsSource="{Binding WikiFolders}" AutomationProperties.Name="Only pages in this wiki folder"
                                                              Text="{Binding LeadReviewFolder, UpdateSourceTrigger=LostFocus}"
                                                              ToolTip="A wiki folder, e.g. GRID2VR/Design; leave it empty for every page about the project" />
                                                </StackPanel>
                                                <TextBlock Margin="28,4,0,0" FontSize="12" TextWrapping="Wrap" Style="{StaticResource MutedText}" Text="{Binding LeadReviewHint}" />
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding Roles}" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:StudioRoleRow}">
                                                        <Border Style="{StaticResource Card}" Padding="10,8" Margin="0,0,0,6">
                                                            <StackPanel>
                                                                <DockPanel>
                                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding HolderText}" Style="{StaticResource MutedText}" FontSize="12"
                                                                               VerticalAlignment="Center" Margin="10,0,0,0" />
                                                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" FontWeight="SemiBold" AutomationProperties.Name="Role name" />
                                                                </DockPanel>
                                                                <TextBox Text="{Binding Definition, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,6,0,0"
                                                                         MinHeight="54" VerticalContentAlignment="Top" AutomationProperties.Name="What the role expects" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Outside tools (Settings › Tools) set up for the project -->
                        <TextBlock Grid.Row="11" Text="Tools" Visibility="{Binding CanHaveTools, Converter={StaticResource BoolToVis}}" />
                        <StackPanel x:Name="ToolDetails" Grid.Row="11" Grid.Column="1" Margin="0,4" Visibility="{Binding CanHaveTools, Converter={StaticResource BoolToVis}}">
                            <ItemsControl ItemsSource="{Binding ToolChoices}" Focusable="False" Visibility="{Binding HasToolChoices, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ProjectToolChoice}">
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" ToolTip="{Binding ToolTip}" Margin="0,2,18,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <DockPanel Margin="0,4,0,0">
                                <Button DockPanel.Dock="Right" Content="Set up tools…" Command="{Binding OpenToolsCommand}" Margin="12,0,0,0" VerticalAlignment="Top" />
                                <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding ToolsHint}" />
                            </DockPanel>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <!-- Time: how long was spent here, by whom, week by week, and the longest items -->
            <TabItem x:Name="TimeTab" Header="Time" IsSelected="{Binding IsTimeShown, Mode=OneWayToSource}"
                     Visibility="{Binding IsNotInbox, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,12,12,12">
                    <StackPanel MaxWidth="980" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding TimeHint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12" />
                        <TextBlock Text="No time yet: it counts while items are in progress, and when you log it." Style="{StaticResource MutedText}"
                                   Visibility="{Binding HasTime, Converter={StaticResource InvBoolToVis}}" />
                        <StackPanel Visibility="{Binding HasTime, Converter={StaticResource BoolToVis}}">
                            <ItemsControl ItemsSource="{Binding TimeTiles}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:StatTile}">
                                        <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,10,10" MinWidth="130" ToolTip="{Binding ToolTip}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Value}" FontSize="22" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource MutedText}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <DockPanel Margin="0,8,0,8">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="8" Height="8" CornerRadius="2" Background="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,5,0" />
                                    <TextBlock Text="People" Style="{StaticResource MutedText}" Margin="0,0,12,0" />
                                    <Border Width="8" Height="8" CornerRadius="2" Background="{StaticResource AgentActivityBrush}" Margin="0,0,5,0" />
                                    <TextBlock Text="AI agents" Style="{StaticResource MutedText}" />
                                </StackPanel>
                                <TextBlock Text="Week by week" Style="{StaticResource SectionTitle}" Margin="0" />
                            </DockPanel>
                            <ItemsControl x:Name="TimeChart" ItemsSource="{Binding TimeBars}" Height="110" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ChartBar}">
                                        <Grid Margin="3,0" Background="Transparent" ToolTip="{Binding ToolTip}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="{Binding Rest}" />
                                                <RowDefinition Height="{Binding Agents}" />
                                                <RowDefinition Height="{Binding People}" />
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="1" Background="{StaticResource AgentActivityBrush}" CornerRadius="1" />
                                            <Border Grid.Row="2" Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="1" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Height="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
                            <ItemsControl ItemsSource="{Binding TimeBars}" Focusable="False" Margin="0,3,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ChartBar}">
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource MutedText}" FontSize="10" HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Who" Style="{StaticResource SectionTitle}" Margin="0,20,0,6" />
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Name" Style="{StaticResource MutedText}" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="Items done" Style="{StaticResource MutedText}" FontSize="12" />
                                <TextBlock Grid.Column="2" Text="Time" Style="{StaticResource MutedText}" FontSize="12" />
                                <TextBlock Grid.Column="3" Text="Tokens" Style="{StaticResource MutedText}" FontSize="12" />
                                <TextBlock Grid.Column="4" Text="Cost" Style="{StaticResource MutedText}" FontSize="12" />
                            </Grid>
                            <ItemsControl x:Name="TimeWho" ItemsSource="{Binding TimeWorkers}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:TimeWorkerRow}">
                                        <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="0,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" · " /><Run Text="{Binding Kind, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" /></TextBlock>
                                                <TextBlock Grid.Column="1" Text="{Binding ItemsDone}" />
                                                <TextBlock Grid.Column="2" Text="{Binding Time}" />
                                                <TextBlock Grid.Column="3" Text="{Binding Tokens}" />
                                                <TextBlock Grid.Column="4" Text="{Binding Cost}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Took longest" Style="{StaticResource SectionTitle}" Margin="0,20,0,6" />
                            <ItemsControl x:Name="TimeLongest" ItemsSource="{Binding TimeLongest}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:TimeItemRow}">
                                        <Border Padding="6,5" CornerRadius="4" Cursor="Hand" ToolTip="Show it on the board" AutomationProperties.Name="{Binding Text}"
                                                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick" Command="{Binding ShowCommand}" />
                                            </Border.InputBindings>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Time}" FontWeight="SemiBold" Margin="12,0,0,0" />
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Usage}" Style="{StaticResource MutedText}" Margin="12,0,0,0" />
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Category}" Style="{StaticResource MutedText}" Margin="12,0,0,0" />
                                                <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
