<Window x:Class="ProJict.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="660" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <!-- A section: folded to its title and a one-line summary of what's set. -->
        <Style x:Key="Section" TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="SectionName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Summary" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="MaxWidth" Value="520" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="Body" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,2,0,4" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="22,16">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid DockPanel.Dock="Right" Width="230">
                <TextBox x:Name="Find" AutomationProperties.Name="Find a setting" TextChanged="Find_TextChanged" PreviewKeyDown="Find_PreviewKeyDown" />
                <TextBlock x:Name="FindHint" Text="Find a setting" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </Grid>
            <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>
        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock x:Name="Error" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Margin="0,12,0,0" />
            <DockPanel Margin="0,12,0,0">
                <Button DockPanel.Dock="Left" Content="Open data folder" MinWidth="120" Click="OpenData_Click" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Save" Style="{StaticResource AccentButtonStyle}" IsDefault="True" MinWidth="100" Click="Save_Click" />
                    <Button Content="Cancel" IsCancel="True" MinWidth="90" Margin="8,0,0,0" />
                </StackPanel>
            </DockPanel>
        </StackPanel>
        <!-- The sections scroll when the screen is too short for all of them; Save and Cancel stay in view. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
        <StackPanel x:Name="Sections">

        <Expander x:Name="AgentsSection" Tag="Agents" Style="{StaticResource Section}">
            <Expander.Header>
                <StackPanel>
                    <TextBlock Text="AI agents" Style="{StaticResource SectionName}" />
                    <TextBlock x:Name="AgentsSummary" Style="{StaticResource Summary}" />
                </StackPanel>
            </Expander.Header>
            <StackPanel Style="{StaticResource Body}">
                <CheckBox x:Name="AllowAgents" Content="Let AI agents (Claude Code and other MCP clients) work in ProJict" />
                <CheckBox x:Name="AgentsUseChat" Content="AI agents may use Chat (read, post and start channels)" Margin="0,4,0,0"
                          IsEnabled="{Binding IsChecked, ElementName=AllowAgents}" ToolTip="Each agent can post at most 20 messages a minute" />
                <TextBlock Style="{StaticResource MutedText}" Margin="2,4,0,0" TextWrapping="Wrap"
                           Text="Agents can check out and complete items, add items, comment, attach files and write notes, but never delete anything; what they finish waits for your review, and Ctrl+Z undoes their changes." />
                <!-- Which items agents may work on, by priority; the check boxes' Tag is the Priority. -->
                <StackPanel IsEnabled="{Binding IsChecked, ElementName=AllowAgents}" Margin="0,10,0,0">
                    <TextBlock Text="Agents may work on items that are" />
                    <WrapPanel x:Name="AgentPriorities" Margin="0,4,0,0" AutomationProperties.Name="Agents may work on">
                        <WrapPanel.Resources>
                            <!-- One row: the theme's check boxes are at least 120 wide. -->
                            <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                <Setter Property="MinWidth" Value="0" />
                                <Setter Property="Margin" Value="0,0,22,0" />
                            </Style>
                        </WrapPanel.Resources>
                        <CheckBox Content="Urgent" Tag="Urgent" />
                        <CheckBox Content="High" Tag="High" />
                        <CheckBox Content="Medium" Tag="Medium" />
                        <CheckBox Content="Low" Tag="Low" />
                        <CheckBox Content="Without a priority" Tag="None" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource MutedText}" Margin="2,4,0,0" TextWrapping="Wrap"
                               Text="Items on hold (Alt+5) are always left alone. Agents can still read and comment on the others, but can't check them out, change, attach to or complete them. A sub-item without a priority goes by the item it belongs to." />
                    <TextBlock Text="Instructions for all agents" Margin="0,12,0,0" />
                    <TextBox x:Name="AgentInstructions" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="180" VerticalScrollBarVisibility="Auto"
                             Margin="0,4,0,0" AutomationProperties.Name="Instructions for all agents" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="2,4,0,0" TextWrapping="Wrap"
                               Text="Every agent gets these, in every project: when it connects, with the project (current_project), and at the top of Copy prompt. A project's own instructions (its Details) come after them. For example: Don't add yourself as a co-author of commits (no Co-Authored-By lines)." />
                </StackPanel>
                <!-- How to add ProJict to each agent; folded away once it's set up. -->
                <Expander x:Name="ConnectAgent" Header="Connect an AI agent (Claude Code, Codex, OpenCode, …)" Margin="0,8,0,0">
                    <StackPanel Margin="0,8,0,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Copy" MinWidth="70" Margin="8,0,0,0" Click="CopyMcpCommand_Click" />
                            <ComboBox x:Name="AgentClient" Width="280" HorizontalAlignment="Left" DisplayMemberPath="Client"
                                      SelectionChanged="AgentClient_SelectionChanged" AutomationProperties.Name="AI agent" />
                        </DockPanel>
                        <TextBox x:Name="McpCommand" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                 MaxHeight="170" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0" />
                        <TextBlock x:Name="McpWhere" Style="{StaticResource MutedText}" Margin="2,4,0,0" TextWrapping="Wrap" />
                        <!-- Connected agents on the old bridge (ProJict.exe): add ProJict to them again with the command above. -->
                        <TextBlock x:Name="OldBridgeNote" Margin="2,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Expander>

        <Expander x:Name="ApiSection" Tag="Api" Style="{StaticResource Section}">
            <Expander.Header>
                <StackPanel>
                    <TextBlock Text="API" Style="{StaticResource SectionName}" />
                    <TextBlock x:Name="ApiSummary" Style="{StaticResource Summary}" />
                </StackPanel>
            </Expander.Header>
            <StackPanel Style="{StaticResource Body}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="API &amp; tokens…" MinWidth="120" Margin="12,0,0,0" VerticalAlignment="Top" Click="OpenApi_Click" />
                    <TextBlock x:Name="ApiStatus" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Style="{StaticResource MutedText}" Margin="2,4,0,0" TextWrapping="Wrap"
                           Text="Another way for agents, scripts and tools such as n8n to work in ProJict: a REST API and MCP over HTTP, with tokens you make that expire. Changes there apply right away." />
                <CheckBox x:Name="ReadOnlyTokensUseChat" Content="Read-only tokens may use Chat (read, post, start channels and invite)" Margin="0,10,0,0"
                          IsEnabled="{Binding IsChecked, ElementName=AgentsUseChat}"
                          ToolTip="A read-only token still can't change your projects; with this on, its agent talks in Chat like any other. Needs Chat on for AI agents." />
            </StackPanel>
        </Expander>

        <Expander x:Name="ToolsSection" Tag="Tools" Style="{StaticResource Section}">
            <Expander.Header>
                <StackPanel>
                    <TextBlock Text="Tools" Style="{StaticResource SectionName}" />
                    <TextBlock x:Name="ToolsSummary" Style="{StaticResource Summary}" />
                </StackPanel>
            </Expander.Header>
            <StackPanel Style="{StaticResource Body}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Tools…" MinWidth="120" Margin="12,0,0,0" VerticalAlignment="Top" Click="OpenTools_Click" />
                    <TextBlock TextWrapping="Wrap" VerticalAlignment="Center"
                               Text="Outside tools your AI agents may use for your work: ElevenLabs for voices and sound, Suno for music, Tripo3D for 3D models, and any you add. For each: what it's for, its API key or that it's used in the browser, its projects and a budget." />
                </DockPanel>
                <TextBlock Style="{StaticResource MutedText}" Margin="2,4,0,0" TextWrapping="Wrap"
                           Text="Keys are protected for your Windows user and stay on this computer. An agent gets one only when you allow it: ProJict asks you each time, unless you let that agent have it always." />
            </StackPanel>
        </Expander>

        <Expander x:Name="NotificationsSection" Tag="Notifications" Style="{StaticResource Section}">
            <Expander.Header>
                <StackPanel>
                    <TextBlock Text="Notifications" Style="{StaticResource SectionName}" />
                    <TextBlock x:Name="NotificationsSummary" Style="{StaticResource Summary}" />
                </StackPanel>
            </Expander.Header>
            <StackPanel Style="{StaticResource Body}">
                <CheckBox x:Name="NotifyEnabled" Content="Show Windows notifications for what needs you" />
                <!-- One check box per kind; the Tag is the NotificationKind. -->
                <UniformGrid x:Name="NotifyKinds" Columns="2" Margin="0,8,0,0" IsEnabled="{Binding IsChecked, ElementName=NotifyEnabled}">
                    <UniformGrid.Resources>
                        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="Margin" Value="0,0,12,6" />
                        </Style>
                    </UniformGrid.Resources>
                    <CheckBox Content="Work to review" Tag="Review" ToolTip="An AI agent finished an item" />
                    <CheckBox Content="Comments in your discussions" Tag="Comment" ToolTip="New comments where you wrote, or on items you added" />
                    <CheckBox Content="Ship plans to approve" Tag="ShipPlan" />
                    <CheckBox Content="People asking to join" Tag="JoinRequest" ToolTip="Through sharing" />
                    <CheckBox Content="Agents checking out items" Tag="CheckOut" />
                    <CheckBox Content="Every new comment" Tag="AnyComment" ToolTip="Also in discussions you're not part of" />
                    <CheckBox Content="API tokens about to expire" Tag="TokenExpiring" />
                    <CheckBox Content="ProJict updates" Tag="Update" />
                    <CheckBox Content="Chat: you're @mentioned" Tag="ChatMention" ToolTip="In a channel you can see" />
                    <CheckBox Content="Chat: every message" Tag="ChatMessage" ToolTip="Every new message in your channels" />
                </UniformGrid>
                <TextBlock x:Name="MutedText" Style="{StaticResource MutedText}" Margin="2,2,0,0" TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource MutedText}" Margin="2,4,0,0" TextWrapping="Wrap"
                           Text="They show only while ProJict isn't in front, several at once as one, never for what you did yourself. Windows' Do not disturb silences them; a click opens ProJict at the thing. Mute a noisy project from its right-click menu." />
            </StackPanel>
        </Expander>

        <Expander x:Name="BoardSection" Tag="Board" Style="{StaticResource Section}">
            <Expander.Header>
                <StackPanel>
                    <TextBlock Text="Board &amp; prompts" Style="{StaticResource SectionName}" />
                    <TextBlock x:Name="BoardSummary" Style="{StaticResource Summary}" />
                </StackPanel>
            </Expander.Header>
            <StackPanel Style="{StaticResource Body}">
                <CheckBox x:Name="MarkInProgress" Content="Mark items as in progress when copied as a prompt" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Theme" VerticalAlignment="Center" />
                    <ComboBox x:Name="Theme" Grid.Column="1" Width="160" HorizontalAlignment="Left">
                        <ComboBoxItem Content="System" />
                        <ComboBoxItem Content="Light" />
                        <ComboBoxItem Content="Dark" />
                    </ComboBox>
                    <TextBlock Grid.Row="1" Text="Stale after (days)" VerticalAlignment="Center" Margin="0,8,0,0" />
                    <TextBox x:Name="StaleDays" Grid.Row="1" Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="0,8,0,0" />
                    <TextBlock Grid.Row="2" Text="Groups" VerticalAlignment="Center" Margin="0,8,0,0" />
                    <TextBox x:Name="Groups" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" ToolTip="Comma separated, in sidebar order. Personal and Work always stay." />
                    <TextBlock Grid.Row="3" Text="VS Code (Code.exe)" VerticalAlignment="Center" Margin="0,8,0,0" />
                    <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right" Content="Browse…" Margin="8,0,0,0" Click="BrowseCode_Click" />
                        <TextBox x:Name="VsCodePath" ToolTip="Leave empty to auto-detect" />
                    </DockPanel>
                </Grid>
            </StackPanel>
        </Expander>

        <Expander x:Name="CommentsSection" Tag="Comments" Style="{StaticResource Section}">
            <Expander.Header>
                <StackPanel>
                    <TextBlock Text="Comments &amp; history" Style="{StaticResource SectionName}" />
                    <TextBlock x:Name="CommentsSummary" Style="{StaticResource Summary}" />
                </StackPanel>
            </Expander.Header>
            <StackPanel Style="{StaticResource Body}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Your name" VerticalAlignment="Center" />
                    <TextBox x:Name="UserName" Grid.Column="1" Width="220" HorizontalAlignment="Left"
                             ToolTip="How you sign comments, notes and history entries. Empty uses your Windows user name." />
                    <TextBlock Grid.Row="1" Text="Files in comments" VerticalAlignment="Center" Margin="0,8,0,0" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="up to" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="CommentFileLimit" Width="70" AutomationProperties.Name="Largest file in a comment, MB"
                                 ToolTip="The largest file you, people you share with or AI agents may post in a discussion (up to 2048 MB)" />
                        <TextBlock Text="MB each" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Expander>

        <Expander x:Name="ChatSection" Tag="Chat" Style="{StaticResource Section}">
            <Expander.Header>
                <StackPanel>
                    <TextBlock Text="Chat" Style="{StaticResource SectionName}" />
                    <TextBlock x:Name="ChatSummary" Style="{StaticResource Summary}" />
                </StackPanel>
            </Expander.Header>
            <StackPanel Style="{StaticResource Body}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Files in Chat" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="up to" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="ChatFileLimit" Width="70" AutomationProperties.Name="Largest file in Chat, MB"
                                 ToolTip="The largest file you, people you share with or AI agents may post in Chat (up to 2048 MB)" />
                        <TextBlock Text="MB each" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="Private conversations" VerticalAlignment="Center" Margin="0,8,0,0" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="keep their files" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="PrivateFilesDays" Width="50" AutomationProperties.Name="Days to keep private conversations' files"
                                 ToolTip="After this many days, a file sent in a private conversation is deleted from this computer" />
                        <TextBlock Text="days (0 keeps them)" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>
                <DockPanel Margin="0,8,0,0">
                    <Button DockPanel.Dock="Right" Content="Open" Margin="8,0,0,0" Click="OpenPrivateFiles_Click" />
                    <Button DockPanel.Dock="Right" Content="Browse…" Margin="8,0,0,0" Click="BrowsePrivateFiles_Click" />
                    <TextBox x:Name="PrivateFilesFolder" AutomationProperties.Name="Folder for private conversations' files" />
                </DockPanel>
                <DockPanel Margin="0,6,0,0">
                    <Button x:Name="CleanOutPrivate" DockPanel.Dock="Right" Content="Clean out now" Margin="8,0,0,0" Click="CleanOutPrivate_Click" />
                    <TextBlock x:Name="PrivateFilesHolds" Style="{StaticResource MutedText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Style="{StaticResource MutedText}" Margin="2,6,0,0" TextWrapping="Wrap"
                           Text="Files sent in private conversations are kept in this folder on this computer, not in the data folder, so they aren't backed up or mirrored; once cleaned out, the conversation says so. Files in channels stay with your other files." />
            </StackPanel>
        </Expander>

        <Expander x:Name="CaptureSection" Tag="Capture" Style="{StaticResource Section}">
            <Expander.Header>
                <StackPanel>
                    <TextBlock Text="Quick capture &amp; window" Style="{StaticResource SectionName}" />
                    <TextBlock x:Name="CaptureSummary" Style="{StaticResource Summary}" />
                </StackPanel>
            </Expander.Header>
            <StackPanel Style="{StaticResource Body}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Global hotkey" VerticalAlignment="Center" />
                    <TextBox x:Name="Hotkey" Grid.Column="1" IsReadOnly="True" PreviewKeyDown="Hotkey_PreviewKeyDown"
                             ToolTip="Click here and press the key combination (e.g. Ctrl+Alt+J)" />
                    <Button Grid.Column="2" Content="Disable" Margin="8,0,0,0" Click="ClearHotkey_Click" />
                </Grid>
                <CheckBox x:Name="CloseToTray" Content="Closing the window keeps ProJict running in the tray" Margin="0,8,0,0" />
            </StackPanel>
        </Expander>

        <Expander x:Name="GitHubSection" Tag="GitHub" Style="{StaticResource Section}">
            <Expander.Header>
                <StackPanel>
                    <TextBlock Text="GitHub" Style="{StaticResource SectionName}" />
                    <TextBlock x:Name="GitHubSummary" Style="{StaticResource Summary}" />
                </StackPanel>
            </Expander.Header>
            <StackPanel Style="{StaticResource Body}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Account" VerticalAlignment="Center" />
                    <DockPanel Grid.Column="1">
                        <Button x:Name="CheckReleases" DockPanel.Dock="Right" Content="Check releases now" Margin="8,0,0,0" Click="CheckReleases_Click" />
                        <TextBox x:Name="GitHubAccount" ToolTip="Your GitHub user or organization. Its repositories are linked to projects with the same name; a project's own GitHub link (Details) always wins." />
                    </DockPanel>
                </Grid>
                <CheckBox x:Name="UseGitHubCli" Content="Use my GitHub CLI (gh) sign-in, so private repositories are included" Margin="0,8,0,0" />
                <TextBlock x:Name="ReleasesResult" Style="{StaticResource MutedText}" FontSize="13" TextWrapping="Wrap" Margin="2,6,0,0" />
            </StackPanel>
        </Expander>

        <Expander x:Name="DataSection" Tag="Data" Style="{StaticResource Section}">
            <Expander.Header>
                <StackPanel>
                    <TextBlock Text="Data" Style="{StaticResource SectionName}" />
                    <TextBlock x:Name="DataSummary" Style="{StaticResource Summary}" />
                </StackPanel>
            </Expander.Header>
            <StackPanel Style="{StaticResource Body}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Browse…" Margin="8,0,0,0" Click="BrowseData_Click" />
                    <TextBox x:Name="DataRoot" />
                </DockPanel>
                <TextBlock Style="{StaticResource MutedText}" Margin="2,4,0,0" TextWrapping="Wrap"
                           Text="One JSON file per project plus rolling backups. Changing this takes effect after restarting ProJict." />
            </StackPanel>
        </Expander>

        <Expander x:Name="MirrorSection" Tag="Mirror" Style="{StaticResource Section}">
            <Expander.Header>
                <StackPanel>
                    <TextBlock Text="TXT mirror" Style="{StaticResource SectionName}" />
                    <TextBlock x:Name="MirrorSummary" Style="{StaticResource Summary}" />
                </StackPanel>
            </Expander.Header>
            <StackPanel Style="{StaticResource Body}">
                <CheckBox x:Name="MirrorEnabled" Content="Keep TODO-/DONE- text files continuously up to date in this folder" />
                <DockPanel Margin="0,6,0,0">
                    <Button DockPanel.Dock="Right" Content="Browse…" Margin="8,0,0,0" Click="BrowseMirror_Click" />
                    <TextBox x:Name="MirrorFolder" />
                </DockPanel>
                <TextBlock Style="{StaticResource MutedText}" Margin="2,4,0,0" TextWrapping="Wrap"
                           Text="Handy for grep and AI agents that read plain text. Files ProJict did not write (e.g. your archived originals) are never overwritten by the mirror." />
            </StackPanel>
        </Expander>

        <Expander x:Name="UpdatesSection" Tag="Updates" Style="{StaticResource Section}">
            <Expander.Header>
                <StackPanel>
                    <TextBlock Text="Updates" Style="{StaticResource SectionName}" />
                    <TextBlock x:Name="UpdatesSummary" Style="{StaticResource Summary}" />
                </StackPanel>
            </Expander.Header>
            <StackPanel Style="{StaticResource Body}">
                <CheckBox x:Name="CheckUpdates" Content="Check for updates when ProJict starts, and every 4 hours while it's open" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="CheckNow" Content="Check now" MinWidth="100" Click="CheckNow_Click" />
                    <TextBlock x:Name="UpdateResult" Style="{StaticResource MutedText}" FontSize="13" Margin="12,0,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <!-- DataContext is the update service; shown while a newer version is available. -->
                <Border x:Name="UpdatePanel" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="12,10"
                        Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" Margin="0,0,10,0" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ProgressBar Width="120" Height="4" Margin="0,0,12,0" Value="{Binding Progress, Mode=OneWay}" Maximum="100"
                                         Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource SubtleButton}" Content="What's new" Command="{Binding ShowNotesCommand}" />
                            <Button Style="{StaticResource AccentButtonStyle}" Content="Install update" Command="{Binding InstallCommand}" Margin="6,0,0,0"
                                    IsEnabled="{Binding IsDownloading, Converter={StaticResource InvBool}}"
                                    ToolTip="Downloads the installer, closes ProJict, updates it and starts it again" />
                        </StackPanel>
                        <TextBlock Text="{Binding BannerText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                </Border>
                <TextBlock x:Name="VersionText" Style="{StaticResource MutedText}" Margin="2,8,0,0" />
            </StackPanel>
        </Expander>

        <TextBlock x:Name="NothingFound" Style="{StaticResource MutedText}" Margin="2,8,0,0" Visibility="Collapsed" TextWrapping="Wrap" />
        </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
