<Window x:Class="ProJict.App.Views.ReservationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reservation" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!-- A reservation of a shared machine, new or to edit (#d27b8c7b), like a meeting in Teams or Outlook. -->
    <StackPanel Margin="22,18,22,18">
        <TextBlock x:Name="Heading" Text="New reservation" FontSize="20" FontWeight="SemiBold" />

        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="110" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Machine" VerticalAlignment="Center" />
            <ComboBox x:Name="MachineBox" Grid.Column="1" Grid.ColumnSpan="2" IsEditable="True" AutomationProperties.Name="Machine" />

            <TextBlock Grid.Row="1" Text="Starts" VerticalAlignment="Center" Margin="0,10,0,0" />
            <DatePicker x:Name="StartDate" Grid.Row="1" Grid.Column="1" Margin="0,10,8,0" AutomationProperties.Name="Start date"
                        SelectedDateChanged="StartDate_SelectedDateChanged" />
            <ComboBox x:Name="StartTime" Grid.Row="1" Grid.Column="2" Margin="0,10,0,0" IsEditable="True" AutomationProperties.Name="Start time" />

            <TextBlock Grid.Row="2" Text="Ends" VerticalAlignment="Center" Margin="0,10,0,0" />
            <DatePicker x:Name="EndDate" Grid.Row="2" Grid.Column="1" Margin="0,10,8,0" AutomationProperties.Name="End date" />
            <ComboBox x:Name="EndTime" Grid.Row="2" Grid.Column="2" Margin="0,10,0,0" IsEditable="True" AutomationProperties.Name="End time" />

            <WrapPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,10,0,0">
                <CheckBox x:Name="AllDay" Content="All day" Margin="0,0,20,0" Click="AllDay_Click" />
                <CheckBox x:Name="UntilFreed" Content="Until I free it" Click="UntilFreed_Click" Visibility="Collapsed" />
            </WrapPanel>

            <TextBlock Grid.Row="4" Text="For" VerticalAlignment="Center" Margin="0,10,0,0" />
            <TextBox x:Name="Purpose" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,10,0,0" MaxLength="120"
                     AutomationProperties.Name="What it's for" ToolTip="What you'll use it for (agents see it); you can leave it empty" />
        </Grid>

        <TextBlock x:Name="Hint" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="80,10,0,0"
                   Text="It's yours then: an agent on it is told to stop, and agents' claims before it end when it begins." />
        <TextBlock x:Name="Problem" TextWrapping="Wrap" Margin="80,8,0,0" Visibility="Collapsed"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" />

        <DockPanel Margin="0,20,0,0" LastChildFill="False">
            <Button x:Name="RemoveButton" DockPanel.Dock="Left" Content="Cancel this booking" Padding="14,6" Click="Remove_Click" Visibility="Collapsed" />
            <Button DockPanel.Dock="Right" Content="Close" Padding="16,6" Margin="8,0,0,0" IsCancel="True" />
            <Button x:Name="SaveButton" DockPanel.Dock="Right" Content="Save" Padding="20,6" Style="{StaticResource AccentButtonStyle}"
                    IsDefault="True" Click="Save_Click" />
        </DockPanel>
    </StackPanel>
</Window>
