<UserControl x:Class="ProJict.App.Views.OfficeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ProJict.App.ViewModels">
    <!--
        The office in one-point perspective (800 × 520 room units, scaled to fit): ceiling, back wall with a window whose
        sky follows the time of day, side walls with four desks each, a wooden floor, a plant and a water cooler. Desks
        show their agent's work on the monitor; agents are robots drawn around their seat (sitting) or hips (standing),
        mirrored on the right wall, posed and animated by what they do. Desks and agents share one layer, back to front.
    -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="Wood" Color="#C49A6C" />
        <SolidColorBrush x:Key="WoodDark" Color="#8E6A45" />
        <SolidColorBrush x:Key="Metal" Color="#4B5563" />
        <SolidColorBrush x:Key="Ink" Color="#1F2937" />

        <!--
            A desk against the wall (drawn for the left wall; mirrored on the right), its monitor and its chair. Clicks go
            through it, to a robot behind it or the room.
        -->
        <DataTemplate DataType="{x:Type vm:OfficeDeskViewModel}">
            <Canvas IsHitTestVisible="False">
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="{Binding ScaleX}" ScaleY="{Binding Scale}" />
                        <TranslateTransform X="{Binding X}" Y="{Binding Y}" />
                    </TransformGroup>
                </Canvas.RenderTransform>
                <!-- Chair -->
                <Rectangle Canvas.Left="76" Canvas.Top="-10" Width="28" Height="4" RadiusX="2" RadiusY="2" Fill="{StaticResource Metal}" />
                <Rectangle Canvas.Left="87" Canvas.Top="-34" Width="4" Height="25" Fill="{StaticResource Metal}" />
                <Rectangle Canvas.Left="100" Canvas.Top="-74" Width="8" Height="42" RadiusX="3" RadiusY="3" Fill="#374151" />
                <Rectangle Canvas.Left="70" Canvas.Top="-40" Width="38" Height="7" RadiusX="3" RadiusY="3" Fill="#374151" />
                <!-- Desk -->
                <Rectangle Canvas.Left="4" Canvas.Top="-56" Width="5" Height="56" Fill="{StaticResource WoodDark}" />
                <Rectangle Canvas.Left="58" Canvas.Top="-56" Width="5" Height="56" Fill="{StaticResource WoodDark}" />
                <Rectangle Canvas.Left="6" Canvas.Top="-54" Width="54" Height="22" Fill="{StaticResource WoodDark}" Opacity="0.55" />
                <Rectangle Canvas.Left="0" Canvas.Top="-62" Width="68" Height="8" RadiusX="2" RadiusY="2" Fill="{StaticResource Wood}" />
                <!-- Monitor -->
                <Rectangle Canvas.Left="24" Canvas.Top="-72" Width="6" Height="11" Fill="{StaticResource Metal}" />
                <Rectangle Canvas.Left="16" Canvas.Top="-64" Width="22" Height="3" RadiusX="1" RadiusY="1" Fill="{StaticResource Metal}" />
                <Rectangle Canvas.Left="6" Canvas.Top="-106" Width="44" Height="35" RadiusX="3" RadiusY="3" Fill="#111827" />
                <Grid x:Name="Screen" Canvas.Left="9" Canvas.Top="-103" Width="38" Height="28" ClipToBounds="True" Background="#0B0F19">
                    <!-- Building: code scrolling by -->
                    <Canvas x:Name="Code" Visibility="Collapsed">
                        <Canvas.RenderTransform>
                            <TranslateTransform x:Name="CodeScroll" />
                        </Canvas.RenderTransform>
                        <Rectangle Canvas.Left="3" Canvas.Top="3" Width="18" Height="2" Fill="#4ADE80" />
                        <Rectangle Canvas.Left="6" Canvas.Top="8" Width="24" Height="2" Fill="#60A5FA" />
                        <Rectangle Canvas.Left="6" Canvas.Top="13" Width="14" Height="2" Fill="#F472B6" />
                        <Rectangle Canvas.Left="3" Canvas.Top="18" Width="20" Height="2" Fill="#4ADE80" />
                        <Rectangle Canvas.Left="6" Canvas.Top="23" Width="26" Height="2" Fill="#FBBF24" />
                        <Rectangle Canvas.Left="3" Canvas.Top="28" Width="18" Height="2" Fill="#4ADE80" />
                        <Rectangle Canvas.Left="6" Canvas.Top="33" Width="24" Height="2" Fill="#60A5FA" />
                        <Rectangle Canvas.Left="6" Canvas.Top="38" Width="14" Height="2" Fill="#F472B6" />
                        <Rectangle Canvas.Left="3" Canvas.Top="43" Width="20" Height="2" Fill="#4ADE80" />
                        <Rectangle Canvas.Left="6" Canvas.Top="48" Width="26" Height="2" Fill="#FBBF24" />
                    </Canvas>
                    <!-- Managing: a list -->
                    <StackPanel x:Name="List" Visibility="Collapsed" Background="#F3F4F6">
                        <Rectangle Height="4" Margin="3,3,3,0" Fill="#A78BFA" />
                        <Rectangle Height="3" Margin="3,3,10,0" Fill="#9CA3AF" />
                        <Rectangle Height="3" Margin="3,3,6,0" Fill="#9CA3AF" />
                        <Rectangle Height="3" Margin="3,3,14,0" Fill="#9CA3AF" />
                        <Rectangle Height="3" Margin="3,3,8,0" Fill="#9CA3AF" />
                    </StackPanel>
                    <!-- Reading: a page -->
                    <StackPanel x:Name="Page" Visibility="Collapsed" Background="White">
                        <Rectangle Height="3" Margin="4,4,12,0" Fill="#374151" />
                        <Rectangle Height="2" Margin="4,3,4,0" Fill="#9CA3AF" />
                        <Rectangle Height="2" Margin="4,2,6,0" Fill="#9CA3AF" />
                        <Rectangle Height="2" Margin="4,2,4,0" Fill="#9CA3AF" />
                        <Rectangle Height="2" Margin="4,2,10,0" Fill="#9CA3AF" />
                    </StackPanel>
                    <!-- Away at the cooler: a screen saver -->
                    <Ellipse x:Name="Saver" Width="5" Height="5" Fill="#60A5FA" Opacity="0.7" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed">
                        <Ellipse.RenderTransform>
                            <TranslateTransform x:Name="SaverMove" X="4" Y="4" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Grid>
            </Canvas>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Screen}" Value="Building">
                    <Setter TargetName="Code" Property="Visibility" Value="Visible" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="Scroll">
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetName="CodeScroll" Storyboard.TargetProperty="Y" From="0" To="-25" Duration="0:0:2.5" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="Scroll" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding Screen}" Value="Managing">
                    <Setter TargetName="List" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Screen}" Value="Reading">
                    <Setter TargetName="Page" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Screen}" Value="Away">
                    <Setter TargetName="Saver" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Screen" Property="Background" Value="#111A2E" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="Drift">
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetName="SaverMove" Storyboard.TargetProperty="X" From="2" To="30" Duration="0:0:3.1" AutoReverse="True" />
                                <DoubleAnimation Storyboard.TargetName="SaverMove" Storyboard.TargetProperty="Y" From="2" To="20" Duration="0:0:2.3" AutoReverse="True" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="Drift" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--
            An agent: a robot drawn facing the left wall around (0,0), its seat when sitting or its hips when standing
            (legs below). The code-behind places, scales and mirrors it (Mover, BodyScale) and walks it from place to
            place; its name and speech bubble stay full size and unmirrored (LabelScale), as do its initials and Zzz.
        -->
        <DataTemplate DataType="{x:Type vm:OfficeAgentViewModel}">
            <Canvas x:Name="Root" Background="Transparent" Cursor="Hand" ToolTip="{Binding ToolTip}" Loaded="Agent_Loaded" Unloaded="Agent_Unloaded">
                <Canvas.RenderTransform>
                    <TranslateTransform x:Name="Mover" />
                </Canvas.RenderTransform>
                <Canvas.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding ShowCardCommand}" />
                </Canvas.InputBindings>
                <Canvas.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Show its card" Command="{Binding ShowCardCommand}" />
                        <MenuItem Header="Private message" Command="{Binding Card.PrivateMessageCommand}" />
                    </ContextMenu>
                </Canvas.ContextMenu>
                <Canvas>
                    <Canvas.RenderTransform>
                        <ScaleTransform x:Name="BodyScale" />
                    </Canvas.RenderTransform>
                    <!-- Hit area -->
                    <Rectangle Canvas.Left="-22" Canvas.Top="-80" Width="44" Height="104" Fill="Transparent" />
                    <!-- Legs, while standing or walking -->
                    <Canvas x:Name="Legs" Visibility="Collapsed">
                        <Canvas>
                            <Canvas.RenderTransform>
                                <TranslateTransform x:Name="LegBack" />
                            </Canvas.RenderTransform>
                            <Rectangle Canvas.Left="3" Canvas.Top="-2" Width="8" Height="24" RadiusX="3" RadiusY="3" Fill="{StaticResource Metal}" />
                            <Rectangle Canvas.Left="2" Canvas.Top="19" Width="12" Height="5" RadiusX="2" RadiusY="2" Fill="{StaticResource Ink}" />
                        </Canvas>
                        <Canvas>
                            <Canvas.RenderTransform>
                                <TranslateTransform x:Name="LegFront" />
                            </Canvas.RenderTransform>
                            <Rectangle Canvas.Left="-11" Canvas.Top="-2" Width="8" Height="24" RadiusX="3" RadiusY="3" Fill="{StaticResource Metal}" />
                            <Rectangle Canvas.Left="-14" Canvas.Top="19" Width="12" Height="5" RadiusX="2" RadiusY="2" Fill="{StaticResource Ink}" />
                        </Canvas>
                    </Canvas>
                    <!-- Body with its initials -->
                    <Rectangle Canvas.Left="-15" Canvas.Top="-32" Width="30" Height="32" RadiusX="8" RadiusY="8" Fill="{Binding Badge.Background}" />
                    <Rectangle Canvas.Left="-15" Canvas.Top="-32" Width="30" Height="32" RadiusX="8" RadiusY="8" Fill="Black" Opacity="0.12" />
                    <TextBlock Canvas.Left="-15" Canvas.Top="-25" Width="30" TextAlignment="Center" Text="{Binding Badge.Initials}" FontSize="10" FontWeight="Bold"
                               Foreground="White" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <ScaleTransform x:Name="InitialsFlip" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <!-- Arm reaching to the desk (typing), or holding a clipboard -->
                    <Rectangle x:Name="Arm" Canvas.Left="-31" Canvas.Top="-23" Width="22" Height="6" RadiusX="3" RadiusY="3" Fill="{Binding Badge.Background}">
                        <Rectangle.RenderTransform>
                            <TranslateTransform x:Name="ArmMove" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <Canvas x:Name="Clipboard" Visibility="Collapsed">
                        <Rectangle Canvas.Left="-36" Canvas.Top="-38" Width="13" Height="17" RadiusX="1" RadiusY="1" Fill="#F5E6C8" Stroke="#8E6A45" StrokeThickness="1" />
                        <Rectangle Canvas.Left="-34" Canvas.Top="-33" Width="9" Height="1.5" Fill="#6B7280" />
                        <Rectangle Canvas.Left="-34" Canvas.Top="-29" Width="7" Height="1.5" Fill="#6B7280" />
                        <Rectangle Canvas.Left="-34" Canvas.Top="-25" Width="8" Height="1.5" Fill="#6B7280" />
                        <Rectangle Canvas.Left="-26" Canvas.Top="-25" Width="12" Height="5" RadiusX="2.5" RadiusY="2.5" Fill="{Binding Badge.Background}" />
                    </Canvas>
                    <!-- Head -->
                    <Canvas x:Name="Head">
                        <Line X1="0" Y1="-64" X2="0" Y2="-72" Stroke="{Binding Badge.Background}" StrokeThickness="2" />
                        <Ellipse x:Name="Antenna" Canvas.Left="-3.5" Canvas.Top="-77" Width="7" Height="7" Fill="#FBBF24" />
                        <Rectangle Canvas.Left="-18" Canvas.Top="-65" Width="36" Height="30" RadiusX="9" RadiusY="9" Fill="{Binding Badge.Background}" />
                        <Rectangle Canvas.Left="-15" Canvas.Top="-60" Width="27" Height="19" RadiusX="6" RadiusY="6" Fill="#E8F1FF" />
                        <Canvas x:Name="Eyes">
                            <Canvas.RenderTransform>
                                <ScaleTransform x:Name="Blink" CenterY="-50" />
                            </Canvas.RenderTransform>
                            <Ellipse Canvas.Left="-11" Canvas.Top="-54" Width="5" Height="7" Fill="{StaticResource Ink}" />
                            <Ellipse Canvas.Left="-1" Canvas.Top="-54" Width="5" Height="7" Fill="{StaticResource Ink}" />
                        </Canvas>
                        <Canvas x:Name="Shut" Visibility="Collapsed">
                            <Rectangle Canvas.Left="-12" Canvas.Top="-50" Width="7" Height="1.6" Fill="{StaticResource Ink}" />
                            <Rectangle Canvas.Left="-2" Canvas.Top="-50" Width="7" Height="1.6" Fill="{StaticResource Ink}" />
                        </Canvas>
                        <Rectangle x:Name="Mouth" Canvas.Left="-6" Canvas.Top="-45" Width="9" Height="1.6" Fill="{StaticResource Ink}">
                            <Rectangle.RenderTransform>
                                <ScaleTransform x:Name="Talk" CenterY="0.8" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Canvas>
                    <!-- Sleeping -->
                    <TextBlock x:Name="Zzz" Canvas.Left="6" Canvas.Top="-90" Text="z z Z" FontSize="12" FontWeight="Bold" Foreground="#60A5FA" Visibility="Collapsed"
                               RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="ZzzFlip" />
                                <TranslateTransform x:Name="ZzzRise" />
                            </TransformGroup>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <!-- Its name and what it says, at full size above its head -->
                    <Canvas Canvas.Top="-80">
                        <Canvas.RenderTransform>
                            <ScaleTransform x:Name="LabelScale" />
                        </Canvas.RenderTransform>
                        <Grid Canvas.Left="-100" Canvas.Top="-90" Width="200" Height="90">
                            <StackPanel VerticalAlignment="Bottom">
                                <Border x:Name="Bubble" HorizontalAlignment="Center" MaxWidth="150" Padding="8,3,8,4" CornerRadius="9" Background="White" BorderBrush="#CBD5E1"
                                        BorderThickness="1" Margin="0,0,0,3" Visibility="Collapsed">
                                    <TextBlock Text="{Binding Bubble}" FontSize="14" Foreground="{StaticResource Ink}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="38" />
                                </Border>
                                <Border HorizontalAlignment="Center" MaxWidth="160" Padding="6,1,6,2" CornerRadius="7" Background="#A6000000">
                                    <TextBlock Text="{Binding Name}" FontSize="14" Foreground="White" TextTrimming="CharacterEllipsis" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Canvas>
                </Canvas>
            </Canvas>
            <DataTemplate.Triggers>
                <!-- Eyes blink now and then. -->
                <EventTrigger SourceName="Root" RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever" Duration="0:0:4.3">
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Blink" Storyboard.TargetProperty="ScaleY">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:3.9" Value="0.15" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:4.05" Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <DataTrigger Binding="{Binding Standing}" Value="True">
                    <Setter TargetName="Legs" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Arm" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Activity}" Value="Building">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="Type">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ArmMove" Storyboard.TargetProperty="Y" From="0" To="-2.5" Duration="0:0:0.14" AutoReverse="True" RepeatBehavior="Forever" />
                                <DoubleAnimation Storyboard.TargetName="Antenna" Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.6" AutoReverse="True" RepeatBehavior="Forever" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="Type" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding Activity}" Value="Managing">
                    <Setter TargetName="Clipboard" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Arm" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Antenna" Property="Fill" Value="#A78BFA" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Activity}" Value="Reading">
                    <Setter TargetName="Head" Property="RenderTransform">
                        <Setter.Value>
                            <RotateTransform Angle="-7" CenterY="-36" />
                        </Setter.Value>
                    </Setter>
                    <Setter TargetName="Antenna" Property="Fill" Value="#60A5FA" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Activity}" Value="Talking">
                    <Setter TargetName="Bubble" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Antenna" Property="Fill" Value="#34D399" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="Chatter">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Talk" Storyboard.TargetProperty="ScaleY" From="1" To="2.6" Duration="0:0:0.18" AutoReverse="True" RepeatBehavior="Forever" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="Chatter" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding Activity}" Value="Resting">
                    <Setter TargetName="Eyes" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Shut" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Zzz" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Head" Property="RenderTransform">
                        <Setter.Value>
                            <TransformGroup>
                                <RotateTransform Angle="-14" CenterY="-36" />
                                <TranslateTransform Y="4" />
                            </TransformGroup>
                        </Setter.Value>
                    </Setter>
                    <Setter TargetName="Arm" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Antenna" Property="Fill" Value="#6B7280" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="Sleep">
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetName="ZzzRise" Storyboard.TargetProperty="Y" From="4" To="-14" Duration="0:0:2" />
                                <DoubleAnimation Storyboard.TargetName="Zzz" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:2" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="Sleep" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
                <!-- On its way: legs step, nothing in its hands, no bubble or Zzz. -->
                <DataTrigger Binding="{Binding Walking}" Value="True">
                    <Setter TargetName="Legs" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Arm" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Clipboard" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Bubble" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Zzz" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Eyes" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Shut" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Head" Property="RenderTransform" Value="{x:Static Transform.Identity}" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="Step">
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetName="LegFront" Storyboard.TargetProperty="Y" From="0" To="-4" Duration="0:0:0.16" AutoReverse="True" />
                                <DoubleAnimation Storyboard.TargetName="LegBack" Storyboard.TargetProperty="Y" From="-4" To="0" Duration="0:0:0.16" AutoReverse="True" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="Step" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="4,6,4,0">
            <!-- Zoomed in: how far, and back to the whole room. -->
            <Button x:Name="FitButton" DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Padding="6,1" Margin="12,0,0,0" Visibility="Collapsed"
                    Click="Fit_Click" ToolTip="Show the whole room again (or double-click the room)" AutomationProperties.Name="Show the whole room">
                <TextBlock x:Name="FitText" FontSize="12" />
            </Button>
            <TextBlock DockPanel.Dock="Right" Text="{Binding MoreText}" Style="{StaticResource MutedText}" FontSize="12" Margin="12,0,0,0"
                       Visibility="{Binding MoreText, Converter={StaticResource EmptyToVis}}" />
            <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" FontSize="12" TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <!--
            As big as the room it's given allows, both ways. The wheel zooms in on the room where it points, dragging it
            (or the middle button anywhere) pans, and a double-click shows the whole room again.
        -->
        <Viewbox Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Canvas x:Name="Room" Width="800" Height="520" ClipToBounds="True" Background="Transparent"
                    MouseWheel="Room_MouseWheel" MouseDown="Room_MouseDown" MouseMove="Room_MouseMove" MouseUp="Room_MouseUp" LostMouseCapture="Room_LostMouseCapture">
                <Canvas x:Name="World" Width="800" Height="520">
                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ZoomScale" />
                            <TranslateTransform x:Name="PanMove" />
                        </TransformGroup>
                    </Canvas.RenderTransform>
                    <!-- Ceiling, walls, floor -->
                    <Polygon Points="0,0 800,0 580,70 220,70" Fill="{DynamicResource SolidBackgroundFillColorTertiaryBrush}" />
                    <Polygon Points="0,0 220,70 220,300 0,520" Fill="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" />
                    <Polygon Points="0,0 220,70 220,300 0,520" Fill="#8E6A45" Opacity="0.08" />
                    <Polygon Points="800,0 580,70 580,300 800,520" Fill="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" />
                    <Polygon Points="800,0 580,70 580,300 800,520" Fill="#8E6A45" Opacity="0.08" />
                    <Rectangle Canvas.Left="220" Canvas.Top="70" Width="360" Height="230" Fill="{DynamicResource SolidBackgroundFillColorBaseBrush}" />
                    <Rectangle Canvas.Left="220" Canvas.Top="70" Width="360" Height="230" Fill="#8E6A45" Opacity="0.05" />
                    <Polygon Points="0,520 800,520 580,300 220,300" Fill="{DynamicResource SolidBackgroundFillColorBaseBrush}" />
                    <Polygon Points="0,520 800,520 580,300 220,300" Fill="#C49A6C" Opacity="0.42" />
                    <!-- Floor boards running to the back -->
                    <Path Stroke="#8E6A45" StrokeThickness="1" Opacity="0.25"
                          Data="M 400,300 L 400,520 M 310,300 L 200,520 M 490,300 L 600,520 M 265,300 L 100,520 M 535,300 L 700,520" />
                    <!-- A rug in the middle -->
                    <Ellipse Canvas.Left="300" Canvas.Top="380" Width="200" Height="70" Fill="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0.13" />
                    <!-- Edges -->
                    <Path Stroke="{DynamicResource DividerStrokeColorDefaultBrush}" StrokeThickness="1.5"
                          Data="M 0,0 L 220,70 L 580,70 L 800,0 M 220,70 L 220,300 L 580,300 L 580,70 M 220,300 L 0,520 M 580,300 L 800,520" />
                    <!-- Ceiling light -->
                    <Polygon Points="330,28 470,28 455,40 345,40" Fill="#FFF7D6" Opacity="0.75" />
                    <!-- Window, its sky by the time of day -->
                    <Rectangle Canvas.Left="326" Canvas.Top="102" Width="148" Height="106" Fill="#E5E7EB" />
                    <Rectangle Canvas.Left="332" Canvas.Top="108" Width="136" Height="94" Fill="{Binding Sky}" />
                    <Ellipse Canvas.Left="430" Canvas.Top="120" Width="18" Height="18" Fill="#FDE68A" Visibility="{Binding IsDay, Converter={StaticResource BoolToVis}}" />
                    <Canvas Visibility="{Binding IsNight, Converter={StaticResource BoolToVis}}">
                        <Ellipse Canvas.Left="436" Canvas.Top="118" Width="14" Height="14" Fill="#F1F5F9" />
                        <Ellipse Canvas.Left="441" Canvas.Top="116" Width="13" Height="13" Fill="#22386A" />
                        <Ellipse Canvas.Left="350" Canvas.Top="120" Width="2" Height="2" Fill="White" />
                        <Ellipse Canvas.Left="372" Canvas.Top="140" Width="2" Height="2" Fill="White" />
                        <Ellipse Canvas.Left="385" Canvas.Top="116" Width="2" Height="2" Fill="White" />
                        <Ellipse Canvas.Left="420" Canvas.Top="170" Width="2" Height="2" Fill="White" />
                        <Ellipse Canvas.Left="360" Canvas.Top="178" Width="2" Height="2" Fill="White" />
                    </Canvas>
                    <Rectangle Canvas.Left="398" Canvas.Top="108" Width="4" Height="94" Fill="#E5E7EB" />
                    <Rectangle Canvas.Left="332" Canvas.Top="153" Width="136" Height="4" Fill="#E5E7EB" />
