<UserControl x:Class="ProJict.App.Views.InlinePlayer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <!--
        Audio or video played in place: for a video its picture (a frame from it until it plays), then play/pause, the
        file's name over a seek bar, the time, volume and a button to open it in its own app. Nothing loads until Play.
    -->
    <Border x:Name="Frame" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1" CornerRadius="6" Padding="6,5" Width="300">
        <!-- Docked from the bottom up, so in a viewer that fills its space (Fill) the screen takes what the controls leave. -->
        <DockPanel>
            <TextBlock x:Name="ProblemText" DockPanel.Dock="Bottom" Visibility="Collapsed" FontSize="11" TextWrapping="Wrap" Margin="2,4,2,0"
                       Foreground="{DynamicResource SystemFillColorCautionBrush}" />
            <DockPanel x:Name="Controls" DockPanel.Dock="Bottom">
                <Button x:Name="PlayButton" DockPanel.Dock="Left" Style="{StaticResource SubtleIconButton}" Content="&#xE768;" FontSize="14" Padding="7,5"
                        VerticalAlignment="Center" Click="PlayButton_Click" ToolTip="Play" AutomationProperties.Name="Play" />
                <Button x:Name="OpenButton" DockPanel.Dock="Right" Style="{StaticResource SubtleIconButton}" Content="&#xE8A7;" FontSize="12" Padding="6,5"
                        VerticalAlignment="Center" Click="OpenButton_Click" ToolTip="Open it in its own app" AutomationProperties.Name="Open in its app" />
                <Button x:Name="MuteButton" DockPanel.Dock="Right" Style="{StaticResource SubtleIconButton}" Content="&#xE767;" FontSize="12" Padding="6,5"
                        VerticalAlignment="Center" Click="MuteButton_Click" ToolTip="Mute" AutomationProperties.Name="Mute" />
                <Slider x:Name="VolumeSlider" DockPanel.Dock="Right" Width="56" MinWidth="0" Minimum="0" Maximum="1" VerticalAlignment="Center" Margin="4,0,0,0"
                        IsMoveToPointEnabled="True" ValueChanged="VolumeSlider_ValueChanged" ToolTip="Volume" AutomationProperties.Name="Volume" Focusable="False" />
                <StackPanel VerticalAlignment="Center" Margin="4,0,0,0">
                    <DockPanel Margin="2,0,0,0">
                        <TextBlock x:Name="TimeText" DockPanel.Dock="Right" Text="" FontSize="11" Margin="6,1,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="NameText" FontSize="12" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <Slider x:Name="SeekSlider" MinWidth="0" Minimum="0" Maximum="1" IsMoveToPointEnabled="True" Margin="0,-2,0,-4" IsEnabled="False"
                            ValueChanged="SeekSlider_ValueChanged" AutomationProperties.Name="Position" Focusable="False" />
                </StackPanel>
            </DockPanel>
            <Grid x:Name="Screen" Background="Black" Margin="-2,-1,-2,6" MinHeight="120" MaxHeight="260" Cursor="Hand" ClipToBounds="True"
                  MouseLeftButtonUp="Screen_MouseLeftButtonUp" ToolTip="Play or pause">
                <Image x:Name="PosterImage" Stretch="Uniform" />
                <MediaElement x:Name="Media" LoadedBehavior="Manual" UnloadedBehavior="Close" Stretch="Uniform" ScrubbingEnabled="True"
                              MediaOpened="Media_MediaOpened" MediaEnded="Media_MediaEnded" MediaFailed="Media_MediaFailed" />
                <Border x:Name="BigPlay" Width="46" Height="46" CornerRadius="23" Background="#A0000000" HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsHitTestVisible="False">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="3,0,0,0" />
                </Border>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
