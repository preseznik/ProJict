<UserControl x:Class="ProJict.App.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ProJict.App.ViewModels"
             xmlns:local="clr-namespace:ProJict.App.Views">
    <UserControl.Resources>
        <ItemsPanelTemplate x:Key="Wrap">
            <WrapPanel />
        </ItemsPanelTemplate>

        <!-- A channel in the list: bold with a count while messages wait for you, red when one mentions you. -->
        <!-- A private conversation between two agents: read it; right-click to suspend, resume or delete it, or write to either. -->
        <DataTemplate x:Key="AgentChatRow" DataType="{x:Type vm:AgentChatRow}">
            <Border x:Name="Row" Padding="8,5" Margin="0,0,0,1" CornerRadius="4" Background="Transparent" Cursor="Hand" ToolTip="{Binding ToolTip}"
                    AutomationProperties.Name="{Binding Name}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding OpenCommand}" />
                </Border.InputBindings>
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Open" Command="{Binding OpenCommand}" />
                        <MenuItem Header="Suspend: they can't write to each other" Command="{Binding SuspendCommand}"
                                  Visibility="{Binding IsSuspended, Converter={StaticResource InvBoolToVis}}" />
                        <MenuItem Header="Resume: they can write to each other again" Command="{Binding ResumeCommand}"
                                  Visibility="{Binding IsSuspended, Converter={StaticResource BoolToVis}}" />
                        <MenuItem Header="Delete conversation…" Command="{Binding DeleteCommand}" />
                        <Separator />
                        <MenuItem Command="{Binding WriteToFirstCommand}">
                            <MenuItem.Header>
                                <TextBlock><Run Text="Private message " /><Run Text="{Binding First, Mode=OneWay}" /></TextBlock>
                            </MenuItem.Header>
                        </MenuItem>
                        <MenuItem Command="{Binding WriteToSecondCommand}">
                            <MenuItem.Header>
                                <TextBlock><Run Text="Private message " /><Run Text="{Binding Second, Mode=OneWay}" /></TextBlock>
                            </MenuItem.Header>
                        </MenuItem>
                    </ContextMenu>
                </Border.ContextMenu>
                <DockPanel>
                    <TextBlock x:Name="Paused" DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="&#xE769;" FontSize="11" Margin="6,2,0,0" VerticalAlignment="Top"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}" ToolTip="Suspended" Visibility="Collapsed" />
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}" FontSize="11" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSuspended}" Value="True">
                    <Setter TargetName="Paused" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="ChannelRow" DataType="{x:Type vm:ChannelRowViewModel}">
            <Border x:Name="Row" Padding="8,3" Margin="0,0,0,1" CornerRadius="4" Background="Transparent" Cursor="Hand"
                    ToolTip="{Binding ToolTip}" AutomationProperties.Name="{Binding Name}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}" />
                </Border.InputBindings>
                <!-- Mark unread, to come back to; your private conversations go in the archive, and come out, from here. -->
                <Border.ContextMenu>
                    <ContextMenu Visibility="{Binding HasMenu, Converter={StaticResource BoolToVis}}">
                        <MenuItem Header="Mark unread" Command="{Binding MarkUnreadCommand}" Visibility="{Binding CanMarkUnread, Converter={StaticResource BoolToVis}}"
                                  ToolTip="Its newest message counts as new again, until you come back to it" />
                        <MenuItem Header="Archive" Command="{Binding ArchiveCommand}" Visibility="{Binding ShowArchive, Converter={StaticResource BoolToVis}}"
                                  ToolTip="Moves it to the Archive at the bottom: nothing new in it counts or notifies you until you open it or take it out" />
                        <MenuItem Header="Take out of the archive" Command="{Binding UnarchiveCommand}" Visibility="{Binding IsArchived, Converter={StaticResource BoolToVis}}" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Image x:Name="ChannelIcon" Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}" />
                            <TextBlock x:Name="Name" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <!-- From another ProJict: whose -->
                            <TextBlock x:Name="SourceTag" Text="{Binding SourceTag}" FontSize="11" Margin="6,1,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" Visibility="{Binding Source, Converter={StaticResource EmptyToVis}}" />
                            <TextBlock x:Name="Lock" Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="10" Margin="6,2,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       ToolTip="Invite only" Visibility="{Binding IsInviteOnly, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}" FontSize="11" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding ShowSubtitle, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <Border x:Name="Count" Grid.Column="1" CornerRadius="8" Padding="6,0" MinWidth="18" VerticalAlignment="Center" Margin="6,0,0,0"
                            Background="{DynamicResource SubtleFillColorTertiaryBrush}" Visibility="{Binding HasUnread, Converter={StaticResource BoolToVis}}">
                        <TextBlock x:Name="CountText" Text="{Binding Unread}" FontSize="11" HorizontalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding HasUnread}" Value="True">
                    <Setter TargetName="Name" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasMention}" Value="True">
                    <Setter TargetName="Count" Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                    <Setter TargetName="CountText" Property="Foreground" Value="White" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDirect}" Value="True">
                    <Setter TargetName="Lock" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A sidebar section: its heading folds the channels under it away (the open one and those with something new stay). -->
        <DataTemplate x:Key="ChatSectionView" DataType="{x:Type vm:ChatSection}">
            <StackPanel x:Name="Section">
                <Button x:Name="Heading" Style="{StaticResource SubtleButton}" Command="{Binding ToggleCommand}" HorizontalAlignment="Stretch" Padding="0,4" Margin="-4,10,0,2"
                        ToolTip="{Binding ToolTip}" AutomationProperties.Name="{Binding Title}">
                    <DockPanel HorizontalAlignment="Stretch" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Button}}">
                        <TextBlock x:Name="Chevron" DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="8" Width="12" TextAlignment="Center" Margin="0,2,0,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE72D;" FontSize="11" Margin="0,1,6,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Visibility="{Binding IsShared, Converter={StaticResource BoolToVis}}" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding HiddenText}" Style="{StaticResource MutedText}" FontSize="11" Margin="6,0,8,0" VerticalAlignment="Center"
                                   Visibility="{Binding HiddenText, Converter={StaticResource EmptyToVis}}" />
                        <TextBlock Text="{Binding Title}" Style="{StaticResource MutedText}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </DockPanel>
                </Button>
                <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource ChannelRow}" Focusable="False" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsOpen}" Value="False">
                    <Setter TargetName="Chevron" Property="Text" Value="&#xE76C;" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasRows}" Value="False">
                    <Setter TargetName="Section" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="ChatFileChip" DataType="{x:Type vm:AttachmentViewModel}">
            <Button Style="{StaticResource SubtleButton}" Padding="0" Margin="0,0,6,4" Command="{Binding OpenCommand}"
                    ToolTip="{Binding ShortToolTip}" AutomationProperties.Name="{Binding FileName}">
                <!-- A file in the Chat cache can be kept for good, so it's never cleaned out. -->
                <Button.ContextMenu>
                    <ContextMenu Visibility="{Binding CanKeep, Converter={StaticResource BoolToVis}}">
                        <MenuItem Header="Keep it" IsCheckable="True" IsChecked="{Binding IsKept}"
                                  ToolTip="The Chat cache never cleans it out (Settings › Chat)" />
                        <MenuItem Header="Show in folder" Command="{Binding ShowInFolderCommand}" />
                    </ContextMenu>
                </Button.ContextMenu>
                <Border Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="6,3">
                    <Grid>
                        <Image Source="{Binding Thumbnail}" MaxHeight="160" MaxWidth="280" Stretch="Uniform" Margin="-4,-1"
                               Visibility="{Binding ShowsThumbnail, Converter={StaticResource BoolToVis}}" />
                        <StackPanel Orientation="Horizontal" Visibility="{Binding ShowsThumbnail, Converter={StaticResource InvBoolToVis}}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="12" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding FileName}" FontSize="12" MaxWidth="200" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource MutedText}" FontSize="11" Margin="6,0,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Button>
        </DataTemplate>

        <!-- A message's file: audio and video play in place, other files show as their chip. -->
        <local:PlayableTemplateSelector x:Key="ChatFile" Chip="{StaticResource ChatFileChip}" Player="{StaticResource PlayerTemplate}" />

        <!-- The Media tab's grid: a tile per picture, video (a frame of it, with a play mark) or sound; a click views it over the tab. -->
        <DataTemplate x:Key="MediaTile" DataType="{x:Type vm:ChatFileViewModel}">
            <Button Style="{StaticResource SubtleButton}" Padding="0" Margin="0,0,8,8" Command="{Binding ViewCommand}" ToolTip="{Binding ToolTip}"
                    AutomationProperties.Name="{Binding FileName}">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="View" Command="{Binding ViewCommand}" FontWeight="SemiBold" />
                        <MenuItem Header="Open in its default app" Command="{Binding File.OpenExternallyCommand}"
                                  ToolTip="Opens it in the app Windows uses for this kind of file" />
                        <Separator />
                        <MenuItem Header="Show it in the chat" Command="{Binding ShowInChatCommand}" />
                        <MenuItem Header="Show in folder" Command="{Binding File.ShowInFolderCommand}" />
                        <MenuItem Header="Keep it" IsCheckable="True" IsChecked="{Binding File.IsKept}" Visibility="{Binding File.CanKeep, Converter={StaticResource BoolToVis}}"
                                  ToolTip="The Chat cache never cleans it out (Settings › Chat)" />
                    </ContextMenu>
                </Button.ContextMenu>
                <Border Width="168" Height="126" CornerRadius="6" ClipToBounds="True" Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid>
                        <Image Source="{Binding Picture}" Stretch="UniformToFill" Visibility="{Binding HasPicture, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8D6;" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,18"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Visibility="{Binding IsAudio, Converter={StaticResource BoolToVis}}" />
                        <Border Width="34" Height="34" CornerRadius="17" Background="#99000000" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding IsVideo, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0" />
                        </Border>
                        <Border VerticalAlignment="Bottom" Background="#B3000000" Padding="6,3">
                            <TextBlock Text="{Binding FileName}" FontSize="11" Foreground="White" TextTrimming="CharacterEllipsis" />
                        </Border>
                    </Grid>
                </Border>
            </Button>
        </DataTemplate>

        <!-- A row of the Files tab (and of Media as a list): the file as in a message, who posted it and when, and a way to its message. -->
        <DataTemplate x:Key="FileRow" DataType="{x:Type vm:ChatFileViewModel}">
            <DockPanel Margin="0,0,0,10">
                <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Content="In the chat" Padding="8,3" VerticalAlignment="Top" Margin="8,0,0,0"
                        Command="{Binding ShowInChatCommand}" ToolTip="Show the message it was posted in" />
                <StackPanel>
                    <ContentControl Content="{Binding File}" ContentTemplateSelector="{StaticResource ChatFile}" Focusable="False" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding Details}" Style="{StaticResource MutedText}" FontSize="11.5" Margin="2,0,0,0" />
                </StackPanel>
            </DockPanel>
        </DataTemplate>

        <DataTemplate x:Key="PendingFile" DataType="{x:Type vm:PendingFile}">
            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2,2,2" Margin="0,4,6,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE723;" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Name}" FontSize="12" MaxWidth="170" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SizeText}" Style="{StaticResource MutedText}" FontSize="11" Margin="5,0,0,0" VerticalAlignment="Center" />
                    <Button Style="{StaticResource SubtleIconButton}" Content="&#xE711;" FontSize="9" Padding="4" Margin="2,0,0,0" Command="{Binding RemoveCommand}"
                            ToolTip="Leave this file out" AutomationProperties.Name="Leave out" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!--
            A message: the day above the first of a day, a "New" line above the first you hadn't read, the badge and name
            above a run of messages by the same person, the message it answers, its text and files. Lines from ProJict
            ("Codex joined") show small. Reply, Edit, Delete and Copy appear on hover.
        -->
        <DataTemplate x:Key="ChatMessage" DataType="{x:Type vm:ChatMessageViewModel}">
            <StackPanel>
                <Grid Margin="0,14,0,6" Visibility="{Binding DayHeader, Converter={StaticResource EmptyToVis}}">
                    <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Center" />
                    <Border HorizontalAlignment="Center" Padding="10,0" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                        <TextBlock Text="{Binding DayHeader}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </Border>
                </Grid>
                <Grid Margin="0,6,0,4" Visibility="{Binding IsFirstUnread, Converter={StaticResource BoolToVis}}">
                    <Border Height="1" Background="{DynamicResource SystemFillColorCriticalBrush}" VerticalAlignment="Center" />
                    <Border HorizontalAlignment="Right" Padding="6,0" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                        <TextBlock Text="New" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                    </Border>
                </Grid>
                <TextBlock Text="{Binding NoticeText}" ToolTip="{Binding WhenToolTip}" Style="{StaticResource MutedText}" FontSize="12" FontStyle="Italic" Margin="46,3,0,3"
                           TextWrapping="Wrap" Visibility="{Binding IsNotice, Converter={StaticResource BoolToVis}}" />
                <Border x:Name="Body" CornerRadius="6" Padding="6,2,6,2" Background="Transparent" Visibility="{Binding IsNotice, Converter={StaticResource InvBoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Badge" Width="30" Height="30" CornerRadius="15" Background="{Binding Badge.Background}" VerticalAlignment="Top" HorizontalAlignment="Left"
                                Margin="0,4,0,0">
                            <Grid>
                                <TextBlock Text="{Binding Badge.Initials}" Foreground="White" FontWeight="SemiBold" FontSize="11.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Ellipse x:Name="AuthorPicture" Width="30" Height="30" Visibility="{Binding HasPicture, Converter={StaticResource BoolToVis}}">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{Binding Picture}" Stretch="UniformToFill" />
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="SideTime" Text="{Binding Time}" ToolTip="{Binding WhenToolTip}" FontSize="10.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Margin="0,3,0,0" Visibility="Collapsed" />
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="Header" Margin="0,2,0,1" ToolTip="{Binding WhenToolTip}">
                                <TextBlock.ContextMenu>
                                    <ContextMenu Visibility="{Binding CanMessageAuthor, Converter={StaticResource BoolToVis}}">
                                        <MenuItem Header="Private message" Command="{Binding PrivateMessageCommand}" />
                                    </ContextMenu>
                                </TextBlock.ContextMenu>
                                <Run x:Name="ByRun" Text="{Binding By, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Time, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </TextBlock>
                            <Button Style="{StaticResource SubtleButton}" HorizontalAlignment="Left" Padding="0" Margin="0,1,0,3" Command="{Binding ShowRepliedCommand}"
                                    ToolTip="Show the message it answers" Visibility="{Binding HasReply, Converter={StaticResource BoolToVis}}">
                                <Border BorderThickness="2,0,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="8,1,4,1">
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding ReplyBy, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding ReplySnippet, Mode=OneWay}" />
                                    </TextBlock>
                                </Border>
                            </Button>
                            <local:ChatMessageText x:Name="Text" Segments="{Binding Segments}" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding EditedText}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Visibility="{Binding EditedText, Converter={StaticResource EmptyToVis}}" />
                            <ItemsControl ItemsSource="{Binding Attachments}" ItemTemplateSelector="{StaticResource ChatFile}" ItemsPanel="{StaticResource Wrap}"
                                          Focusable="False" Margin="0,4,0,0" Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVis}}" />
                            <!-- What it asks to approve (ask_approval): Approve and Decline until someone answers, then who did -->
                            <Border x:Name="ApprovalBox" Margin="0,5,0,0" Padding="10,7" CornerRadius="6" HorizontalAlignment="Left" MaxWidth="560"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                                    Visibility="{Binding AsksApproval, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap">
                                        <Run Text="Asks to approve: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" /><Run Text="{Binding Approval, Mode=OneWay}" FontWeight="SemiBold" />
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0" Visibility="{Binding CanDecide, Converter={StaticResource BoolToVis}}">
                                        <Button x:Name="ApproveButton" Style="{StaticResource AccentButtonStyle}" Content="Approve" Padding="14,4" Command="{Binding ApproveCommand}"
                                                ToolTip="Lets the agent do exactly this" />
                                        <Button x:Name="DeclineButton" Content="Decline" Padding="14,4" Margin="6,0,0,0" Command="{Binding DeclineCommand}"
                                                ToolTip="The agent won't do it" />
                                    </StackPanel>
                                    <TextBlock x:Name="DecisionLine" Text="{Binding DecisionText}" FontSize="12" Margin="0,4,0,0"
                                               Visibility="{Binding DecisionText, Converter={StaticResource EmptyToVis}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsApproved}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsDeclined}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <!-- Thumbs given: a yes or no to the message -->
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <Button Style="{StaticResource SubtleButton}" Padding="6,1" Margin="0,0,4,0" Command="{Binding ThumbUpCommand}" ToolTip="{Binding UpsToolTip}"
                                        Visibility="{Binding HasUps, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Yes answers">
                                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8E1;" FontSize="11" /><TextBlock Text="{Binding Ups}" FontSize="11" Margin="4,0,0,0" /></StackPanel>
                                </Button>
                                <Button Style="{StaticResource SubtleButton}" Padding="6,1" Command="{Binding ThumbDownCommand}" ToolTip="{Binding DownsToolTip}"
                                        Visibility="{Binding HasDowns, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="No answers">
                                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8E0;" FontSize="11" /><TextBlock Text="{Binding Downs}" FontSize="11" Margin="4,0,0,0" /></StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel x:Name="Actions" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Opacity="0">
                            <Button Style="{StaticResource SubtleIconButton}" FontSize="12" Padding="5,3" Content="&#xE8E1;" ToolTip="Yes (👍)" AutomationProperties.Name="Thumbs up"
                                    Command="{Binding ThumbUpCommand}" Visibility="{Binding CanReact, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource SubtleIconButton}" FontSize="12" Padding="5,3" Content="&#xE8E0;" ToolTip="No (👎)" AutomationProperties.Name="Thumbs down"
                                    Command="{Binding ThumbDownCommand}" Visibility="{Binding CanReact, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource SubtleIconButton}" FontSize="12" Padding="5,3" Content="&#xE97A;" ToolTip="Reply" AutomationProperties.Name="Reply"
                                    Command="{Binding ReplyCommand}" />
                            <Button Style="{StaticResource SubtleIconButton}" FontSize="12" Padding="5,3" Content="&#xE70F;" ToolTip="Edit (or Up in an empty box)" AutomationProperties.Name="Edit"
                                    Command="{Binding EditCommand}" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource SubtleIconButton}" FontSize="12" Padding="5,3" Content="&#xE8C8;" ToolTip="Copy the message" AutomationProperties.Name="Copy"
                                    Command="{Binding CopyCommand}" />
                            <Button Style="{StaticResource SubtleIconButton}" FontSize="12" Padding="5,3" Content="&#xE74D;" ToolTip="Delete" AutomationProperties.Name="Delete message"
                                    Command="{Binding DeleteCommand}" Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding ShowHeader}" Value="False">
                    <Setter TargetName="Badge" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Header" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <Trigger SourceName="Body" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Actions" Property="Opacity" Value="1" />
                    <Setter TargetName="Body" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                </Trigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding ShowHeader}" Value="False" />
                        <Condition Binding="{Binding IsMouseOver, ElementName=Body}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="SideTime" Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsAgent}" Value="True">
                    <Setter TargetName="ByRun" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding MentionsMe}" Value="True">
                    <Setter TargetName="Body" Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                    <Setter TargetName="Body" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                    <Setter TargetName="Text" Property="TextElement.FontStyle" Value="Italic" />
                    <Setter TargetName="Text" Property="TextElement.Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A member: badge, name, role, muted; moderators get a ⋯ menu (mute, remove, moderator). -->
        <DataTemplate x:Key="Member" DataType="{x:Type vm:ChatMemberViewModel}">
            <DockPanel Margin="0,0,0,8" Background="Transparent">
                <DockPanel.ContextMenu>
                    <ContextMenu Visibility="{Binding HasMenu, Converter={StaticResource BoolToVis}}">
                        <MenuItem Header="Private message" Command="{Binding PrivateMessageCommand}" Visibility="{Binding CanMessage, Converter={StaticResource BoolToVis}}" />
                        <MenuItem Header="{Binding IgnoreHeader}" Command="{Binding ToggleIgnoreCommand}" Visibility="{Binding CanIgnore, Converter={StaticResource BoolToVis}}"
                                  ToolTip="Only for you: their messages are hidden in channels, except those that mention you. They aren't told." />
                    </ContextMenu>
                </DockPanel.ContextMenu>
                <Button DockPanel.Dock="Right" Style="{StaticResource SubtleIconButton}" Content="&#xE712;" FontSize="12" Padding="5,3" VerticalAlignment="Center"
                        ToolTip="Mute, remove or make moderator" AutomationProperties.Name="Moderate" Click="MemberMore_Click"
                        Visibility="{Binding CanModerate, Converter={StaticResource BoolToVis}}" />
                <!-- Their badge, with a dot for online (green), away (amber) or offline (grey, and the badge faded) -->
                <Grid DockPanel.Dock="Left" Margin="0,0,10,0" VerticalAlignment="Center" ToolTip="{Binding PresenceText}">
                    <Border Width="26" Height="26" CornerRadius="13" Background="{Binding Badge.Background}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOffline}" Value="True">
                                        <Setter Property="Opacity" Value="0.45" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Badge.Initials}" Foreground="White" FontWeight="SemiBold" FontSize="10.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Ellipse x:Name="PresenceDot" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2" StrokeThickness="2"
                             Stroke="{DynamicResource SolidBackgroundFillColorBaseBrush}" AutomationProperties.Name="{Binding PresenceText}">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAway}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsOffline}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                </Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding RoleText}" Style="{StaticResource MutedText}" FontSize="11" Visibility="{Binding RoleText, Converter={StaticResource EmptyToVis}}" />
                    <TextBlock Text="{Binding MutedText}" FontSize="11" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                               Visibility="{Binding MutedText, Converter={StaticResource EmptyToVis}}" />
                </StackPanel>
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Channels -->
        <Border BorderThickness="0,0,1,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <DockPanel Margin="16,20,12,12">
                <DockPanel DockPanel.Dock="Top">
                    <Button x:Name="NewChannelButton" DockPanel.Dock="Right" Style="{StaticResource SubtleIconButton}" Content="&#xE710;" VerticalAlignment="Center"
                            Command="{Binding NewChannelCommand}" ToolTip="Start a channel" AutomationProperties.Name="Start a channel" />
                    <Button x:Name="BrowseButton" DockPanel.Dock="Right" Style="{StaticResource SubtleIconButton}" Content="&#xE8FD;" VerticalAlignment="Center"
                            Command="{Binding BrowseCommand}" ToolTip="Browse channels: every channel, with what it's for" AutomationProperties.Name="Browse channels" />
                    <!-- The list's order: a click goes to the next (by name, by the last message, newest added first). -->
                    <Button x:Name="ChatOrderButton" DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Padding="5,4" VerticalAlignment="Center"
                            Command="{Binding CycleOrderCommand}" ToolTip="{Binding OrderToolTip}" AutomationProperties.Name="Sort the list">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8CB;" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding OrderText}" FontSize="10.5" Margin="3,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Button>
                    <ToggleButton x:Name="AgentChatsToggle" DockPanel.Dock="Right" Style="{StaticResource SubtleToggle}" IsChecked="{Binding ShowAgentChats}" VerticalAlignment="Center"
                                  Padding="7,5" ToolTip="Agents' private chats: what your AI agents write to each other privately (you read them)"
                                  AutomationProperties.Name="Agents' private chats">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE716;" FontSize="14" />
                    </ToggleButton>
                    <TextBlock Text="Chat" FontSize="28" FontWeight="SemiBold" />
                </DockPanel>
                <!-- Search (Ctrl+F): the messages with all the words, instead of the channels while it has any; # keeps to the open channel. -->
                <StackPanel DockPanel.Dock="Top" Margin="0,10,0,0">
                    <DockPanel>
                        <ToggleButton x:Name="SearchHereToggle" DockPanel.Dock="Right" Style="{StaticResource SubtleToggle}" IsChecked="{Binding SearchHere}" Margin="4,0,0,0"
                                      Padding="9,4" ToolTip="{Binding SearchHereToolTip}" AutomationProperties.Name="Search only the open channel"
                                      Visibility="{Binding HasChannel, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="#" FontSize="15" FontWeight="SemiBold" />
                        </ToggleButton>
                    <Grid>
                        <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}" Padding="8,5,28,5"
                                 AutomationProperties.Name="Search Chat" PreviewKeyDown="SearchBox_PreviewKeyDown"
                                 ToolTip="Messages with all these words, in the text, who wrote it or the channel's name (Ctrl+F; Esc clears)" />
                        <TextBlock Text="{Binding SearchPlaceholder}" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" Visibility="{Binding SearchText, Converter={StaticResource InvEmptyToVis}}" />
                        <Button Style="{StaticResource SubtleIconButton}" Content="&#xE711;" FontSize="9" Padding="5" HorizontalAlignment="Right" Margin="0,0,3,0"
                                Command="{Binding ClearSearchCommand}" ToolTip="Clear the search (Esc)" AutomationProperties.Name="Clear the search"
                                Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                    </DockPanel>
                </StackPanel>
                <!-- What the search found: where, who and when, and the line with the words; a click opens it. -->
                <Grid>
                <ScrollViewer x:Name="SearchResultsPane" VerticalScrollBarVisibility="Auto" Margin="-4,8,-4,0"
                              Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}">
                    <StackPanel Margin="4,0">
                        <TextBlock Text="{Binding SearchSummary}" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="2,0,0,6" />
                        <ItemsControl x:Name="SearchResultList" ItemsSource="{Binding SearchResults}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ChatSearchRow}">
                                    <Border x:Name="Row" Padding="8,5" Margin="0,0,0,2" CornerRadius="4" Background="Transparent" Cursor="Hand"
                                            ToolTip="{Binding ToolTip}" AutomationProperties.Name="{Binding Snippet}">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.OpenSearchResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}" />
                                        </Border.InputBindings>
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding When}" FontSize="11" Margin="6,0,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                <TextBlock FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                    <Run Text="{Binding Where, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Who, Mode=OneWay}" FontWeight="SemiBold" />
                                                </TextBlock>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Snippet}" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="ChannelListPane" VerticalScrollBarVisibility="Auto" Margin="-4,12,-4,0"
                              Visibility="{Binding IsSearching, Converter={StaticResource InvBoolToVis}}">
                    <StackPanel Margin="4,0">
                        <TextBlock Text="No channels yet. Start one with + above, or from the right-click menu of a project, category or item."
                                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Visibility="{Binding HasNoChannels, Converter={StaticResource BoolToVis}}" />
                        <ContentControl x:Name="YourChannelList" Content="{Binding Yours}" ContentTemplate="{StaticResource ChatSectionView}" Focusable="False" />
                        <ContentControl x:Name="OtherChannelList" Content="{Binding Others}" ContentTemplate="{StaticResource ChatSectionView}" Focusable="False" />
                        <ContentControl x:Name="PrivateList" Content="{Binding Private}" ContentTemplate="{StaticResource ChatSectionView}" Focusable="False" />
                        <!-- The agents' private conversations with each other, while the toggle above is on. -->
                        <StackPanel x:Name="AgentChatsPanel" Visibility="{Binding ShowAgentChats, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding AgentChatsTitle}" Style="{StaticResource MutedText}" FontSize="12" Margin="8,14,0,4"
                                       ToolTip="What your AI agents write to each other privately. You read them; right-click one to suspend or delete it." />
                            <TextBlock Text="No agent has written privately to another yet." Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="8,0,0,0"
                                       Visibility="{Binding HasAgentChats, Converter={StaticResource InvBoolToVis}}" />
                            <ItemsControl x:Name="AgentChatList" ItemsSource="{Binding AgentChats}" ItemTemplate="{StaticResource AgentChatRow}" Focusable="False" />
                        </StackPanel>
                        <!-- The channels of the ProJicts you're connected to, under their owners' names. -->
                        <ItemsControl x:Name="HostList" ItemsSource="{Binding HostChats}" ItemTemplate="{StaticResource ChatSectionView}" Focusable="False" />
                        <!-- Archived private conversations, at the bottom, folded until you open them. -->
                        <ContentControl x:Name="ArchiveList" Content="{Binding Archive}" ContentTemplate="{StaticResource ChatSectionView}" Focusable="False" />
                        <Button Style="{StaticResource SubtleButton}" HorizontalAlignment="Left" Margin="0,10,0,0" Command="{Binding BrowseCommand}"
                                Visibility="{Binding HasNoChannels, Converter={StaticResource InvBoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8FD;" FontSize="12" Margin="0,1,6,0" />
                                <TextBlock Text="Browse channels" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Nothing open -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420"
                    Visibility="{Binding ShowEmptyPane, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Live chat with your AI agents" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,12"
                       Text="Start a #channel about a project, category or item, or about anything. Agents connected to ProJict can read, post and listen in it." />
            <Button Style="{StaticResource AccentButtonStyle}" Content="Start a channel" HorizontalAlignment="Center" Command="{Binding NewChannelCommand}" />
        </StackPanel>

        <!-- Starting a channel -->
        <ScrollViewer x:Name="NewChannelPane" Grid.Column="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsCreating, Converter={StaticResource BoolToVis}}">
            <StackPanel Margin="28,20,28,20" MaxWidth="560" HorizontalAlignment="Left">
                <TextBlock Text="Start a channel" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="Live chat with AI agents. You moderate every channel; whoever starts one moderates it too." />
                <TextBlock Text="Name" FontWeight="SemiBold" Margin="0,18,0,4" />
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="#" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBox x:Name="NewNameBox" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Channel name" />
                </DockPanel>
                <TextBlock x:Name="NewNameProblem" Text="{Binding NewNameProblem}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}" Visibility="{Binding NewNameProblem, Converter={StaticResource EmptyToVis}}" />
                <TextBlock Text="Topic" FontWeight="SemiBold" Margin="0,14,0,4" />
                <TextBox Text="{Binding NewTopic, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Topic" />
                <TextBlock Style="{StaticResource MutedText}" FontSize="12" Margin="0,2,0,0" Text="What it's for, in a line. It shows in the channel lists." />
                <StackPanel Margin="0,14,0,0" Visibility="{Binding HasNewLink, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="About" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Content="Unlink" Command="{Binding UnlinkCommand}"
                                ToolTip="A channel about nothing in particular" />
                        <TextBlock x:Name="NewLinkText" Text="{Binding NewLinkText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource MutedText}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"
                               Text="It shows as a #chip there, and agents find it from there." />
                </StackPanel>
                <TextBlock Text="Who can join" FontWeight="SemiBold" Margin="0,14,0,4" />
                <RadioButton x:Name="NewOpenRadio" GroupName="NewAccess" IsChecked="{Binding NewOpen}" Content="Open: anyone who can see its project can read and join" />
                <RadioButton x:Name="NewInviteRadio" GroupName="NewAccess" IsChecked="{Binding NewInviteOnly}" Content="Invite only: just you and those invited" Margin="0,4,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <Button x:Name="CreateButton" Style="{StaticResource AccentButtonStyle}" Content="Start channel" Command="{Binding CreateChannelCommand}" />
                    <Button Content="Cancel" Margin="8,0,0,0" Command="{Binding CancelNewChannelCommand}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Browse channels -->
        <DockPanel x:Name="BrowsePane" Grid.Column="1" Margin="28,20,28,12" Visibility="{Binding IsBrowsing, Converter={StaticResource BoolToVis}}">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Style="{StaticResource SubtleIconButton}" Content="&#xE711;" FontSize="12" VerticalAlignment="Top"
                        Command="{Binding CloseBrowseCommand}" ToolTip="Close" AutomationProperties.Name="Close" />
                <Button DockPanel.Dock="Right" Content="Start a channel" Margin="0,0,10,0" VerticalAlignment="Top" Command="{Binding NewChannelCommand}" />
                <StackPanel>
                    <TextBlock Text="Browse channels" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,0" Text="Every channel, with what it's for. Open one, or join one you're not in." />
                </StackPanel>
            </DockPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="BrowseList" ItemsSource="{Binding BrowseRows}" Focusable="False" MaxWidth="820" HorizontalAlignment="Left">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:BrowseRowViewModel}">
                            <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,8">
                                <DockPanel>
                                    <Button x:Name="Action" DockPanel.Dock="Right" Content="{Binding ActionText}" VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="72"
                                            Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding ActionText}" />
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                                            <Border Style="{StaticResource TagChip}" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding AccessText}" FontSize="11" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock x:Name="Topic" Text="{Binding Topic}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding LinkText}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding LinkText, Converter={StaticResource EmptyToVis}}" />
                                        <TextBlock Text="{Binding Details}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding HasTopic}" Value="False">
                                    <Setter TargetName="Topic" Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <Setter TargetName="Topic" Property="FontStyle" Value="Italic" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsMember}" Value="False">
                                    <Setter TargetName="Action" Property="Style" Value="{StaticResource AccentButtonStyle}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <!-- The open channel -->
        <DockPanel x:Name="ChannelPane" Grid.Column="1" Margin="20,16,16,12" Visibility="{Binding ShowChannelPane, Converter={StaticResource BoolToVis}}">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="JoinButton" Style="{StaticResource AccentButtonStyle}" Content="Join" Command="{Binding JoinCommand}" Margin="0,0,8,0"
                            ToolTip="Join to see what's new here and be notified" Visibility="{Binding ShowJoin, Converter={StaticResource BoolToVis}}" />
                    <!-- A voice call: with the agent of a private conversation, or the agents you pick in a channel -->
                    <Button x:Name="CallButton" Style="{StaticResource SubtleButton}" Command="{Binding CallCommand}" Padding="9,5" Margin="0,0,6,0"
                            ToolTip="{Binding CallToolTip}" AutomationProperties.Name="Call" Visibility="{Binding CanCall, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE717;" FontSize="14" />
                    </Button>
                    <Popup x:Name="CallPicker" IsOpen="{Binding IsPickingCall}" PlacementTarget="{Binding ElementName=CallButton}" Placement="Bottom" StaysOpen="False"
                           AllowsTransparency="True">
                        <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="14,10" MinWidth="260">
                            <StackPanel>
                                <TextBlock Text="Who to call" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding CallChoices}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:CallChoice}">
                                            <StackPanel Margin="0,2">
                                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsPicked}" IsEnabled="{Binding CanTakeCall}" />
                                                <TextBlock Text="{Binding Note}" Style="{StaticResource MutedText}" FontSize="11.5" Margin="28,0,0,0"
                                                           Visibility="{Binding Note, Converter={StaticResource EmptyToVis}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Style="{StaticResource AccentButtonStyle}" Content="Call" Command="{Binding StartCallCommand}" HorizontalAlignment="Right" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>
                    </Popup>
                    <ToggleButton x:Name="MentionsToggle" Style="{StaticResource SubtleToggle}" IsChecked="{Binding OnlyMentions}" Margin="0,0,6,0"
                                  ToolTip="Only the messages that mention you (by name or @everyone), in every channel, until you turn it off. What it hides stays new."
                                  AutomationProperties.Name="Only what mentions you" Visibility="{Binding IsDirect, Converter={StaticResource InvBoolToVis}}">
                        <TextBlock Text="@" FontWeight="SemiBold" />
                    </ToggleButton>
                    <ToggleButton x:Name="MembersToggle" Style="{StaticResource SubtleToggle}" IsChecked="{Binding ShowMembers}" ToolTip="Show or hide the members"
                                  AutomationProperties.Name="Members">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE716;" FontSize="13" Margin="0,1,6,0" />
                            <TextBlock Text="{Binding MembersText}" />
                        </StackPanel>
                    </ToggleButton>
                    <Button Style="{StaticResource SubtleIconButton}" Content="&#xE712;" Margin="4,0,0,0" ToolTip="Leave, open or close the channel, delete it"
                            AutomationProperties.Name="Channel menu" Click="ChannelMore_Click" />
                </StackPanel>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Image x:Name="ChannelHeaderIcon" Source="{Binding Icon}" Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}" />
                        <TextBlock x:Name="ChannelTitle" Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" />
                        <Border Style="{StaticResource TagChip}" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Margin="10,0,0,0" VerticalAlignment="Center"
                                ToolTip="{Binding AccessToolTip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="10" Margin="0,1,4,0" Visibility="{Binding IsInviteOnly, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="{Binding AccessText}" FontSize="11" />
                            </StackPanel>
                        </Border>
                        <!-- Its project: a click opens the board; not linked yet but named after one, an offer to link it. -->
                        <Button x:Name="ProjectButton" Style="{StaticResource SubtleButton}" Margin="10,0,0,0" Padding="8,3" VerticalAlignment="Center"
                                Command="{Binding OpenLinkCommand}" ToolTip="{Binding LinkedProjectToolTip}" AutomationProperties.Name="Open the project"
                                Visibility="{Binding HasLinkedProject, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="13" Margin="0,1,6,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding LinkedProjectName}" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="10" Margin="6,2,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SuggestLinkButton" Style="{StaticResource SubtleButton}" Margin="8,0,0,0" Padding="8,3" VerticalAlignment="Center"
                                Command="{Binding LinkToSuggestedCommand}" ToolTip="{Binding SuggestLinkToolTip}" AutomationProperties.Name="{Binding SuggestLinkText}"
                                Visibility="{Binding HasSuggestedProject, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE71B;" FontSize="12" Margin="0,1,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding SuggestLinkText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBox x:Name="TopicBox" Style="{StaticResource HoverHintTextBox}" Tag="topic…" Margin="-2,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                             Text="{Binding TopicText, UpdateSourceTrigger=LostFocus}" IsReadOnly="{Binding IsModerator, Converter={StaticResource InvBool}}"
                             AutomationProperties.Name="Topic" ToolTip="What the channel is for; moderators change it"
                             Visibility="{Binding IsDirect, Converter={StaticResource InvBoolToVis}}" />
                    <TextBlock FontSize="12" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                        <Hyperlink x:Name="LinkHyperlink" Command="{Binding OpenLinkCommand}" ToolTip="Show it on its board"><Run Text="{Binding LinkText, Mode=OneWay}" /></Hyperlink><Run Text="{Binding LinkSeparator, Mode=OneWay}" /><Run Text="{Binding StartedText, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </DockPanel>

            <!-- The channel's tabs: its messages, its pictures, videos and sounds, and its other files; the last two searchable -->
            <DockPanel x:Name="ChannelTabs" DockPanel.Dock="Top" Margin="0,0,0,8">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <ToggleButton Style="{StaticResource SubtleToggle}" IsChecked="{Binding ShowsMessages, Mode=OneWay}" Command="{Binding ShowTabCommand}" CommandParameter="Messages"
                                  Content="Messages" Padding="9,3" Margin="0,0,4,0" AutomationProperties.Name="Messages" />
                    <ToggleButton x:Name="MediaTab" Style="{StaticResource SubtleToggle}" IsChecked="{Binding ShowsMedia, Mode=OneWay}" Command="{Binding ShowTabCommand}" CommandParameter="Media"
                                  Content="{Binding MediaTabText}" Padding="9,3" Margin="0,0,4,0" AutomationProperties.Name="Media"
                                  ToolTip="The pictures, videos and sounds posted here, newest first" />
                    <ToggleButton x:Name="FilesTab" Style="{StaticResource SubtleToggle}" IsChecked="{Binding ShowsFiles, Mode=OneWay}" Command="{Binding ShowTabCommand}" CommandParameter="Files"
                                  Content="{Binding FilesTabText}" Padding="9,3" AutomationProperties.Name="Files"
                                  ToolTip="The other files posted here, newest first" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding ShowsMessages, Converter={StaticResource InvBoolToVis}}">
                    <ToggleButton Style="{StaticResource SubtleToggle}" IsChecked="{Binding MediaAsList}" Padding="7,4" Margin="0,0,6,0" AutomationProperties.Name="As a list"
                                  ToolTip="As a list, where videos and sounds play in place (off: a grid of pictures)" Visibility="{Binding ShowsMedia, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8FD;" FontSize="13" />
                    </ToggleButton>
                    <Grid Width="220">
                        <TextBox x:Name="FileSearchBox" Text="{Binding FileSearch, UpdateSourceTrigger=PropertyChanged, Delay=150}" Padding="8,5,8,5"
                                 AutomationProperties.Name="Search the files" ToolTip="Files with all these words, in their name, who posted them or the message" />
                        <TextBlock Text="Search the files" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" Visibility="{Binding FileSearch, Converter={StaticResource InvEmptyToVis}}" />
                    </Grid>
                </StackPanel>
            </DockPanel>

            <!-- Writing -->
            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" Visibility="{Binding ShowsMessages, Converter={StaticResource BoolToVis}}">
                <Border CornerRadius="6" Padding="10,5" Margin="0,0,0,4" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        Visibility="{Binding IsReplying, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource SubtleIconButton}" Content="&#xE711;" FontSize="10" Padding="5,3" Command="{Binding CancelReplyCommand}"
                                ToolTip="Don't reply (Esc)" AutomationProperties.Name="Cancel reply" />
                        <TextBlock FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                            <Run Text="Replying to " /><Run Text="{Binding ReplyTo.By, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding ReplyTo.Model.Text, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </TextBlock>
                    </DockPanel>
                </Border>
                <Border CornerRadius="6" Padding="10,5" Margin="0,0,0,4" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource SubtleIconButton}" Content="&#xE711;" FontSize="10" Padding="5,3" Command="{Binding CancelReplyCommand}"
                                ToolTip="Don't change it (Esc)" AutomationProperties.Name="Cancel edit" />
                        <TextBlock Text="Editing your message" FontSize="12" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
                <!-- @mention suggestions: Up/Down pick, Tab or Enter puts the name in, Esc closes. -->
                <Border x:Name="MentionList" Style="{StaticResource Card}" Padding="4" Margin="0,0,0,4" HorizontalAlignment="Left" MinWidth="240"
                        Visibility="{Binding HasMentionChoices, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding MentionChoices}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:MentionChoice}">
                                <Border x:Name="Choice" Padding="8,4" CornerRadius="4" Background="Transparent" Cursor="Hand" MouseLeftButtonDown="MentionChoice_MouseDown">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="20" Height="20" CornerRadius="10" Background="{Binding Badge.Background}" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Badge.Initials}" Foreground="White" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="Choice" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    </DataTrigger>
                                    <Trigger SourceName="Choice" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Choice" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <TextBlock x:Name="ComposerNote" Text="{Binding ComposerNote}" Style="{StaticResource MutedText}" Margin="2,0,0,6"
                           Visibility="{Binding ComposerNote, Converter={StaticResource EmptyToVis}}" />
                <Grid IsEnabled="{Binding CanWrite}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="DraftBox" Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" MaxHeight="180"
                             VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Message" PreviewKeyDown="DraftBox_PreviewKeyDown"
                             TextChanged="DraftBox_Changed" SelectionChanged="DraftBox_Changed" LostKeyboardFocus="DraftBox_LostFocus"
                             AllowDrop="True" PreviewDragOver="Draft_PreviewDragOver" PreviewDrop="Draft_PreviewDrop" />
                    <Button Grid.Column="1" Style="{StaticResource SubtleIconButton}" Content="&#xE723;" Margin="6,0,0,0" VerticalAlignment="Bottom"
                            Command="{Binding AttachFilesCommand}" ToolTip="Attach files (or paste or drop them in the box)" AutomationProperties.Name="Attach files" />
                    <Button x:Name="SendButton" Grid.Column="2" Style="{StaticResource AccentButtonStyle}" Content="Send" Margin="6,0,0,0" VerticalAlignment="Bottom"
                            Command="{Binding SendCommand}" ToolTip="Enter (Shift+Enter for a new line)" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Pending}" ItemTemplate="{StaticResource PendingFile}" ItemsPanel="{StaticResource Wrap}" Focusable="False"
                              Visibility="{Binding HasPending, Converter={StaticResource BoolToVis}}" />
                <TextBlock Style="{StaticResource MutedText}" FontSize="11.5" Margin="2,5,0,0" TextWrapping="Wrap"
                           Text="Enter sends, Shift+Enter starts a new line, Up edits your last message. @name mentions someone, #name links a channel, # and an item's id (#4e84570c) links the item." />
            </StackPanel>

            <Grid>
            <!-- The Media and Files tabs -->
            <ScrollViewer x:Name="FileScroller" VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowsMessages, Converter={StaticResource InvBoolToVis}}">
                <StackPanel Margin="0,0,6,6">
                    <TextBlock Text="{Binding FilesNote}" Style="{StaticResource MutedText}" Margin="2,4,0,12" Visibility="{Binding FilesNote, Converter={StaticResource EmptyToVis}}" />
                    <ItemsControl x:Name="MediaGrid" ItemsSource="{Binding Files}" ItemTemplate="{StaticResource MediaTile}" ItemsPanel="{StaticResource Wrap}" Focusable="False"
                                  Visibility="{Binding ShowsFileGrid, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl x:Name="FileList" ItemsSource="{Binding Files}" ItemTemplate="{StaticResource FileRow}" Focusable="False"
                                  Visibility="{Binding ShowsFileList, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </ScrollViewer>
            <!-- Messages -->
            <ScrollViewer x:Name="MessageScroller" VerticalScrollBarVisibility="Auto" ScrollChanged="MessageScroller_ScrollChanged"
                          Visibility="{Binding ShowsMessages, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="0,0,6,6">
                    <Button Content="Show earlier messages" HorizontalAlignment="Center" Margin="0,4,0,8" Click="ShowEarlier_Click"
                            Visibility="{Binding HasEarlier, Converter={StaticResource BoolToVis}}" />
                    <TextBlock x:Name="MentionsNote" Text="{Binding MentionsNote}" Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,4,0,10"
                               Visibility="{Binding MentionsNote, Converter={StaticResource EmptyToVis}}" />
                    <ItemsControl x:Name="MessageList" ItemsSource="{Binding Messages}" ItemTemplate="{StaticResource ChatMessage}" Focusable="False" />
                </StackPanel>
            </ScrollViewer>
            <!--
                The Media tab's viewer (#9113ea6a): the picture as big as it fits, or the video or sound playing, over the tab.
                A click beside it (or anywhere else), Esc or the cross closes it; the arrows show the one before or after.
            -->
            <Grid x:Name="Viewer" Background="#141414" Visibility="{Binding IsViewing, Converter={StaticResource BoolToVis}}"
                  MouseLeftButtonUp="Viewer_MouseLeftButtonUp" AutomationProperties.Name="Viewer">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="14,8,8,4">
                    <Button x:Name="ViewerClose" DockPanel.Dock="Right" Style="{StaticResource SubtleIconButton}" Content="&#xE711;" Foreground="White" Padding="8"
                            Command="{Binding CloseViewerCommand}" ToolTip="Close (Esc)" AutomationProperties.Name="Close the viewer" VerticalAlignment="Top" />
                    <Button x:Name="ViewerOpen" DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Padding="10,5" Margin="6,0,4,0" VerticalAlignment="Top"
                            Command="{Binding Viewing.File.OpenExternallyCommand}" ToolTip="Opens it in the app Windows uses for this kind of file">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="12" Foreground="White" VerticalAlignment="Center" />
                            <TextBlock Text="Open in its default app" Foreground="White" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Padding="10,5" VerticalAlignment="Top"
                            Command="{Binding Viewing.ShowInChatCommand}" ToolTip="Show the message it was posted in">
                        <TextBlock Text="In the chat" Foreground="White" />
                    </Button>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Viewing.FileName}" Foreground="White" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Foreground="#B8FFFFFF" FontSize="12" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding Viewing.Details, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding ViewingPosition, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
                <Grid Grid.Row="1" Margin="58,6,58,18">
                    <Image x:Name="ViewerPicture" Source="{Binding Viewing.FullPicture}" Stretch="Uniform" StretchDirection="DownOnly"
                           RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding Viewing.IsPicture, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" />
                    <TextBlock Text="This picture can't be shown here: open it in its default app." Foreground="#B8FFFFFF" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Visibility="{Binding Viewing.PictureFailed, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" />
                    <local:InlinePlayer x:Name="ViewerPlayer" Fill="True" Path="{Binding Viewing.File.PlayPath}" Kind="{Binding Viewing.File.MediaKind}"
                                        FileName="{Binding Viewing.FileName}" Poster="{Binding Viewing.File.Poster}" OpenCommand="{Binding Viewing.File.OpenExternallyCommand}"
                                        MaxWidth="{Binding Viewing.PlayerMaxWidth, FallbackValue=560}" VerticalAlignment="Center"
                                        Visibility="{Binding Viewing.Plays, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" />
                </Grid>
                <Button x:Name="ViewerPrevious" Grid.Row="1" Style="{StaticResource SubtleIconButton}" Content="&#xE76B;" FontSize="20" Foreground="White" Padding="10,14"
                        HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0" Command="{Binding ViewPreviousCommand}"
                        Visibility="{Binding CanViewPrevious, Converter={StaticResource BoolToVis}}" ToolTip="The one before (left arrow)" AutomationProperties.Name="Previous" />
                <Button x:Name="ViewerNext" Grid.Row="1" Style="{StaticResource SubtleIconButton}" Content="&#xE76C;" FontSize="20" Foreground="White" Padding="10,14"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Command="{Binding ViewNextCommand}"
                        Visibility="{Binding CanViewNext, Converter={StaticResource BoolToVis}}" ToolTip="The one after (right arrow)" AutomationProperties.Name="Next" />
            </Grid>
            </Grid>
        </DockPanel>

        <!-- Members -->
        <Border x:Name="MembersPane" Grid.Column="2" Width="250" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding ShowMembers}" Value="True" />
                                <Condition Binding="{Binding ShowChannelPane}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel Margin="14,22,12,12">
                <TextBlock DockPanel.Dock="Top" Text="Members" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" Visibility="{Binding CanInvite, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Invite an agent or person" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,4" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Invite" Margin="6,0,0,0" Command="{Binding InviteCommand}" />
                        <ComboBox x:Name="InviteBox" IsEditable="True" ItemsSource="{Binding InviteChoices}" Text="{Binding InviteName, UpdateSourceTrigger=PropertyChanged}"
                                  TextSearch.TextPath="Name"
                                  AutomationProperties.Name="Who to invite" DropDownOpened="InviteBox_DropDownOpened"
                                  ToolTip="Agents and guests connected now come first">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:InviteChoice}">
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </DockPanel>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="MemberList" ItemsSource="{Binding Members}" ItemTemplate="{StaticResource Member}" Focusable="False" />
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
