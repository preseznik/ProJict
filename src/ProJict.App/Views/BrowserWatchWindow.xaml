<Window x:Class="ProJict.App.Views.BrowserWatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1100" Height="760" MinWidth="560" MinHeight="400" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!-- The browser an agent is using for a tool, shown while you watch: you can click and type in it too. -->
    <DockPanel>
        <Border x:Name="Header" DockPanel.Dock="Top" Padding="16,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Stop it" Margin="12,0,0,0" Click="Stop_Click" ToolTip="Ends the agent's use of the browser; it's told" />
                <TextBlock x:Name="Headline" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Border>
        <!-- The browser goes here (it's a window of its own, put over this space). -->
        <Border x:Name="Space" />
    </DockPanel>
</Window>
