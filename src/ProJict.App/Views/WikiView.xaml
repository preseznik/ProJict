<UserControl x:Class="ProJict.App.Views.WikiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ProJict.App.ViewModels">
    <UserControl.InputBindings>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding Page.SaveCommand}" />
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewPageCommand}" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <!-- A file on the page: a click opens it; insert puts a link to it where you're writing. -->
        <DataTemplate x:Key="WikiFile" DataType="{x:Type vm:WikiFileViewModel}">
            <Border Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="2,0,2,0" Margin="0,0,6,4">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource SubtleButton}" Padding="4,2" Command="{Binding OpenCommand}" ToolTip="{Binding ToolTip}" AutomationProperties.Name="{Binding FileName}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="12" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding FileName}" FontSize="12" MaxWidth="200" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource MutedText}" FontSize="11" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SubtleIconButton}" Content="&#xE8C8;" FontSize="11" Padding="4,2" Command="{Binding InsertCommand}"
                            ToolTip="Put a link to it in the page (pictures show)" AutomationProperties.Name="Insert a link to the file"
                            Visibility="{Binding DataContext.Page.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{StaticResource SubtleIconButton}" Content="&#xE711;" FontSize="10" Padding="4,2" Command="{Binding RemoveCommand}"
                            ToolTip="Remove from the page" AutomationProperties.Name="Remove the file" Visibility="{Binding CanRemove, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- A line of a diff: added lines green, removed ones red. -->
        <DataTemplate x:Key="DiffLine" DataType="{x:Type vm:DiffLineViewModel}">
            <Border x:Name="Line" Padding="6,0">
                <TextBlock Text="{Binding Text}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" TextWrapping="Wrap" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsAdded}" Value="True">
                    <Setter TargetName="Line" Property="Background" Value="#3022A050" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRemoved}" Value="True">
                    <Setter TargetName="Line" Property="Background" Value="#30D04040" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="WikiTreeItem" TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="ToolTip" Value="{Binding ToolTip}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" MinWidth="180" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Pages -->
        <DockPanel Margin="16,20,8,12">
            <DockPanel DockPanel.Dock="Top">
                <Button x:Name="NewPageButton" DockPanel.Dock="Right" Style="{StaticResource SubtleIconButton}" Content="&#xE710;" VerticalAlignment="Center"
                        Command="{Binding NewPageCommand}" ToolTip="New page, next to the open one (Ctrl+N)" AutomationProperties.Name="New page" />
                <TextBlock Text="Wiki" FontSize="28" FontWeight="SemiBold" />
            </DockPanel>
            <Grid DockPanel.Dock="Top" Margin="0,10,0,8">
                <TextBox x:Name="FilterBox" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Find pages" ToolTip="Find pages by name or text (Ctrl+K searches everything)" />
                <TextBlock Text="Find pages…" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Visibility="{Binding Filter, Converter={StaticResource InvEmptyToVis}}" />
            </Grid>
            <Grid>
                <TextBlock Text="No pages yet. Start one with + above, or turn a project's note into one (Notes › Move to wiki)."
                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="4,0" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
                <TreeView x:Name="PageTree" ItemsSource="{Binding Tree}" ItemContainerStyle="{StaticResource WikiTreeItem}" BorderThickness="0" Background="Transparent"
                          Visibility="{Binding IsFiltering, Converter={StaticResource InvBoolToVis}}" AutomationProperties.Name="Pages">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type vm:WikiNodeViewModel}" ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="12" Margin="0,1,7,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <Ellipse Style="{StaticResource UnreadDot}" Margin="6,0,0,0" VerticalAlignment="Center"
                                         Visibility="{Binding NeedsAttention, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
                <!-- Found pages, while searching -->
                <ListBox x:Name="ResultList" ItemsSource="{Binding Results}" BorderThickness="0" Background="Transparent"
                         Visibility="{Binding IsFiltering, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Pages found">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:WikiHitViewModel}">
                            <Border Background="Transparent" Cursor="Hand" Padding="2,2">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding OpenCommand}" />
                                </Border.InputBindings>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Location}" Style="{StaticResource MutedText}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Snippet}" Style="{StaticResource MutedText}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent"
                      BorderThickness="1,0,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" ResizeBehavior="PreviousAndNext"
                      ToolTip="Drag to make the list wider or narrower" />

        <!-- The open page -->
        <TextBlock Grid.Column="2" Text="Pick a page on the left, or start one with +." Style="{StaticResource MutedText}" Margin="24,28,0,0"
                   Visibility="{Binding HasPage, Converter={StaticResource InvBoolToVis}}" />
        <DockPanel x:Name="PagePanel" Grid.Column="2" Margin="20,16,16,12" DataContext="{Binding Page}"
                   Visibility="{Binding DataContext.HasPage, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
            <!-- Header: where it is, its title, the buttons, its project and sharing -->
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="{Binding FolderText}" Style="{StaticResource MutedText}" FontSize="12" Margin="3,0,0,0" />
                <DockPanel>
                    <StackPanel x:Name="PageButtons" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource AccentButtonStyle}" Command="{Binding SaveCommand}" Padding="12,4" Margin="0,0,6,0" ToolTip="Save as a new version (Ctrl+S)"
                                AutomationProperties.Name="Save" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" FontSize="12" VerticalAlignment="Center" /><TextBlock Text="Save" Margin="6,0,0,0" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource SubtleButton}" Command="{Binding CancelCommand}" Margin="0,0,6,0" ToolTip="Stop editing without saving"
                                AutomationProperties.Name="Cancel" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" Content="Cancel" />
                        <Button Style="{StaticResource SubtleButton}" Command="{Binding StartEditingCommand}" Margin="0,0,4,0" ToolTip="Write the page in Markdown, with a live preview beside it"
                                AutomationProperties.Name="Edit" Visibility="{Binding IsReading, Converter={StaticResource BoolToVis}}" IsEnabled="{Binding CanEdit}">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE70F;" /><TextBlock Text="Edit" Margin="6,0,0,0" /></StackPanel>
                        </Button>
                        <ToggleButton Style="{StaticResource SubtleToggle}" IsChecked="{Binding IsHistory, Mode=OneWay}" Command="{Binding ToggleHistoryCommand}" Margin="0,0,4,0"
                                      ToolTip="Every version: who saved it and when, what it changed, and Restore" AutomationProperties.Name="History">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" /><TextBlock Text="History" Margin="6,0,0,0" /></StackPanel>
                        </ToggleButton>
                        <Button x:Name="MoreButton" Style="{StaticResource SubtleIconButton}" Content="&#xE712;" Click="More_Click" ToolTip="Move, copy its link, delete"
                                AutomationProperties.Name="More">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Copy link to this page" Command="{Binding CopyLinkCommand}" />
                                    <MenuItem Header="Move or rename…" Command="{Binding MoveCommand}" IsEnabled="{Binding CanEdit}" />
                                    <MenuItem Header="Attach files…" Command="{Binding AttachFilesCommand}" IsEnabled="{Binding CanEdit}" />
                                    <Separator />
                                    <MenuItem Header="Delete page…" Command="{Binding DeleteCommand}" IsEnabled="{Binding IsOwn}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                    <TextBox x:Name="TitleBox" Style="{StaticResource RowTextBox}" FontSize="26" FontWeight="SemiBold" Padding="2,0" TextWrapping="NoWrap"
                             Text="{Binding Title, UpdateSourceTrigger=LostFocus}" IsReadOnly="{Binding IsReadOnly}" HorizontalAlignment="Left" MinWidth="200"
                             AutomationProperties.Name="Page title" ToolTip="The page's name (it moves along in links that use its path)" KeyDown="TitleBox_KeyDown" />
                </DockPanel>
                <WrapPanel Margin="2,6,0,0">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8F1;" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="ProjectBox" ItemsSource="{Binding ProjectChoices}" SelectedItem="{Binding Project}" MinWidth="170" Margin="0,0,10,0"
                              Visibility="{Binding IsOwn, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Project"
                              ToolTip="The project the page is about: it shows in the project's header and is shared as the project is" />
                    <Button Style="{StaticResource SubtleButton}" Command="{Binding OpenProjectCommand}" Padding="6,2" Margin="0,0,10,0" ToolTip="Open the project"
                            Visibility="{Binding IsLinked, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Open the project">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="12" />
                    </Button>
                    <CheckBox Content="Share with everyone I share with" IsChecked="{Binding SharedWithEveryone}" Margin="0,0,14,0" VerticalAlignment="Center"
                              Visibility="{Binding CanShareWithEveryone, Converter={StaticResource BoolToVis}}"
                              ToolTip="A page without a project stays on this computer unless you tick this; then everyone you share with sees it (and editors change it)" />
                    <TextBlock Text="{Binding SharingText}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,14,0" VerticalAlignment="Center"
                               Visibility="{Binding SharingText, Converter={StaticResource EmptyToVis}}" />
                    <TextBlock Text="{Binding InfoText}" Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center" />
                </WrapPanel>
                <!-- Another ProJict's page you can only read -->
                <TextBlock Text="{Binding ReadOnlyText}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="3,6,0,0" TextWrapping="Wrap"
                           Visibility="{Binding ReadOnlyText, Converter={StaticResource EmptyToVis}}" />
                <!-- An agent changed it: what changed, and Accept -->
                <Border Margin="0,8,0,0" Padding="10,6" CornerRadius="6" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                        Visibility="{Binding NeedsReview, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="What changed" Command="{Binding ShowChangesCommand}" Margin="8,0,0,0" />
                            <Button Content="Looks good" Style="{StaticResource AccentButtonStyle}" Command="{Binding AcceptCommand}" Margin="6,0,0,0"
                                    ToolTip="You've checked it: the review mark goes" />
                        </StackPanel>
                        <TextBlock Text="{Binding ReviewText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
                <!-- Saves that clashed: pick one, or merge by hand -->
                <ItemsControl ItemsSource="{Binding Clashes}" Focusable="False" Visibility="{Binding HasClashes, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:WikiClashViewModel}">
                            <Border Margin="0,8,0,0" Padding="10,6" CornerRadius="6" Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Content="Compare" Command="{Binding CompareCommand}" Margin="0,0,6,0" />
                                        <Button Content="{Binding TakeText}" Command="{Binding TakeCommand}" Margin="0,0,6,0" />
                                        <Button Content="Keep the page as it is" Command="{Binding KeepCommand}" Margin="0,0,6,0" />
                                        <Button Content="Merge by hand" Command="{Binding EditBothCommand}" ToolTip="Opens the editor with both versions, one after the other" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- Someone saved while you're editing -->
                <TextBlock Text="{Binding EditNotice}" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="3,6,0,0" TextWrapping="Wrap"
                           Visibility="{Binding EditNotice, Converter={StaticResource EmptyToVis}}" />
            </StackPanel>

            <!-- Files on the page -->
            <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button DockPanel.Dock="Left" Style="{StaticResource SubtleButton}" VerticalAlignment="Top" Command="{Binding AttachFilesCommand}" Margin="0,0,8,0"
                        AutomationProperties.Name="Attach files to the page" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}"
                        ToolTip="Pictures and files for the page; while editing, a link to each goes where you're writing (you can also paste or drop them there)">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE723;" /><TextBlock Text="Attach files…" Margin="6,0,0,0" /></StackPanel>
                </Button>
                <ItemsControl ItemsSource="{Binding Files}" ItemTemplate="{StaticResource WikiFile}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </DockPanel>

            <Grid Margin="0,10,0,0">
                <!-- Reading -->
                <DockPanel Visibility="{Binding IsReading, Converter={StaticResource BoolToVis}}">
                    <WrapPanel DockPanel.Dock="Bottom" Margin="2,6,0,0" Visibility="{Binding HasLinkedFrom, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Linked from" Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ItemsControl ItemsSource="{Binding LinkedFrom}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:WikiLinkChip}">
                                    <Button Style="{StaticResource SubtleButton}" Padding="0" Margin="0,0,4,0" Command="{Binding OpenCommand}" ToolTip="{Binding ToolTip}">
                                        <Border Style="{StaticResource TagChip}" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Margin="0">
                                            <TextBlock Text="{Binding Text}" FontSize="11" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </WrapPanel>
                    <FlowDocumentScrollViewer x:Name="Reader" VerticalScrollBarVisibility="Auto" IsToolBarVisible="False"
                                              AutomationProperties.Name="Page" MouseDoubleClick="Reader_MouseDoubleClick" />
                </DockPanel>

                <!-- Editing: Markdown on the left, the live preview on the right -->
                <Grid x:Name="EditorGrid" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="Editor" Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource MonoFont}" FontSize="13" VerticalContentAlignment="Top"
                             AutomationProperties.Name="Markdown" AllowDrop="True" PreviewDragOver="Editor_PreviewDragOver" PreviewDrop="Editor_PreviewDrop"
                             PreviewKeyDown="Editor_PreviewKeyDown" SelectionChanged="Editor_SelectionChanged"
                             ToolTip="Markdown: # headings, **bold**, - lists, | tables |, ```code```, [[Page name]] links pages, #4e84570c items, #channel channels. Paste or drop pictures and files." />
                    <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" />
                    <Border Grid.Column="2" BorderThickness="1" CornerRadius="4" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="8,6,0,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Preview" Style="{StaticResource MutedText}" FontSize="11" Margin="4,0,0,4" />
                            <FlowDocumentScrollViewer x:Name="PreviewViewer" VerticalScrollBarVisibility="Auto" IsToolBarVisible="False"
                                                      AutomationProperties.Name="Preview" />
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- History: every version, and what each changed -->
                <Grid x:Name="HistoryGrid" Visibility="{Binding IsHistory, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ListBox x:Name="VersionList" ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" AutomationProperties.Name="Versions">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:WikiVersionRowViewModel}">
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource MutedText}" FontSize="12"><Run Text="{Binding Who, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding When, Mode=OneWay}" /></TextBlock>
                                    <TextBlock Text="{Binding Changes}" Style="{StaticResource MutedText}" FontSize="11" />
                                    <TextBlock Text="{Binding Note}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                               Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <DockPanel Grid.Column="1" Margin="12,0,0,0">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Compare with the page now" Command="{Binding CompareWithCurrentCommand}" Margin="0,0,6,0" />
                                <Button Content="Restore this version" Style="{StaticResource AccentButtonStyle}" Command="{Binding RestoreCommand}" IsEnabled="{Binding CanRestore}"
                                        ToolTip="Its text becomes the newest version; nothing in the history is lost" />
                            </StackPanel>
                            <TextBlock Text="{Binding DiffTitle}" Style="{StaticResource MutedText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </DockPanel>
                        <Border BorderThickness="1" CornerRadius="4" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="DiffList" ItemsSource="{Binding Diff}" ItemTemplate="{StaticResource DiffLine}" Focusable="False" Margin="0,4"
                                              VirtualizingPanel.IsVirtualizing="True" />
                            </ScrollViewer>
                        </Border>
                    </DockPanel>
                </Grid>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
