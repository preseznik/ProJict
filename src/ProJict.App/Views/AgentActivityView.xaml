<UserControl x:Class="ProJict.App.Views.AgentActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ProJict.App.ViewModels"
             xmlns:local="clr-namespace:ProJict.App.Views">
    <UserControl.Resources>
        <!-- How much of its usage an agent has used: grey, amber from 75%, red from 90%; faded when the report is over a day old. -->
        <Style x:Key="UsageRingStyle" TargetType="local:UsageRing">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Thickness" Value="2.5" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fraction" Value="{Binding Usage.Fraction}" />
            <Setter Property="ToolTip" Value="{Binding Usage.ToolTip}" />
            <Setter Property="Track" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="Stroke" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Visibility" Value="{Binding Usage.HasUsage, Converter={StaticResource BoolToVis}}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Usage.ToolTip}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Usage.Level}" Value="Most">
                    <Setter Property="Stroke" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Usage.Level}" Value="NearlyAll">
                    <Setter Property="Stroke" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Usage.IsStale}" Value="True">
                    <Setter Property="Opacity" Value="0.4" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Three dots that light up in turn while an agent is busy. -->
        <Style x:Key="Dot" TargetType="Ellipse">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="6" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Fill" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            <Setter Property="Opacity" Value="0.25" />
        </Style>

        <DataTemplate x:Key="AgentCard" DataType="{x:Type vm:AgentCardViewModel}">
            <Border x:Name="CardRoot" Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,10">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Private message" Command="{Binding PrivateMessageCommand}" ToolTip="Write to this agent in Chat, just the two of you" />
                        <MenuItem Header="Usage…" Command="{Binding SetUsageCommand}" ToolTip="How much of its usage it has used (it can report it itself with report_usage)" />
                        <MenuItem Header="Change picture…" Command="{Binding ChangePictureCommand}" ToolTip="Agents make their own (set_picture); you can choose another" />
                        <MenuItem Header="Remove picture" Command="{Binding RemovePictureCommand}" Visibility="{Binding HasPicture, Converter={StaticResource BoolToVis}}" />
                    </ContextMenu>
                </Border.ContextMenu>
                <StackPanel>
                    <DockPanel>
                        <Grid DockPanel.Dock="Left" Width="44" Height="44" Margin="0,0,12,0" VerticalAlignment="Top">
                            <Border CornerRadius="22" Background="{Binding Badge.Background}">
                                <TextBlock Text="{Binding Badge.Initials}" Foreground="White" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Ellipse Visibility="{Binding HasPicture, Converter={StaticResource BoolToVis}}" Stroke="{DynamicResource CardStrokeColorDefaultBrush}" StrokeThickness="1">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding Picture}" Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-3" Width="18" Height="18" CornerRadius="9"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    ToolTip="It can't make its own picture and asked another agent to" Visibility="{Binding PictureWanted, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE722;" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <!-- Its private conversation in Chat -->
                        <Button DockPanel.Dock="Right" Style="{StaticResource SubtleIconButton}" Content="&#xE8BD;" FontSize="14" Padding="5,2" Margin="6,0,0,0"
                                VerticalAlignment="Top" Command="{Binding PrivateMessageCommand}" ToolTip="{Binding OpenChatToolTip}"
                                AutomationProperties.Name="Open the private conversation in Chat" />
                        <!-- Headphones: it hears Chat right away -->
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="&#xE7F6;" FontSize="15" Margin="10,2,0,0" VerticalAlignment="Top"
                                   Background="Transparent" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" ToolTip="{Binding HearsChatToolTip}"
                                   AutomationProperties.Name="Listening to Chat" Visibility="{Binding HearsChat, Converter={StaticResource BoolToVis}}" />
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <local:UsageRing x:Name="CardUsage" Style="{StaticResource UsageRingStyle}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Where}" Style="{StaticResource MutedText}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <!-- Live: what it's doing now. -->
                    <Border x:Name="StatusBox" CornerRadius="6" Padding="10,8" Margin="0,12,0,0" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding StatusAge}" Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" />
                            <StackPanel x:Name="Dots" DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed">
                                <Ellipse x:Name="Dot1" Style="{StaticResource Dot}" />
                                <Ellipse x:Name="Dot2" Style="{StaticResource Dot}" />
                                <Ellipse x:Name="Dot3" Style="{StaticResource Dot}" />
                            </StackPanel>
                            <TextBlock x:Name="IdleGlyph" DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE916;" FontSize="12" Margin="0,1,8,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusLine" Text="{Binding StatusText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <!-- Focused in the office: write to it privately here, without leaving. -->
                    <Border x:Name="PrivatePanel" CornerRadius="6" Padding="10,8" Margin="0,10,0,0" BorderThickness="1"
                            BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" Visibility="{Binding IsFocused, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding ConversationTitle}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding Conversation}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PrivateLine}">
                                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4">
                                            <Run Text="{Binding Who, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Time, Mode=OneWay}" FontSize="11"
                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}" /><LineBreak /><Run Text="{Binding Text, Mode=OneWay}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Nothing between you yet." Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,4"
                                       Visibility="{Binding HasConversation, Converter={StaticResource InvBoolToVis}}" />
                            <DockPanel Margin="0,4,0,0">
                                <Button DockPanel.Dock="Right" Content="Send" Command="{Binding SendCommand}" Style="{StaticResource AccentButtonStyle}" Margin="6,0,0,0" />
                                <TextBox x:Name="PrivateDraft" Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Write to it privately"
                                         ToolTip="Enter sends it to the agent privately, as in Chat">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding SendCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- What it has checked out. -->
                    <StackPanel Margin="0,10,0,0" Visibility="{Binding HasCheckedOut, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Checked out" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,4" />
                        <ItemsControl ItemsSource="{Binding CheckedOut}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:CheckoutRow}">
                                    <Border x:Name="Row" Padding="6,4" CornerRadius="4" Background="Transparent" Cursor="Hand" ToolTip="Show it on the board">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" Command="{Binding OpenCommand}" />
                                        </Border.InputBindings>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Project}" Style="{StaticResource MutedText}" FontSize="12" Margin="10,0,0,0" />
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="11" Margin="0,2,8,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                            <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Its latest actions, newest first. -->
                    <StackPanel Margin="0,10,0,0" Visibility="{Binding HasRecent, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Lately" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,2" />
                        <ItemsControl ItemsSource="{Binding Recent}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:AgentActionRow}">
                                    <Grid x:Name="Row" Margin="0,3,0,0" Opacity="0.7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="74" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Age}" ToolTip="{Binding Time}" Style="{StaticResource MutedText}" FontSize="12" />
                                        <DockPanel Grid.Column="1" HorizontalAlignment="Left" ToolTip="{Binding Time}">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding TimesText}" Style="{StaticResource MutedText}" FontSize="12" Margin="6,0,0,0"
                                                       Visibility="{Binding TimesText, Converter={StaticResource EmptyToVis}}" />
                                            <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" FontSize="13" />
                                        </DockPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Project}" Style="{StaticResource MutedText}" FontSize="12" Margin="10,0,0,0" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsLatest}" Value="True">
                                            <Setter TargetName="Row" Property="Opacity" Value="1" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter TargetName="Dots" Property="Visibility" Value="Visible" />
                    <Setter TargetName="IdleGlyph" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="StatusLine" Property="FontWeight" Value="SemiBold" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="Busy">
                            <Storyboard RepeatBehavior="Forever" Duration="0:0:1.3">
                                <DoubleAnimation Storyboard.TargetName="Dot1" Storyboard.TargetProperty="Opacity" From="0.25" To="1" Duration="0:0:0.35" AutoReverse="True" />
                                <DoubleAnimation Storyboard.TargetName="Dot2" Storyboard.TargetProperty="Opacity" From="0.25" To="1" Duration="0:0:0.35" AutoReverse="True" BeginTime="0:0:0.2" />
                                <DoubleAnimation Storyboard.TargetName="Dot3" Storyboard.TargetProperty="Opacity" From="0.25" To="1" Duration="0:0:0.35" AutoReverse="True" BeginTime="0:0:0.4" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="Busy" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
                <!-- Its robot was clicked in the office. -->
                <DataTrigger Binding="{Binding IsFlashing}" Value="True">
                    <Setter TargetName="CardRoot" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    <Setter TargetName="CardRoot" Property="BorderThickness" Value="2" />
                    <Setter TargetName="CardRoot" Property="Padding" Value="15,13" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--
            An agent in the list of all agents: connected ones in full, the others greyed out. A click shows its card;
            right-click for the rest. Rename edits the name in place (Enter keeps it, Esc cancels).
        -->
        <DataTemplate x:Key="AgentRow" DataType="{x:Type vm:AgentListRow}">
            <Border x:Name="Row" Padding="6,5" CornerRadius="6" Background="Transparent" ToolTip="{Binding ToolTip}" ContextMenuOpening="AgentRow_ContextMenuOpening">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding ShowCardCommand}" />
                </Border.InputBindings>
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Private message" Command="{Binding PrivateMessageCommand}" ToolTip="Write to this agent in Chat, just the two of you" />
                        <MenuItem Header="Invite to channel" ItemsSource="{Binding InviteTargets}" DisplayMemberPath="Title" IsEnabled="{Binding HasInviteTargets}"
                                  Click="InviteTarget_Click" ToolTipService.ShowOnDisabled="True" ToolTip="Your channels it isn't in yet" />
                        <MenuItem Header="Rename…" Command="{Binding StartRenameCommand}" ToolTip="{Binding RenameToolTip}" ToolTipService.ShowOnDisabled="True" />
                        <MenuItem Header="Usage…" Command="{Binding SetUsageCommand}" ToolTip="How much of its usage it has used (it can report it itself with report_usage)" />
                        <MenuItem Header="Change picture…" Command="{Binding ChangePictureCommand}" />
                        <MenuItem Header="Remove picture" Command="{Binding RemovePictureCommand}" Visibility="{Binding HasPicture, Converter={StaticResource BoolToVis}}" />
                        <Separator />
                        <MenuItem Header="Show its card" Command="{Binding ShowCardCommand}" />
                        <MenuItem Header="Show its work in the Feed" Command="{Binding ShowWorkCommand}" />
                    </ContextMenu>
                </Border.ContextMenu>
                <DockPanel>
                    <Grid DockPanel.Dock="Left" Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Top">
                        <Border CornerRadius="14" Background="{Binding Badge.Background}">
                            <TextBlock Text="{Binding Badge.Initials}" Foreground="White" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Ellipse Visibility="{Binding HasPicture, Converter={StaticResource BoolToVis}}">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding Picture}" Stretch="UniformToFill" />
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse x:Name="Online" Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-1,-1" Fill="#22C55E"
                                 Stroke="{DynamicResource CardBackgroundFillColorDefaultBrush}" StrokeThickness="1.5" Visibility="{Binding ShowsDot, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                    <StackPanel>
                        <StackPanel x:Name="NameText" Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <local:UsageRing x:Name="RowUsage" Style="{StaticResource UsageRingStyle}" Width="12" Height="12" Thickness="2" />
                        </StackPanel>
                        <TextBox x:Name="RenameBox" Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}" Visibility="Collapsed" MaxLength="20" Margin="0,0,0,2"
                                 AutomationProperties.Name="New name" IsVisibleChanged="RenameBox_IsVisibleChanged" LostKeyboardFocus="RenameBox_LostKeyboardFocus">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding CommitRenameCommand}" />
                                <KeyBinding Key="Escape" Command="{Binding CancelRenameCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="{Binding RenameProblem}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" FontSize="12" TextWrapping="Wrap"
                                   Visibility="{Binding RenameProblem, Converter={StaticResource EmptyToVis}}" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" FontSize="12" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                    <Setter TargetName="Row" Property="Cursor" Value="Hand" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ShowsDot}" Value="False">
                    <Setter TargetName="Row" Property="Opacity" Value="0.65" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsAway}" Value="True">
                    <Setter TargetName="Online" Property="Fill" Value="#F59E0B" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                    <Setter TargetName="NameText" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="RenameBox" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Older agent work, greyed out; a click goes where it happened. -->
        <DataTemplate x:Key="HistoryRow" DataType="{x:Type vm:AgentHistoryRow}">
            <StackPanel>
            <TextBlock Text="{Binding DayHeader}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="8,10,0,2"
                       Visibility="{Binding DayHeader, Converter={StaticResource EmptyToVis}}" />
            <Border x:Name="EntryRoot" Padding="8,6" CornerRadius="6" Background="Transparent" Cursor="Hand" Opacity="0.6">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding OpenCommand}" />
                </Border.InputBindings>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding When}" ToolTip="{Binding WhenToolTip}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,1,0,0" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1">
                        <TextBlock TextWrapping="Wrap">
                            <Run Text="{Binding Who, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" " /><Run Text="{Binding Action, Mode=OneWay}" />
                            <Run Text="{Binding Subject, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" FontSize="12" TextTrimming="CharacterEllipsis" MaxHeight="36" TextWrapping="Wrap"
                                   Visibility="{Binding Detail, Converter={StaticResource EmptyToVis}}" />
                        <TextBlock Text="{Binding Where}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,1,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
            </StackPanel>
            <DataTemplate.Triggers>
                <Trigger SourceName="EntryRoot" Property="IsMouseOver" Value="True">
                    <Setter TargetName="EntryRoot" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                    <Setter TargetName="EntryRoot" Property="Opacity" Value="0.9" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A day, week or month of earlier agent work: its heading, its stats when opened, and its entries unless folded. -->
        <DataTemplate x:Key="HistoryGroup" DataType="{x:Type vm:ActivityGroupViewModel}">
            <StackPanel>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ActivityGroupHeader}" Focusable="False" />
                <ContentControl Content="{Binding Stats}" ContentTemplate="{StaticResource ActivityStatsPanel}" Focusable="False"
                                Visibility="{Binding IsStatsOpen, Converter={StaticResource BoolToVis}}" />
                <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource HistoryRow}" Focusable="False"
                              Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <!--
        The office and the list of all agents stand beside the page when there's room (OfficeSide), else above the cards
        (OfficeTop); see the code-behind. Side by side, a divider sets how much each gets, and either side folds into a
        ribbon at the window's edge.
    -->
    <Grid x:Name="Layout">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition x:Name="PageColumn" Width="*" />
            <ColumnDefinition x:Name="DividerColumn" Width="0" />
            <ColumnDefinition x:Name="OfficeColumn" Width="0" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <!-- The cards and earlier work, folded away: a click brings them back. -->
        <Border x:Name="PageRibbon" Grid.Column="0" Width="34" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Cursor="Hand" Visibility="Collapsed"
                ToolTip="Show the cards and earlier work again" AutomationProperties.Name="Show the cards and earlier work">
            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{Binding UnfoldCommand}" />
            </Border.InputBindings>
            <StackPanel Margin="0,22,0,0" HorizontalAlignment="Center">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="12" HorizontalAlignment="Center" />
                <TextBlock Text="Agents and earlier work" Margin="0,10,0,0" HorizontalAlignment="Center">
                    <TextBlock.LayoutTransform>
                        <RotateTransform Angle="90" />
                    </TextBlock.LayoutTransform>
                </TextBlock>
            </StackPanel>
        </Border>
        <GridSplitter x:Name="Divider" Grid.Column="2" Width="10" HorizontalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                      Focusable="False" Visibility="Collapsed" DragCompleted="Divider_DragCompleted" MouseDoubleClick="Divider_MouseDoubleClick"
                      ToolTip="Drag to give the office more or less room; double-click for the usual split">
            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Border Background="Transparent">
                        <Border x:Name="Line" Width="2" Margin="0,24" CornerRadius="1" HorizontalAlignment="Center" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Line" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            <Setter TargetName="Line" Property="Width" Value="3" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>
        <Border x:Name="OfficeSide" Grid.Column="3" Margin="0,20,28,20">
            <Grid x:Name="OfficePane">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="OfficeRow" Height="*" />
                    <RowDefinition x:Name="BottomRow" Height="Auto" />
                </Grid.RowDefinitions>
                <!-- Side by side: give the office the whole view, or fold it away. -->
                <DockPanel x:Name="OfficeHeader" Margin="2,0,0,6">
                    <StackPanel x:Name="FoldButtons" DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="WidenButton" Style="{StaticResource SubtleButton}" Command="{Binding FoldPageCommand}" Padding="7,4"
                                ToolTip="Give the office the whole view (the cards fold into a ribbon on the left)" AutomationProperties.Name="Office takes the whole view">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE740;" FontSize="12" />
                        </Button>
                        <Button x:Name="FoldButton" Style="{StaticResource SubtleButton}" Command="{Binding FoldOfficeCommand}" Padding="7,4" Margin="2,0,0,0"
                                ToolTip="Fold the office away into a ribbon on the right" AutomationProperties.Name="Fold the office away">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="12" />
                        </Button>
                    </StackPanel>
                    <!-- The project's channel under the office. -->
                    <ToggleButton x:Name="ChannelToggle" DockPanel.Dock="Right" Style="{StaticResource SubtleToggle}" IsChecked="{Binding ShowChannel}" Padding="7,4" Margin="0,0,4,0"
                                  ToolTip="{Binding ShowChannelToolTip}" AutomationProperties.Name="Channel under the office"
                                  Visibility="{Binding ShowOffice, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8BD;" FontSize="12" Margin="0,1,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Channel" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding OfficeTitle}" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Visibility="{Binding ShowRoomTabs, Converter={StaticResource InvBoolToVis}}" />
                        <!-- The project's rooms (its office and studios), when it has more than one open: the one shown can be closed. -->
                        <ItemsControl x:Name="RoomTabs" ItemsSource="{Binding RoomTabs}" Focusable="False" VerticalAlignment="Center"
                                      Visibility="{Binding ShowRoomTabs, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:RoomTab}">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,4,0">
                                        <ToggleButton Style="{StaticResource SubtleToggle}" IsChecked="{Binding IsSelected, Mode=OneWay}" Command="{Binding Select}"
                                                      Content="{Binding Name}" Padding="9,3" ToolTip="{Binding ToolTip}" AutomationProperties.Name="{Binding Name}" />
                                        <!-- The room shown closes from its own tab. -->
                                        <Button x:Name="CloseRoom" Style="{StaticResource SubtleButton}" Command="{Binding Close}" Padding="5,4" Margin="1,0,0,0"
                                                ToolTip="{Binding CloseToolTip}" AutomationProperties.Name="{Binding CloseToolTip}"
                                                Visibility="{Binding CanClose, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="10" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- Rooms the project could open: a studio of each kind (set up, or again with its roles and hires), and its office. -->
                        <StackPanel x:Name="SetUpStudio" Orientation="Horizontal" Margin="12,0,0,0" Visibility="{Binding HasRoomsToOpen, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding OpenRoomsLabel}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <ItemsControl x:Name="RoomsToOpen" ItemsSource="{Binding RoomsToOpen}" Focusable="False" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:RoomChoice}">
                                        <Button Style="{StaticResource SubtleButton}" Content="{Binding Name}" Command="{Binding Open}" CommandParameter="{Binding Room}"
                                                Padding="8,3" ToolTip="{Binding ToolTip}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
                <Border x:Name="OfficeCard" Grid.Row="1" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,10" Visibility="{Binding ShowOffice, Converter={StaticResource BoolToVis}}">
                    <local:OfficeView x:Name="Office" DataContext="{Binding Office}" />
                </Border>
                <Grid x:Name="OfficeBottom" Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ChannelColumn" Width="*" />
                        <ColumnDefinition x:Name="AgentListColumn" Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                <Border x:Name="ChannelCard" Style="{StaticResource Card}" Padding="12,10" Visibility="Collapsed">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Command="{Binding OpenChannelInChatCommand}" Padding="7,3"
                                    ToolTip="Open it in Chat" AutomationProperties.Name="Open it in Chat"
                                    Visibility="{Binding HasOfficeChannel, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="12" />
                            </Button>
                            <TextBlock Text="{Binding ChannelTitle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ChannelTopic}" Style="{StaticResource MutedText}" FontSize="12" Margin="8,1,0,0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding ChannelTopic}" />
                        </DockPanel>
                        <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0" Visibility="{Binding HasOfficeChannel, Converter={StaticResource BoolToVis}}">
                            <Button DockPanel.Dock="Right" Content="Send" Command="{Binding SendToChannelCommand}" Style="{StaticResource AccentButtonStyle}" Margin="6,0,0,0" />
                            <TextBox x:Name="ChannelDraft" Text="{Binding ChannelDraft, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Write in the channel"
                                     ToolTip="Enter sends it to the channel, as in Chat (@name mentions someone)">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SendToChannelCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                        </DockPanel>
                        <Grid>
                            <TextBlock Text="{Binding ChannelHint}" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap"
                                       Visibility="{Binding HasOfficeChannel, Converter={StaticResource InvBoolToVis}}" />
                            <TextBlock Text="Nothing said here yet." Style="{StaticResource MutedText}" FontSize="12"
                                       Visibility="{Binding HasChannelLines, Converter={StaticResource InvBoolToVis}}" />
                            <ScrollViewer x:Name="ChannelScroll" Height="260" VerticalScrollBarVisibility="Auto"
                                          Visibility="{Binding HasChannelLines, Converter={StaticResource BoolToVis}}">
                                <ItemsControl x:Name="ChannelLines" ItemsSource="{Binding ChannelLines}" Focusable="False" Margin="0,0,6,0" VerticalAlignment="Bottom">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:PrivateLine}">
                                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                                <Run Text="{Binding Who, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Time, Mode=OneWay}" FontSize="11"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}" /><LineBreak /><Run Text="{Binding Text, Mode=OneWay}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </Border>
                <Border x:Name="AgentListCard" Grid.Column="0" Grid.ColumnSpan="2">
                    <Expander x:Name="AgentListExpander" IsExpanded="{Binding IsAgentListOpen}" HorizontalAlignment="Stretch">
                        <Expander.Header>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding AgentListCount}" Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center" Margin="12,0,14,0" />
                                <TextBlock Text="All agents" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>
                        </Expander.Header>
                        <StackPanel>
                            <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="AgentList" ItemsSource="{Binding AllAgents}" ItemTemplate="{StaticResource AgentRow}" Focusable="False" />
                            </ScrollViewer>
                            <TextBlock Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="6,6,6,0"
                                       Text="Right-click an agent to write to it privately, invite it to a channel, rename it or see its work." />
                        </StackPanel>
                    </Expander>
                </Border>
                </Grid>
            </Grid>
        </Border>
        <!-- The office folded away: a click brings it back. -->
        <Border x:Name="OfficeRibbon" Grid.Column="4" Width="34" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Cursor="Hand" Visibility="Collapsed"
                ToolTip="Show the office and all agents again" AutomationProperties.Name="Show the office">
            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{Binding UnfoldCommand}" />
            </Border.InputBindings>
            <StackPanel Margin="0,22,0,0" HorizontalAlignment="Center">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE76B;" FontSize="12" HorizontalAlignment="Center" />
                <TextBlock Text="Office and all agents" Margin="0,10,0,0" HorizontalAlignment="Center">
                    <TextBlock.LayoutTransform>
                        <RotateTransform Angle="90" />
                    </TextBlock.LayoutTransform>
                </TextBlock>
            </StackPanel>
        </Border>
    <ScrollViewer x:Name="PageScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto">
        <!-- As wide as the window allows, up to 980: the stats and their charts get the room. -->
        <Grid Margin="28,20,28,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="980" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
        <StackPanel>
            <DockPanel>
                <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding ProjectChoices}" SelectedItem="{Binding ProjectFilter}" Width="200" VerticalAlignment="Center"
                          AutomationProperties.Name="Project" ToolTip="Only agents working in this project" />
                <ToggleButton x:Name="SettingsToggle" DockPanel.Dock="Right" Style="{StaticResource SubtleToggle}" IsChecked="{Binding IsSettingsOpen}" Margin="0,0,8,0"
                              AutomationProperties.Name="Settings" ToolTip="Which agents show, and how far back their earlier work goes">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" FontSize="13" Margin="0,1,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Settings" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="OfficeToggle" DockPanel.Dock="Right" Style="{StaticResource SubtleToggle}" IsChecked="{Binding ShowOffice}" Margin="0,0,8,0"
                              AutomationProperties.Name="Office" ToolTip="The office: your agents at their desks, at the water cooler while they chat, or asleep when idle">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE821;" FontSize="13" Margin="0,1,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Office" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <StackPanel>
                    <TextBlock Text="Agents" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- The big button: everyone finishes what they're doing and sleeps, until woken. -->
            <Border x:Name="SleepStrip" Style="{StaticResource Card}" Padding="18,12" Margin="0,16,0,0"
                    Visibility="{Binding IsAsleep, Converter={StaticResource InvBoolToVis}}">
                <DockPanel>
                    <Button x:Name="SleepButton" DockPanel.Dock="Right" Style="{StaticResource AccentButtonStyle}" Command="{Binding PutEveryoneToSleepCommand}" Padding="18,8"
                            Margin="16,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="Put everyone to sleep">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE708;" FontSize="17" VerticalAlignment="Center" />
                            <TextBlock Text="Put everyone to sleep" FontSize="15" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Need everything to halt? Every agent, in the office and the studios, finishes what it's doing and goes to sleep until you wake them."
                               Style="{StaticResource MutedText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Everyone's asleep: what that means, and waking them up. -->
            <Border x:Name="SleepBanner" Style="{StaticResource Card}" Padding="18,14" Margin="0,16,0,0" BorderThickness="1"
                    BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" Visibility="{Binding IsAsleep, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource AccentButtonStyle}" Command="{Binding WakeEveryoneUpCommand}" Padding="16,7" Margin="16,0,0,0"
                            VerticalAlignment="Center" AutomationProperties.Name="Wake everyone up">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE706;" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="Wake everyone up" FontSize="15" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE708;" FontSize="22" Margin="0,0,14,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="{Binding SleepText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- What the view shows; folds open under the header. -->
            <Border x:Name="SettingsPanel" Style="{StaticResource Card}" Padding="18,14" Margin="0,16,0,0"
                    Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Show agents" FontWeight="SemiBold" Margin="0,6,0,0" />
                    <StackPanel Grid.Column="1">
                        <RadioButton x:Name="ShowWorkingNow" GroupName="AgentsShown" IsChecked="{Binding ShowWorkingNow}" Content="Working now (did something in the past 15 minutes)" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <RadioButton x:Name="ShowActiveWithin" GroupName="AgentsShown" IsChecked="{Binding ShowActiveWithin}" Content="Active in the past" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox x:Name="ActiveWithinBox" Text="{Binding ActiveWithinText, UpdateSourceTrigger=PropertyChanged}" Width="64" Margin="0,0,8,0" VerticalAlignment="Center"
                                     AutomationProperties.Name="How many" />
                            <ComboBox x:Name="UnitBox" ItemsSource="{Binding Units}" SelectedItem="{Binding SelectedUnit}" DisplayMemberPath="Label" Width="120" VerticalAlignment="Center"
                                      AutomationProperties.Name="Minutes, hours or days" />
                        </StackPanel>
                        <RadioButton x:Name="ShowAllConnected" GroupName="AgentsShown" IsChecked="{Binding ShowAllConnected}" Content="All connected agents" Margin="0,4,0,0" />
                        <TextBlock Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="An agent stays connected until its session is closed. One with an item checked out always shows, so you can see who has it." />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="Earlier work" FontWeight="SemiBold" Margin="0,22,0,0" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,16,0,0">
                        <ComboBox x:Name="EarlierBox" ItemsSource="{x:Static vm:AgentActivityViewModel.EarlierChoices}" SelectedItem="{Binding SelectedEarlier}" DisplayMemberPath="Label"
                                  Width="160" HorizontalAlignment="Left" AutomationProperties.Name="Earlier work" />
                        <TextBlock Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="Grouped by week or month, the oldest week or month is shown whole, so its stats are complete." />
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="Office look" FontWeight="SemiBold" Margin="0,22,0,0" />
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,16,0,0">
                        <RadioButton x:Name="ClassicLook" GroupName="OfficeLook" IsChecked="{Binding IsClassicLook}" Content="Classic: the office as ProJict draws it" />
                        <RadioButton x:Name="DrawnLook" GroupName="OfficeLook" IsChecked="{Binding IsDrawnLook}" Margin="0,4,0,0"
                                     Content="Drawn: pictures of the rooms, light and dark (new)" />
                        <TextBlock Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="For the office and the game and film studios. The robots get a matching look; what they do stays the same." />
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="OfficeTop" Margin="0,16,0,0" Visibility="Collapsed" />

            <TextBlock Text="{Binding LiveTitle}" Style="{StaticResource SectionTitle}" Margin="0,20,0,8" />
            <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,10" Visibility="{Binding HasLive, Converter={StaticResource InvBoolToVis}}">
                <TextBlock Text="{Binding EmptyText}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
            </Border>
            <ItemsControl x:Name="LiveCards" ItemsSource="{Binding Live}" ItemTemplate="{StaticResource AgentCard}" Focusable="False" />
            <StackPanel x:Name="IdleLine" Orientation="Horizontal" Margin="2,0,0,8" Visibility="{Binding HasIdleLine, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding IdleText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                <Button Style="{StaticResource SubtleButton}" Content="{Binding IdleButtonText}" Command="{Binding ToggleIdleCommand}" Margin="6,0,0,0" Padding="7,3"
                        Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            </StackPanel>
            <TextBlock Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="2,0,0,0"
                       Text="Agents can say what they're busy with (set_status); otherwise this shows what they last did here. The dots move while an agent is active." />

            <DockPanel Margin="0,24,0,0" Visibility="{Binding HasHistory, Converter={StaticResource BoolToVis}}">
                <ComboBox DockPanel.Dock="Right" ItemsSource="{x:Static vm:GroupingOption.All}" SelectedItem="{Binding Grouping}" DisplayMemberPath="Label" Width="130"
                          VerticalAlignment="Center" AutomationProperties.Name="Group by" ToolTip="Group earlier agent work by day, week or month; each has its own stats" />
                <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Content="{Binding FoldAllText}" Command="{Binding FoldAllCommand}" Margin="0,0,8,0"
                        ToolTip="Fold or open every period" Visibility="{Binding IsHistoryEmpty, Converter={StaticResource InvBoolToVis}}" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Earlier" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding EarlierScope}" Style="{StaticResource MutedText}" Margin="10,0,0,0" VerticalAlignment="Center"
                               ToolTip="Settings › Earlier work" />
                </StackPanel>
            </DockPanel>
            <TextBlock Text="{Binding HistoryEmptyText}" Style="{StaticResource MutedText}" Margin="2,10,0,0"
                       Visibility="{Binding IsHistoryEmpty, Converter={StaticResource BoolToVis}}" />
            <ItemsControl x:Name="HistoryList" ItemsSource="{Binding HistoryGroups}" ItemTemplate="{StaticResource HistoryGroup}" Focusable="False" />
            <Button Content="Show more" HorizontalAlignment="Left" Margin="0,12,0,0" Command="{Binding ShowMoreHistoryCommand}"
                    Visibility="{Binding HasMoreHistory, Converter={StaticResource BoolToVis}}" />
            <StackPanel x:Name="OlderLine" Orientation="Horizontal" Margin="2,12,0,0" Visibility="{Binding HasOlderLine, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding OlderText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                <Button Style="{StaticResource SubtleButton}" Content="Show it" Command="{Binding ShowOlderCommand}" Margin="6,0,0,0" Padding="7,3"
                        Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            </StackPanel>
        </StackPanel>
        </Grid>
    </ScrollViewer>
    </Grid>
</UserControl>
