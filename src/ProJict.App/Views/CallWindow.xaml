<Window x:Class="ProJict.App.Views.CallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ProJict.App.ViewModels"
        Title="{Binding Title}" Width="820" Height="600" MinWidth="520" MinHeight="420" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
    <DockPanel Margin="20">
        <!-- Who's on the call and how long; why it can't hear you, if so -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" />
            <TextBlock x:Name="Status" Text="{Binding StatusText}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
            <TextBlock Text="{Binding Problem}" Foreground="{DynamicResource SystemFillColorCautionBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Visibility="{Binding Problem, Converter={StaticResource EmptyToVis}}" />
        </StackPanel>

        <!-- A person calling you: Accept or Decline -->
        <StackPanel x:Name="IncomingButtons" DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0"
                    Visibility="{Binding IsIncoming, Converter={StaticResource BoolToVis}}">
            <Button x:Name="AcceptButton" Command="{Binding AcceptCommand}" Padding="16,8" Margin="0,0,10,0" Background="#107C10" Foreground="White" BorderThickness="0"
                    AutomationProperties.Name="Accept">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE717;" FontSize="16" VerticalAlignment="Center" Foreground="White" />
                    <TextBlock Text="Accept" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="White" />
                </StackPanel>
            </Button>
            <Button x:Name="DeclineButton" Command="{Binding DeclineCommand}" Padding="16,8" Background="#D13438" Foreground="White" BorderThickness="0"
                    AutomationProperties.Name="Decline">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE778;" FontSize="16" VerticalAlignment="Center" Foreground="White" />
                    <TextBlock Text="Decline" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="White" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Mute and Hang up -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0"
                    Visibility="{Binding IsOngoing, Converter={StaticResource BoolToVis}}">
            <ToggleButton x:Name="MuteButton" Style="{StaticResource SubtleToggle}" IsChecked="{Binding IsMuted}" Padding="16,8" Margin="0,0,10,0"
                          ToolTip="Mute: what you say isn't heard until you unmute" AutomationProperties.Name="Mute">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE720;" FontSize="16" VerticalAlignment="Center" />
                    <TextBlock Text="Mute" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </ToggleButton>
            <Button x:Name="HangUpButton" Command="{Binding HangUpCommand}" Padding="16,8" Background="#D13438" Foreground="White" BorderThickness="0"
                    ToolTip="Hang up: the call ends for everyone" AutomationProperties.Name="Hang up">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE778;" FontSize="16" VerticalAlignment="Center" Foreground="White" />
                    <TextBlock Text="Hang up" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="White" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- What's been said, the newest last -->
        <Border DockPanel.Dock="Bottom" CornerRadius="8" Padding="12,8" Margin="0,14,0,0" Background="{DynamicResource SubtleFillColorSecondaryBrush}" MinHeight="70">
            <ItemsControl x:Name="CaptionList" ItemsSource="{Binding Captions}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CallCaption}">
                        <TextBlock x:Name="Line" TextWrapping="Wrap" Margin="0,1">
                            <Run Text="{Binding Who, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Text, Mode=OneWay}" />
                        </TextBlock>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsNote}" Value="True">
                                <Setter TargetName="Line" Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- A tile per participant, like a camera view: picture or initials; it glows while that one speaks -->
        <ItemsControl x:Name="TileList" ItemsSource="{Binding Tiles}" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="{Binding Columns}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:CallTile}">
                    <Border x:Name="Tile" Margin="6" CornerRadius="12" BorderThickness="3" BorderBrush="Transparent" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                        <Grid>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Grid Width="96" Height="96">
                                    <Ellipse Fill="{Binding Badge.Background}" />
                                    <TextBlock Text="{Binding Badge.Initials}" Foreground="White" FontSize="34" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Ellipse Visibility="{Binding HasPicture, Converter={StaticResource BoolToVis}}">
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="{Binding Picture}" Stretch="UniformToFill" />
                                        </Ellipse.Fill>
                                    </Ellipse>
                                </Grid>
                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0" />
                                <TextBlock Text="{Binding StateText}" Style="{StaticResource MutedText}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsSpeaking}" Value="True">
                            <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsAway}" Value="True">
                            <Setter TargetName="Tile" Property="Opacity" Value="0.5" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</Window>
