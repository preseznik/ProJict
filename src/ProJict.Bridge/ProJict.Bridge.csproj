<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ProJictBridge</AssemblyName>
    <RootNamespace>ProJict.Bridge</RootNamespace>
    <ApplicationIcon>..\ProJict.App\Assets\ProJict.ico</ApplicationIcon>
    <Product>ProJict</Product>
    <Description>Connects AI agents to the running ProJict, and keeps them connected when it restarts</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- One small native file (build.ps1 publishes it next to ProJict.exe; ProJict keeps a copy outside its install folder) -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
  </PropertyGroup>

</Project>
